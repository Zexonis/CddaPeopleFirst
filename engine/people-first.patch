+           get_map().has_potential_los( me.pos_bub(), other.pos_bub() ) && pf_protects( me, other );
+}
+static bool pf_hears_fight( const npc &me, const monster &critter )
+{
+    if( pf_str_var( me, "pf_uid" ).empty() || pf_global_num( "pf_set_defend", 1.0 ) == 0.0 ) {
