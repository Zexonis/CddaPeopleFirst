+        return true;
+    }
+    for( const npc &guy : g->all_npcs() ) {
+        if( &guy != &me && rl_dist( guy.pos_bub(), critter.pos_bub() ) <= 1 && pf_near_protected( me, guy ) ) {
+            return true;
+        }
+    }
+    return false;
+}
