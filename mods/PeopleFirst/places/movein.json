[
  {
    "type": "effect_on_condition",
    "id": "PF_PLACE_move_in",
    "//": "u = you, npc = someone settled (or from a place).  They answer as they would to living with you (warmth 35 and trust 25, or 50 and 15).  You can't leave a household of your own behind.",
    "effect": [
      {
        "if": { "math": [ "(value_or(pf_home_set, 0) == 1) * (value_or(pf_residents_n, 0) > 0)" ] },
        "then": [ { "u_message": "You have people of your own at home.  You can't just walk out on them.", "type": "info" } ],
        "else": [
          { "math": [ "pf_bd_ok = 0" ] },
          { "run_eocs": "PF_PM_bond_read", "alpha_talker": "npc" },
          {
            "if": { "math": [ "(pf_bd_ok == 1) * (pf_bd_ready == 1) == 0" ] },
            "then": [
              { "u_message": "<npc_name> glances at the others.  \"We'd have to know you better first.\"", "type": "info" },
              {
                "if": { "math": [ "pf_bd_ok == 1" ] },
                "then": [ { "u_message": "<global_val:pf_bd_bar> <global_val:pf_bd_word>  <global_val:pf_bd_hint>", "type": "info" } ]
              }
            ],
            "else": [ { "run_eocs": "PF_PLACE_move_in_yes" } ]
          }
        ]
      }
    ]
  },
  {
