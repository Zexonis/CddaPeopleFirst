        "u_message": "<global_val:pf_mi_lname> shows you a corner that's yours.  \"You pull your weight, and we look after you.\"  You live at <global_val:pf_mi_pname> now, and <global_val:pf_mi_lname> runs the place.",
        "type": "good"
      },
      {
        "if": { "math": [ "pf_mi_old == 1" ] },
        "then": [ { "u_message": "The old place isn't home anymore.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_PLACE_host_read",
    "//": "u = the host band's leader: where home will be, what it's called, and whether it's a place.",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_mi_lname" }, "parse_tags": true },
      { "set_string_var": "<u_name>'s place", "target_var": { "global_val": "pf_mi_pname" }, "parse_tags": true },
      { "math": [ "pf_mi_place = value_or(u_pf_place, 0)" ] },
      {
        "if": { "math": [ "has_var(u_pf_home)" ] },
        "then": [ { "copy_var": { "u_val": "pf_home" }, "target_var": { "global_val": "pf_mi_home" } } ],
        "else": [ { "copy_var": { "u_val": "pf_vpos" }, "target_var": { "global_val": "pf_mi_home" } } ]
      },
      {
        "if": { "math": [ "pf_mi_place > 0" ] },
        "then": [
          { "copy_var": { "u_val": "pf_place_at" }, "target_var": { "global_val": "pf_mi_home" } },
          { "copy_var": { "u_val": "pf_place_name" }, "target_var": { "global_val": "pf_mi_pname" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_MI_gather",
    "//": "Every band of the place you're moving into (up to 6), into pf_mi_l_<j>.",
    "effect": [
      { "math": [ "pf_pl_i = 0" ] },
      {
        "run_eocs": "PF_MI_gather_i",
        "condition": { "math": [ "pf_pl_i < value_or(pf_band_n, 0)" ] },
        "iterations": 1000
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_MI_gather_i",
    "effect": [
      { "set_string_var": "pf_slot_<global_val:pf_pl_i>", "target_var": { "context_val": "ref" }, "parse_tags": true },
      {
        "if": { "not": { "compare_string": [ { "var_val": "ref" }, "none" ] } },
        "then": [ { "u_run_npc_eocs": [ "PF_MI_gather_one" ], "unique_ids": [ { "var_val": "ref" } ], "local": false } ]
      },
      { "math": [ "pf_pl_i += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_MI_gather_one",
    "condition": { "math": [ "value_or(u_pf_is_leader, 0) == 1" ] },
    "effect": [
      {
        "if": {
          "and": [
            { "math": [ "pf_mi_place > 0" ] },
            { "math": [ "value_or(u_pf_place, 0) == pf_mi_place" ] },
            { "math": [ "pf_mi_n < 6" ] },
            { "math": [ "(value_or(u_pf_settled, 0) == 1) + (value_or(u_pf_based, 0) == 1) > 0" ] }
          ]
        },
        "then": [
          { "math": [ "pf_mi_n += 1" ] },
          {
            "if": { "math": [ "pf_mi_n == 1" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_0" } } ]
          },
          {
            "if": { "math": [ "pf_mi_n == 2" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_1" } } ]
          },
          {
            "if": { "math": [ "pf_mi_n == 3" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_2" } } ]
          },
          {
            "if": { "math": [ "pf_mi_n == 4" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_3" } } ]
          },
          {
            "if": { "math": [ "pf_mi_n == 5" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_4" } } ]
          },
          {
            "if": { "math": [ "pf_mi_n == 6" ] },
            "then": [ { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_mi_l_5" } } ]
          }
        ]
      }
    ]
  }
]
