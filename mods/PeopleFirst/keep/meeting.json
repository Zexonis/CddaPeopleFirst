[
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_tick",
    "//": "Every 10 minutes at home: on meeting day (one evening a week, or the next evening after the chief is lost, or the very first time the place has 4+ grown-ups living here), between 19:00 and 22:00 when you're home and it's calm, the meeting is called; 20 minutes later it sits.",
    "recurrence": "10 minutes",
    "global": true,
    "condition": { "math": [ "value_or(pf_home_set, 0) == 1" ] },
    "effect": [
      {
        "if": { "math": [ "value_or(pf_mt_stday, -1) != floor(time('now') / time('1 d'))" ] },
        "then": [ { "math": [ "pf_mt_state = 0" ] } ]
      },
      {
        "if": {
          "and": [
            { "math": [ "time_since('midnight', 'unit': 'hours') >= 19" ] },
            { "math": [ "time_since('midnight', 'unit': 'hours') < 22" ] },
            { "math": [ "value_or(pf_mt_day, -1) != floor(time('now') / time('1 d'))" ] },
            {
              "math": [ "(floor(time('now') / time('1 d')) % 7 == 2) + value_or(pf_mt_due, 0) + (value_or(pf_meetings_total, 0) == 0) > 0" ]
            }
          ]
        },
        "then": [
          { "u_location_variable": { "global_val": "pf_kp_av" } },
          {
            "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
            "then": [
              {
                "if": { "math": [ "value_or(pf_mt_state, 0) == 0" ] },
                "then": [
                  { "run_eocs": "PF_KEEP_count" },
                  {
                    "if": { "math": [ "pf_kp_n >= 4" ] },
                    "then": [
                      { "math": [ "pf_mt_small_said = 0" ] },
                      { "run_eocs": "PF_THREAT_scan" },
                      { "if": { "math": [ "pf_threat == 0" ] }, "then": [ { "run_eocs": "PF_KEEP_call" } ] }
                    ],
                    "else": [
                      {
                        "if": { "math": [ "(value_or(pf_meetings_total, 0) > 0) * (value_or(pf_mt_small_said, 0) == 0)" ] },
                        "then": [
                          { "math": [ "pf_mt_small_said = 1" ] },
                          { "math": [ "pf_mt_day = floor(time('now') / time('1 d'))" ] },
                          { "math": [ "pf_mt_due = 0" ] },
                          {
                            "run_eocs": "PF_SAY_keep",
                            "alpha_talker": "avatar",
                            "variables": { "line": "meet_too_few" }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "else": [ { "if": { "math": [ "time('now') - pf_mt_t >= time('20 m')" ] }, "then": [ { "run_eocs": "PF_KEEP_agenda" } ] } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_count",
    "//": "u = avatar.  pf_kp_n = grown-ups who live here, in the bubble.",
    "effect": [
      { "math": [ "pf_kp_n = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_count_one",
            "condition": {
              "and": [
                { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                { "math": [ "has_var(u_pf_uid)" ] }
              ]
            },
            "effect": [ { "math": [ "pf_kp_n += 1" ] } ]
          }
        ],
        "local": true,
        "npc_range": 60
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_call",
    "//": "u = avatar.  Somebody bangs a pot: everyone who lives here walks over.",
    "effect": [
      { "math": [ "pf_mt_state = 1" ] },
      { "math": [ "pf_mt_t = time('now')" ] },
      { "math": [ "pf_mt_stday = floor(time('now') / time('1 d'))" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_gather",
            "condition": {
              "and": [
                {
                  "and": [
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "math": [ "has_var(u_pf_uid)" ] }
                  ]
                },
                { "not": { "u_has_effect": "sleep" } }
              ]
            },
            "effect": [
              { "copy_var": { "global_val": "pf_home_loc" }, "target_var": { "u_val": "pf_walk_to" } },
              {
                "location_variable_adjust": { "u_val": "pf_walk_to" },
                "x_adjust": { "math": [ "rand(6) - 3" ] },
                "y_adjust": { "math": [ "rand(6) - 3" ] }
              },
              { "u_set_guard_pos": { "u_val": "pf_walk_to" } }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_meetings_total, 0) == 0" ] },
            "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "call_first" } } ],
            "else": [
              { "math": [ "_p = rand(2)" ] },
              {
                "if": { "math": [ "_p == value_or(pf_kl_call, -1)" ] },
                "then": [ { "math": [ "_p = (_p + 1) % 3" ] } ]
              },
              { "math": [ "pf_kl_call = _p" ] },
              {
                "if": { "math": [ "_p == 0" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "call_0" } } ]
              },
              {
                "if": { "math": [ "_p == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "call_1" } } ]
              },
              {
                "if": { "math": [ "_p == 2" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "call_2" } } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_agenda",
    "//": "u = avatar.  The meeting sits.  First: is there a chief, and are they here (away from two meetings running, the chair is empty)?  If there's no chief, or more than half have turned on them, a vote.  Otherwise: the week's tithe (and anyone who kept their share back), the worst quarrel in the place for the chief to settle, and a law put to the vote (yours, or someone's who has a reason).  If none of that comes up, it's a quiet one.",
    "effect": [
      { "math": [ "pf_mt_state = 0" ] },
      { "math": [ "pf_mt_day = floor(time('now') / time('1 d'))" ] },
      { "math": [ "pf_mt_due = 0" ] },
      { "math": [ "pf_meetings_total = value_or(pf_meetings_total, 0) + 1" ] },
      {
        "if": { "math": [ "value_or(pf_town_named, 0) == 1" ] },
        "then": [ { "copy_var": { "global_val": "pf_town_name" }, "target_var": { "global_val": "pf_kp_place" } } ],
        "else": [ { "set_string_var": "the place", "target_var": { "global_val": "pf_kp_place" } } ]
      },
      { "u_location_variable": { "global_val": "pf_kp_av" } },
      { "math": [ "pf_kp_elect = value_or(pf_chief_set, 0) == 0" ] },
      { "math": [ "pf_kp_judge = 0" ] },
      {
        "if": { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
        "then": [
          { "copy_var": { "global_val": "pf_chief_uid" }, "target_var": { "global_val": "pf_find_uid" } },
          { "run_eocs": "PF_FIND_by_uid" },
          {
            "if": { "math": [ "pf_find_ok == 1" ] },
            "then": [
              { "math": [ "pf_chief_away = 0" ] },
              { "math": [ "pf_kp_judge = 1" ] },
              { "copy_var": { "global_val": "pf_find_who" }, "target_var": { "global_val": "pf_kp_chief_t" } }
            ],
            "else": [
              { "math": [ "pf_chief_away = value_or(pf_chief_away, 0) + 1" ] },
              {
                "if": { "math": [ "pf_chief_away >= 2" ] },
                "then": [
                  { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "chief_gone" } },
                  {
                    "if": { "math": [ "value_or(pf_law_lord, 0) == 1" ] },
                    "then": [ { "run_eocs": "PF_KEEP_succession" } ],
                    "else": [ { "math": [ "pf_chief_set = 0" ] }, { "math": [ "pf_kp_elect = 1" ] } ]
                  }
                ],
                "else": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "chief_absent" } } ]
              }
            ]
          }
        ]
      },
      { "if": { "math": [ "value_or(pf_chief_set, 0) == 2" ] }, "then": [ { "math": [ "pf_kp_judge = 2" ] } ] },
      { "math": [ "pf_kp_council = 0" ] },
      {
        "if": { "math": [ "(value_or(pf_law_council, 0) == 1) * (pf_kp_elect == 0)" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_cn_n, 0) < 2" ] },
            "then": [ { "math": [ "pf_kp_elect = 1" ] } ],
            "else": [
              {
                "if": { "math": [ "time('now') - value_or(pf_cn_since, 0) >= time('28 d')" ] },
                "then": [
                  { "math": [ "pf_kp_elect = 1" ] },
                  { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "council_term" } }
                ],
                "else": [
                  { "run_eocs": "PF_KEEP_cn_present" },
                  { "if": { "math": [ "pf_cnv_here > 0" ] }, "then": [ { "math": [ "pf_kp_council = 1" ] } ] }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "value_or(pf_meetings_total, 0) == 1" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "first" } } ],
        "else": [
          {
            "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
            "then": [
              { "math": [ "_p = rand(2)" ] },
              {
                "if": { "math": [ "_p == value_or(pf_kl_open, -1)" ] },
                "then": [ { "math": [ "_p = (_p + 1) % 3" ] } ]
              },
              { "math": [ "pf_kl_open = _p" ] },
              {
                "if": { "math": [ "_p == 0" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "open_0" } } ]
              },
              {
                "if": { "math": [ "_p == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "open_1" } } ]
              },
              {
                "if": { "math": [ "_p == 2" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "open_2" } } ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "(pf_kp_elect == 0) * (value_or(pf_chief_set, 0) > 0)" ] },
        "then": [
          { "run_eocs": "PF_KEEP_dissent" },
          {
            "if": { "math": [ "value_or(pf_law_lord, 0) == 1" ] },
            "then": [
              {
                "if": { "math": [ "(pf_kd_n >= 2) * (pf_kd_dis * 3 > pf_kd_n * 2)" ] },
                "then": [
                  { "math": [ "pf_kp_old_set = value_or(pf_chief_set, 0)" ] },
                  { "copy_var": { "global_val": "pf_chief_name" }, "target_var": { "global_val": "pf_kp_old_name" } },
                  { "copy_var": { "global_val": "pf_chief_uid" }, "target_var": { "global_val": "pf_kp_old_uid" } },
                  { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "coup" } },
                  { "math": [ "pf_law_lord = 0" ] },
                  { "math": [ "pf_kp_elect = 1" ] },
                  { "math": [ "pf_kp_conf = 1" ] },
                  { "math": [ "pf_coups_total = value_or(pf_coups_total, 0) + 1" ] }
                ]
              }
            ],
            "else": [
              {
                "if": { "math": [ "(pf_kd_n >= 2) * (pf_kd_dis * 2 > pf_kd_n)" ] },
                "then": [
                  { "math": [ "pf_kp_old_set = value_or(pf_chief_set, 0)" ] },
                  { "copy_var": { "global_val": "pf_chief_name" }, "target_var": { "global_val": "pf_kp_old_name" } },
                  { "copy_var": { "global_val": "pf_chief_uid" }, "target_var": { "global_val": "pf_kp_old_uid" } },
                  { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "confidence" } },
                  { "math": [ "pf_kp_elect = 1" ] },
                  { "math": [ "pf_kp_conf = 1" ] },
                  { "math": [ "pf_confidence_total = value_or(pf_confidence_total, 0) + 1" ] }
                ]
              }
            ]
          }
        ]
      },
      { "math": [ "pf_kp_events = 0" ] },
      {
        "if": { "math": [ "pf_kp_elect == 1" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_law_council, 0) == 1" ] },
            "then": [ { "run_eocs": "PF_KEEP_council_election" } ],
            "else": [ { "run_eocs": "PF_KEEP_election" } ]
          },
          { "if": { "math": [ "pf_kp_conf == 1" ] }, "then": [ { "run_eocs": "PF_KEEP_deposed" } ] }
        ],
        "else": [
          { "run_eocs": "PF_KEEP_tithe_step" },
          {
            "if": { "math": [ "pf_kp_judge + pf_kp_council > 0" ] },
            "then": [
              { "run_eocs": "PF_KEEP_dispute_scan" },
              {
                "if": { "math": [ "pf_kd_found == 1" ] },
                "then": [ { "math": [ "pf_kp_events += 1" ] }, { "run_eocs": "PF_KEEP_dispute" } ]
              }
            ]
          },
          { "run_eocs": "PF_KEEP_exile_step" },
          {
            "if": { "math": [ "(pf_kp_judge == 1) * value_or(pf_law_lord, 0)" ] },
            "then": [ { "run_eocs": "PF_KEEP_heir_step" } ]
          },
          { "run_eocs": "PF_KEEP_law_step" },
          {
            "if": { "math": [ "(pf_kp_events == 0) * (value_or(pf_set_chatter, 1) == 1)" ] },
            "then": [
              { "math": [ "_p = rand(3)" ] },
              {
                "if": { "math": [ "_p == value_or(pf_kl_quiet, -1)" ] },
                "then": [ { "math": [ "_p = (_p + 1) % 4" ] } ]
              },
              { "math": [ "pf_kl_quiet = _p" ] },
              {
                "if": { "math": [ "_p == 0" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "quiet_0" } } ]
              },
              {
                "if": { "math": [ "_p == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "quiet_1" } } ]
              },
              {
                "if": { "math": [ "_p == 2" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "quiet_2" } } ]
              },
              {
                "if": { "math": [ "_p == 3" ] },
                "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "quiet_3" } } ]
              }
            ]
          }
        ]
      },
      { "math": [ "pf_kp_conf = 0" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_deposed",
    "//": "u = avatar.  After a vote of confidence or a coup: how the one who lost the chair takes it (an NPC who lost it holds it against whoever won).",
    "effect": [
      {
        "if": { "math": [ "pf_kp_old_set == 2" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_chief_set, 0) == 2" ] },
            "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "deposed_kept_you" } } ],
            "else": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "deposed_you" } } ]
          }
        ],
        "else": [
          {
            "if": {
              "and": [
                { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
                { "compare_string": [ { "global_val": "pf_chief_uid" }, { "global_val": "pf_kp_old_uid" } ] }
              ]
            },
            "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "deposed_kept" } } ],
            "else": [
              { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "deposed" } },
              {
                "if": { "math": [ "value_or(pf_chief_set, 0) == 2" ] },
                "then": [ { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } } ],
                "else": [ { "copy_var": { "global_val": "pf_chief_uid" }, "target_var": { "global_val": "pf_m_other" } } ]
              },
              {
                "u_run_npc_eocs": [
                  {
                    "id": "PF_KEEP_deposed_sting",
                    "condition": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_kp_old_uid" } ] },
                    "effect": [ { "math": [ "pf_mv_role = 1" ] }, { "math": [ "pf_m_str_in = 40" ] }, { "run_eocs": "PF_MV_ruled_against" } ]
                  }
                ],
                "local": true,
                "npc_range": 60
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_dissent",
    "//": "u = avatar.  Everyone who lives here judges the chief from their own view: trust under 5 with tension 40+, or warmth below -10, is dissent.",
    "effect": [
      { "math": [ "pf_kd_dis = 0" ] },
      { "math": [ "pf_kd_n = 0" ] },
      {
        "if": { "math": [ "pf_chief_set == 2" ] },
        "then": [ { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } } ],
        "else": [ { "copy_var": { "global_val": "pf_chief_uid" }, "target_var": { "global_val": "pf_m_other" } } ]
      },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_dissent_one",
            "condition": {
              "and": [
                {
                  "and": [
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "math": [ "has_var(u_pf_uid)" ] }
                  ]
                },
                {
                  "not": {
                    "and": [
                      { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
                      { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_chief_uid" } ] }
                    ]
                  }
                }
              ]
            },
            "effect": [
              { "run_eocs": "PF_VIEW_read" },
              { "math": [ "pf_kd_n += 1" ] },
              {
                "if": { "math": [ "(pf_read_t < 5) * (pf_read_x >= 40) + (pf_read_w < -10) > 0" ] },
                "then": [ { "math": [ "pf_kd_dis += 1" ] } ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      }
    ]
  }
]
