[
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_tick",
    "//": "Once a day around noon, when you're home: once the place has 4+ grown-ups and it's been 3 weeks since the last siege (or since the first time it was checked), one day in five a horde turns toward it.  Word comes a day ahead.",
    "recurrence": "1 hours",
    "global": true,
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "value_or(pf_alife_on, 1) == 1" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 12" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 13" ] },
        { "math": [ "value_or(pf_sg_check, -1) != floor(time('now') / time('1 d'))" ] },
        { "math": [ "value_or(pf_sg_state, 0) == 0" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_sg_check = floor(time('now') / time('1 d'))" ] },
      {
        "if": { "math": [ "has_var(pf_sg_first_day) == 0" ] },
        "then": [ { "math": [ "pf_sg_first_day = floor(time('now') / time('1 d'))" ] } ]
      },
      {
        "if": { "math": [ "floor(time('now') / time('1 d')) - value_or(pf_sg_last_day, pf_sg_first_day) >= 21" ] },
        "then": [
          { "u_location_variable": { "global_val": "pf_kp_av" } },
          {
            "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
            "then": [
              { "run_eocs": "PF_KEEP_count" },
              { "if": { "math": [ "(pf_kp_n >= 4) * (rand(4) == 0)" ] }, "then": [ { "run_eocs": "PF_SIEGE_warn" } ] }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_warn",
    "//": "u = avatar.  A horde is coming from one direction, tomorrow night.",
    "effect": [
      { "math": [ "pf_sg_state = 1" ] },
      { "math": [ "pf_sg_day = floor(time('now') / time('1 d')) + 1" ] },
      { "math": [ "pf_sg_dir = rand(3)" ] },
      { "math": [ "pf_sg_wave = 0" ] },
      { "math": [ "pf_sg_delays = 0" ] },
      {
        "if": { "math": [ "pf_sg_dir == 0" ] },
        "then": [
          { "set_string_var": "north", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 0" ] },
          { "math": [ "pf_sg_dy = -1" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 1" ] },
        "then": [
          { "set_string_var": "east", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 1" ] },
          { "math": [ "pf_sg_dy = 0" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 2" ] },
        "then": [
          { "set_string_var": "south", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 0" ] },
          { "math": [ "pf_sg_dy = 1" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 3" ] },
        "then": [
          { "set_string_var": "west", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = -1" ] },
          { "math": [ "pf_sg_dy = 0" ] }
        ]
      },
      { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_warn" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_night",
    "//": "Every 10 minutes on the night of the siege (from 21:00): if you're away, the horde is delayed (three times, then it passes by).  If you're home: three waves 40 minutes apart from the warned direction, the place's noise drawing them in (the watch, the Horn and the defense patches do the fighting).  Once it's calm again (2 hours in at least, 4 at most), the tally.",
    "recurrence": "10 minutes",
    "global": true,
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "value_or(pf_sg_state, 0) == 1" ] },
        { "math": [ "floor(time('now') / time('1 d')) >= value_or(pf_sg_day, 999999)" ] },
        {
          "or": [
            { "math": [ "time_since('midnight', 'unit': 'hours') >= 21" ] },
            { "math": [ "time_since('midnight', 'unit': 'hours') < 5" ] },
            { "math": [ "pf_sg_wave > 0" ] }
          ]
        }
      ]
    },
    "effect": [
      { "u_location_variable": { "global_val": "pf_kp_av" } },
      {
        "if": { "math": [ "distance(pf_kp_av, pf_home_loc) > 40" ] },
        "then": [
          {
            "if": { "math": [ "pf_sg_wave == 0" ] },
            "then": [
              { "math": [ "pf_sg_delays += 1" ] },
              {
                "if": { "math": [ "pf_sg_delays >= 3" ] },
                "then": [
                  { "math": [ "pf_sg_state = 0" ] },
                  { "math": [ "pf_sg_last_day = floor(time('now') / time('1 d'))" ] },
                  { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_passes" } }
                ],
                "else": [ { "math": [ "pf_sg_day = floor(time('now') / time('1 d')) + 1" ] } ]
              }
            ]
          }
        ],
        "else": [
          {
            "if": { "math": [ "pf_sg_wave == 0" ] },
            "then": [
              { "math": [ "pf_sg_t0 = time('now')" ] },
              { "math": [ "pf_sg_deaths0 = value_or(pf_ours_dead_total, 0)" ] },
              { "math": [ "pf_sg_guest_dead = 0" ] },
              { "math": [ "pf_sg_n = clamp(4 + value_or(pf_residents_n, 0) / 2, 4, 12)" ] }
            ]
          },
          {
            "if": { "math": [ "(pf_sg_wave < 3) * (time('now') - pf_sg_t0 >= time('40 m') * pf_sg_wave)" ] },
            "then": [ { "run_eocs": "PF_SIEGE_wave" } ]
          },
          {
            "if": { "math": [ "pf_sg_wave >= 1" ] },
            "then": [
              {
                "u_make_sound": "the place, carrying on the night air",
                "volume": 50,
                "type": "activity",
                "target_var": { "global_val": "pf_home_loc" }
              }
            ]
          },
          {
            "if": { "math": [ "(pf_sg_wave >= 3) * (time('now') - pf_sg_t0 >= time('2 h'))" ] },
            "then": [
              { "run_eocs": "PF_THREAT_scan" },
              {
                "if": {
                  "or": [
                    { "math": [ "(pf_threat == 0) * (value_or(pf_horn_active, 0) == 0)" ] },
                    { "math": [ "time('now') - pf_sg_t0 >= time('4 h')" ] }
                  ]
                },
                "then": [ { "run_eocs": "PF_SIEGE_end" } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_wave",
    "//": "u = avatar.  A wave, 35 tiles out in the warned direction: the dead (wave 1), with runners and dogs (wave 2), with the tough ones and a brute (wave 3).  Size grows with the place.",
    "effect": [
      { "math": [ "pf_sg_wave += 1" ] },
      { "math": [ "pf_sg_waves_total = value_or(pf_sg_waves_total, 0) + 1" ] },
      {
        "if": { "math": [ "value_or(pf_st_allied, 0) == 1" ] },
        "then": [
          { "math": [ "pf_sg_n = max(pf_sg_n - 2, 3)" ] },
          { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_allies" } }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 0" ] },
        "then": [
          { "set_string_var": "north", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 0" ] },
          { "math": [ "pf_sg_dy = -1" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 1" ] },
        "then": [
          { "set_string_var": "east", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 1" ] },
          { "math": [ "pf_sg_dy = 0" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 2" ] },
        "then": [
          { "set_string_var": "south", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = 0" ] },
          { "math": [ "pf_sg_dy = 1" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sg_dir == 3" ] },
        "then": [
          { "set_string_var": "west", "target_var": { "global_val": "pf_sg_dirname" } },
          { "math": [ "pf_sg_dx = -1" ] },
          { "math": [ "pf_sg_dy = 0" ] }
        ]
      },
      { "copy_var": { "global_val": "pf_home_loc" }, "target_var": { "global_val": "pf_sg_at" } },
      {
        "location_variable_adjust": { "global_val": "pf_sg_at" },
        "x_adjust": { "math": [ "pf_sg_dx * 35 + rand(10) - 5" ] },
        "y_adjust": { "math": [ "pf_sg_dy * 35 + rand(10) - 5" ] }
      },
      {
        "if": { "math": [ "pf_sg_wave == 1" ] },
        "then": [
          {
            "u_spawn_monster": "mon_zombie",
            "real_count": { "math": [ "pf_sg_n" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          }
        ]
      },
      {
        "if": { "math": [ "pf_sg_wave == 2" ] },
        "then": [
          {
            "u_spawn_monster": "mon_zombie",
            "real_count": { "math": [ "max(pf_sg_n - 3, 1)" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          },
          {
            "u_spawn_monster": "mon_zombie_runner",
            "real_count": { "math": [ "2" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          },
          {
            "u_spawn_monster": "mon_zombie_dog",
            "real_count": { "math": [ "2" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          }
        ]
      },
      {
        "if": { "math": [ "pf_sg_wave == 3" ] },
        "then": [
          {
            "u_spawn_monster": "mon_zombie",
            "real_count": { "math": [ "max(pf_sg_n - 4, 1)" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          },
          {
            "u_spawn_monster": "mon_zombie_tough",
            "real_count": { "math": [ "2" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          },
          {
            "u_spawn_monster": "mon_zombie_fat",
            "real_count": { "math": [ "1" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          },
          {
            "u_spawn_monster": "mon_zombie_brute",
            "real_count": { "math": [ "1" ] },
            "target_var": { "global_val": "pf_sg_at" },
            "min_radius": 0,
            "max_radius": 6
          }
        ]
      },
      {
        "if": { "math": [ "pf_sg_wave == 1" ] },
        "then": [
          { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_wave1" } },
          { "math": [ "pf_sg_kids = 0" ] },
          { "math": [ "pf_sg_ad = 0" ] },
          { "math": [ "pf_sg_kbest = -1" ] },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_SIEGE_kidcount",
                "condition": { "and": [ { "u_has_trait": "PF_CHILD" }, { "math": [ "value_or(u_pf_resident, 0) == 1" ] } ] },
                "effect": [ { "math": [ "pf_sg_kids += 1" ] } ]
              }
            ],
            "local": true,
            "npc_range": 60
          },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_SIEGE_keeper_pick",
                "condition": {
                  "and": [
                    {
                      "and": [
                        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                        { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                        { "math": [ "has_var(u_pf_uid)" ] }
                      ]
                    },
                    { "not": { "u_has_effect": "sleep" } }
                  ]
                },
                "effect": [
                  { "math": [ "pf_sg_ad += 1" ] },
                  { "math": [ "_ks = value_or(u_pf_kids_n, 0) * 10 + rand(5)" ] },
                  {
                    "if": { "math": [ "_ks > pf_sg_kbest" ] },
                    "then": [ { "math": [ "pf_sg_kbest = _ks" ] }, { "u_set_talker": { "global_val": "pf_sg_keeper" } } ]
                  }
                ]
              }
            ],
            "local": true,
            "npc_range": 60
          },
          {
            "if": { "math": [ "(pf_sg_kids > 0) * (pf_sg_ad >= 2) * (pf_sg_kbest >= 0)" ] },
            "then": [
              {
                "run_eocs": {
                  "id": "PF_SIEGE_keeper_set",
                  "effect": [
                    { "math": [ "u_pf_sg_keep_t = pf_sg_t0" ] },
                    { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
                    { "copy_var": { "global_val": "pf_home_loc" }, "target_var": { "u_val": "pf_walk_to" } },
                    { "u_set_guard_pos": { "u_val": "pf_walk_to" } }
                  ]
                },
                "alpha_talker": { "global_val": "pf_sg_keeper" }
              },
              { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_keeper" } }
            ]
          }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_sg_wave == 1" ] }, { "u_has_effect": "sleep" } ] },
        "then": [
          { "u_lose_effect": "sleep" },
          { "u_lose_effect": "lying_down" },
          { "u_lose_effect": "PF_sleep_easy" },
          { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_wake" } }
        ]
      },
      {
        "if": { "math": [ "pf_sg_wave == 2" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_wave2" } } ]
      },
      {
        "if": { "math": [ "pf_sg_wave == 3" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_wave3" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_end",
    "//": "u = avatar.  The siege is over: who was lost, 'The place held' morale (+10), a shared-danger moment between you and everyone who lives here, and the place's draw goes up (a place that held gets talked about).",
    "effect": [
      { "math": [ "pf_sg_state = 0" ] },
      { "math": [ "pf_sg_last_day = floor(time('now') / time('1 d'))" ] },
      { "math": [ "pf_sg_lost = value_or(pf_ours_dead_total, 0) - pf_sg_deaths0" ] },
      { "math": [ "pf_sieges_total = value_or(pf_sieges_total, 0) + 1" ] },
      { "math": [ "pf_sieges_held = value_or(pf_sieges_held, 0) + 1" ] },
      { "math": [ "pf_sg_retell_day = floor(time('now') / time('1 d')) + 1" ] },
      {
        "u_add_morale": "PF_morale_held",
        "bonus": 10,
        "max_bonus": 10,
        "duration": "2 days",
        "decay_start": "1 days"
      },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_SIEGE_bond",
            "condition": { "and": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "has_var(u_pf_uid)" ] } ] },
            "effect": [ { "math": [ "pf_m_str_in = 60" ] }, { "run_eocs": "PF_MK_shared_danger", "beta_talker": "avatar" } ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "math": [ "value_or(pf_town_named, 0) == 1" ] },
        "then": [
          { "copy_var": { "global_val": "pf_town_name" }, "target_var": { "global_val": "pf_kp_place" } },
          { "copy_var": { "global_val": "pf_town_name" }, "target_var": { "global_val": "pf_kp_Place" } }
        ],
        "else": [
          { "set_string_var": "the place", "target_var": { "global_val": "pf_kp_place" } },
          { "set_string_var": "The place", "target_var": { "global_val": "pf_kp_Place" } }
        ]
      },
      {
        "if": { "math": [ "pf_sg_lost == 0" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_held" } } ],
        "else": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_held_loss" } } ]
      },
      {
        "if": { "math": [ "value_or(pf_sg_guest_dead, 0) == 1" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_guest_fell" } } ]
      },
      {
        "if": { "math": [ "value_or(pf_sg_guest_dead, 0) > 1" ] },
        "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_guests_fell" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_guest_died",
    "//": "Signal: someone who doesn't live here (a visiting band, a neighbor) dies while the siege is on, at the place.",
    "eoc_type": "EVENT",
    "required_event": "character_dies",
    "condition": {
      "and": [
        "has_alpha",
        "u_is_npc",
        { "math": [ "has_var(u_pf_uid)" ] },
        { "math": [ "value_or(pf_sg_state, 0) == 1" ] },
        { "math": [ "value_or(pf_sg_wave, 0) >= 1" ] },
        { "math": [ "value_or(u_pf_resident, 0) == 0" ] },
        { "math": [ "value_or(u_pf_envoy, 0) == 0" ] },
        { "math": [ "value_or(u_pf_nv_gone, 0) == 0" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_sg_guest_dead = value_or(pf_sg_guest_dead, 0) + 1" ] },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_sg_guest_name" }, "parse_tags": true }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SIEGE_retell_tick",
    "//": "The evening after a siege, at the fire or the table: it's told again.",
    "recurrence": "30 minutes",
    "global": true,
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "value_or(pf_sg_retell_day, -1) == floor(time('now') / time('1 d'))" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 20" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 23" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_sg_retell_day = -1" ] },
      {
        "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
        "then": [
          {
            "if": { "math": [ "pf_sg_lost == 0" ] },
            "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_retell" } } ],
            "else": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "siege_retell_loss" } } ]
          }
        ]
      }
    ]
  }
]
