          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_mark",
    "//": "u = someone just given a seat: marked with this term's number.",
    "effect": [ { "math": [ "u_pf_cn_term = pf_cn_term" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_list",
    "//": "u = avatar.  The council's names as a list, and who speaks for it.",
    "effect": [
      {
        "if": { "math": [ "pf_cn_n >= 3" ] },
        "then": [
          {
            "set_string_var": "<global_val:pf_cn_name_1>, <global_val:pf_cn_name_2> and <global_val:pf_cn_name_3>",
            "target_var": { "global_val": "pf_cn_list" },
            "parse_tags": true
          }
        ],
        "else": [
