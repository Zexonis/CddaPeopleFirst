    "//": "u = avatar.  Under the council, an envoy's offer is the council's to answer: each councillor here as a chief would (their temperament and how things stand), you too if you hold a seat.  A tie is a no.",
    "effect": [
      { "math": [ "pf_cnv_y = 0" ] },
      { "math": [ "pf_cnv_no = 0" ] },
      { "u_location_variable": { "global_val": "pf_kp_av" } },
      { "math": [ "pf_cnv_here = 0" ] },
      {
        "if": { "math": [ "value_or(pf_cn_n, 0) >= 1" ] },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_cn_uid_1" }, "AVATAR" ] },
            "then": [
              {
                "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  {
                    "if": { "u_query": { "global_val": "pf_nb_q" }, "default": false },
                    "then": [ { "math": [ "pf_cnv_y += 1" ] } ],
                    "else": [ { "math": [ "pf_cnv_no += 1" ] } ]
                  }
                ]
              }
            ],
            "else": [
              { "copy_var": { "global_val": "pf_cn_uid_1" }, "target_var": { "global_val": "pf_find_uid" } },
              { "run_eocs": "PF_FIND_by_uid" },
              {
                "if": { "math": [ "pf_find_ok == 1" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  { "run_eocs": "PF_NB_cn_vote_one", "alpha_talker": { "global_val": "pf_find_who" } }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "value_or(pf_cn_n, 0) >= 2" ] },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_cn_uid_2" }, "AVATAR" ] },
            "then": [
              {
                "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  {
                    "if": { "u_query": { "global_val": "pf_nb_q" }, "default": false },
                    "then": [ { "math": [ "pf_cnv_y += 1" ] } ],
                    "else": [ { "math": [ "pf_cnv_no += 1" ] } ]
                  }
                ]
              }
            ],
            "else": [
              { "copy_var": { "global_val": "pf_cn_uid_2" }, "target_var": { "global_val": "pf_find_uid" } },
              { "run_eocs": "PF_FIND_by_uid" },
              {
                "if": { "math": [ "pf_find_ok == 1" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  { "run_eocs": "PF_NB_cn_vote_one", "alpha_talker": { "global_val": "pf_find_who" } }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "value_or(pf_cn_n, 0) >= 3" ] },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_cn_uid_3" }, "AVATAR" ] },
            "then": [
              {
                "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  {
                    "if": { "u_query": { "global_val": "pf_nb_q" }, "default": false },
                    "then": [ { "math": [ "pf_cnv_y += 1" ] } ],
                    "else": [ { "math": [ "pf_cnv_no += 1" ] } ]
                  }
                ]
              }
            ],
            "else": [
              { "copy_var": { "global_val": "pf_cn_uid_3" }, "target_var": { "global_val": "pf_find_uid" } },
              { "run_eocs": "PF_FIND_by_uid" },
              {
                "if": { "math": [ "pf_find_ok == 1" ] },
                "then": [
                  { "math": [ "pf_cnv_here += 1" ] },
                  { "run_eocs": "PF_NB_cn_vote_one", "alpha_talker": { "global_val": "pf_find_who" } }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "pf_cnv_here == 0" ] },
        "then": [
          {
            "if": { "u_query": { "global_val": "pf_nb_q" }, "default": false },
            "then": [ { "math": [ "pf_nb_yes = 1" ] } ],
            "else": [ { "math": [ "pf_nb_yes = 0" ] } ]
          }
        ],
        "else": [
          { "math": [ "pf_nb_yes = pf_cnv_y > pf_cnv_no" ] },
          {
            "if": { "math": [ "pf_nb_yes" ] },
            "then": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "nb_council_yes" } } ],
            "else": [ { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "nb_council_no" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_NB_cn_vote_one",
    "//": "u = a councillor: yes or no to the envoy.",
    "effect": [
      { "run_eocs": "PF_NB_vote_calc" },
      {
        "if": { "math": [ "pf_nb_yes" ] },
        "then": [ { "math": [ "pf_cnv_y += 1" ] } ],
        "else": [ { "math": [ "pf_cnv_no += 1" ] } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_on_death",
    "//": "A councillor died: the council is a seat short, and the meeting chooses it again the next evening.",
    "eoc_type": "EVENT",
    "required_event": "character_dies",
    "condition": {
      "and": [
        "has_alpha",
        "u_is_npc",
        { "math": [ "has_var(u_pf_uid)" ] },
        { "math": [ "(value_or(pf_cn_n, 0) > 0) * (value_or(u_pf_cn_term, -1) == value_or(pf_cn_term, -2))" ] },
        {
          "not": {
            "and": [
              { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
              { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_chief_uid" } ] }
            ]
          }
        }
      ]
    },
    "effect": [
      { "math": [ "pf_cn_n = 0" ] },
      { "math": [ "pf_mt_due = 1" ] },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_cn_dead_name" }, "parse_tags": true },
      { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "council_lost" } }
    ]
  }
]
