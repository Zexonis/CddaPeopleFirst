[
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_council_election",
    "//": "u = avatar.  Under the council law: you're asked whether you'll stand, everyone puts a hand up for each of the three they'd most follow (one hand each made a small place pile every vote on one person), and the three with the most hands take the seats (at least one hand each; two seats or no council).  The one with the most speaks for it, and holds the chair as chief: they fine shirkers and are the one a confidence vote turns on.",
    "effect": [
      { "math": [ "pf_ke_you = 0" ] },
      { "math": [ "pf_ke_total = 0" ] },
      {
        "if": { "math": [ "distance(pf_kp_av, pf_home_loc) <= 30" ] },
        "then": [
          {
            "if": {
              "u_query": "The meeting is choosing a council of three to run the place.  Will you stand for a seat?",
              "default": false
            },
            "then": [ { "math": [ "pf_ke_you = 1" ] } ]
          }
        ]
      },
      { "math": [ "pf_kv_AVATAR = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_cn_tally_reset",
            "condition": {
              "and": [
                { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                { "math": [ "has_var(u_pf_uid)" ] }
              ]
            },
            "effect": [
              { "set_string_var": "pf_kv_<u_val:pf_uid>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              { "math": [ "v_kv = 0" ] }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      { "u_run_npc_eocs": [ "PF_KEEP_cn_voter" ], "local": true, "npc_range": 60 },
      { "math": [ "pf_cn_term = value_or(pf_cn_term, 0) + 1" ] },
      { "math": [ "pf_cn_n = 0" ] },
      { "math": [ "pf_cn_youin = 0" ] },
      { "run_eocs": "PF_KEEP_cn_seat_1" },
      { "run_eocs": "PF_KEEP_cn_seat_2" },
      { "run_eocs": "PF_KEEP_cn_seat_3" },
      {
        "if": { "math": [ "pf_cn_n < 2" ] },
        "then": [
          { "math": [ "pf_cn_n = 0" ] },
          { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "council_none" } }
        ],
        "else": [
          { "math": [ "pf_cn_same = 0" ] },
          {
            "if": {
              "and": [
                { "math": [ "value_or(pf_chief_set, 0) == 2" ] },
                { "compare_string": [ { "global_val": "pf_cn_uid_1" }, "AVATAR" ] }
              ]
            },
            "then": [ { "math": [ "pf_cn_same = 1" ] } ]
          },
          {
            "if": {
              "and": [
                { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
                { "compare_string": [ { "global_val": "pf_cn_uid_1" }, { "global_val": "pf_chief_uid" } ] }
              ]
            },
            "then": [ { "math": [ "pf_cn_same = 1" ] } ]
          },
          {
            "if": { "compare_string": [ { "global_val": "pf_cn_uid_1" }, "AVATAR" ] },
            "then": [
              { "math": [ "pf_chief_set = 2" ] },
              { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_chief_uid" } },
              { "set_string_var": "you", "target_var": { "global_val": "pf_chief_name" } }
            ],
            "else": [
              { "math": [ "pf_chief_set = 1" ] },
              { "copy_var": { "global_val": "pf_cn_uid_1" }, "target_var": { "global_val": "pf_chief_uid" } },
              { "copy_var": { "global_val": "pf_cn_name_1" }, "target_var": { "global_val": "pf_chief_name" } }
            ]
          },
          { "if": { "math": [ "pf_cn_same == 0" ] }, "then": [ { "math": [ "pf_chief_since = time('now')" ] } ] },
          { "math": [ "pf_chief_away = 0" ] },
          { "math": [ "pf_cn_since = time('now')" ] },
          { "math": [ "pf_elections_total = value_or(pf_elections_total, 0) + 1" ] },
          { "math": [ "pf_councils_total = value_or(pf_councils_total, 0) + 1" ] },
          { "run_eocs": "PF_KEEP_cn_list" },
          { "run_eocs": "PF_SAY_keep", "alpha_talker": "avatar", "variables": { "line": "council_chosen" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_voter",
    "//": "u = a grown-up who lives here: for the council they put a hand up for each of the three they'd most follow (among those they know: warmth + trust 10+), and the first of them gets a voted_for moment.",
    "condition": {
      "and": [
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
        { "math": [ "has_var(u_pf_uid)" ] }
      ]
    },
    "effect": [
      { "u_set_talker": { "global_val": "pf_kv_voter" } },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_kv_vuid" } },
      { "math": [ "pf_c1 = -999" ] },
      { "math": [ "pf_c2 = -999" ] },
      { "math": [ "pf_c3 = -999" ] },
      { "set_string_var": "none", "target_var": { "global_val": "pf_c1u" } },
      { "set_string_var": "none", "target_var": { "global_val": "pf_c2u" } },
      { "set_string_var": "none", "target_var": { "global_val": "pf_c3u" } },
      {
        "if": { "math": [ "pf_ke_you == 1" ] },
        "then": [
          { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } },
          { "run_eocs": "PF_VIEW_read" },
          {
            "if": { "math": [ "pf_read_t + pf_read_w >= 10" ] },
            "then": [
              { "math": [ "pf_c1 = pf_read_t + pf_read_w / 2 - pf_read_x" ] },
              { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_c1u" } }
            ]
          }
        ]
      },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_cn_cand",
            "condition": {
              "and": [
                {
                  "and": [
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "math": [ "has_var(u_pf_uid)" ] }
                  ]
                },
                { "not": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_kv_vuid" } ] } }
              ]
            },
            "effect": [
              { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_m_other" } },
              { "run_eocs": "PF_VIEW_read", "alpha_talker": { "global_val": "pf_kv_voter" } },
              { "math": [ "_s = pf_read_t + pf_read_w / 2 - pf_read_x" ] },
              {
                "if": { "math": [ "pf_read_t + pf_read_w >= 10" ] },
                "then": [
                  {
                    "if": { "math": [ "_s > pf_c1" ] },
                    "then": [
                      { "math": [ "pf_c3 = pf_c2" ] },
                      { "copy_var": { "global_val": "pf_c2u" }, "target_var": { "global_val": "pf_c3u" } },
                      { "math": [ "pf_c2 = pf_c1" ] },
                      { "copy_var": { "global_val": "pf_c1u" }, "target_var": { "global_val": "pf_c2u" } },
                      { "math": [ "pf_c1 = _s" ] },
                      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_c1u" } },
                      { "u_set_talker": { "global_val": "pf_c1t" } }
                    ],
                    "else": [
                      {
                        "if": { "math": [ "_s > pf_c2" ] },
                        "then": [
                          { "math": [ "pf_c3 = pf_c2" ] },
                          { "copy_var": { "global_val": "pf_c2u" }, "target_var": { "global_val": "pf_c3u" } },
                          { "math": [ "pf_c2 = _s" ] },
                          { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_c2u" } }
                        ],
                        "else": [
                          {
                            "if": { "math": [ "_s > pf_c3" ] },
                            "then": [ { "math": [ "pf_c3 = _s" ] }, { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_c3u" } } ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "not": { "compare_string": [ { "global_val": "pf_c1u" }, "none" ] } },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_c1u" }, "AVATAR" ] },
            "then": [ { "math": [ "pf_kv_AVATAR += 1" ] } ],
            "else": [
              { "set_string_var": "pf_kv_<global_val:pf_c1u>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              { "math": [ "v_kv = value_or(v_kv, 0) + 1" ] }
            ]
          }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "global_val": "pf_c2u" }, "none" ] } },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_c2u" }, "AVATAR" ] },
            "then": [ { "math": [ "pf_kv_AVATAR += 1" ] } ],
            "else": [
              { "set_string_var": "pf_kv_<global_val:pf_c2u>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              { "math": [ "v_kv = value_or(v_kv, 0) + 1" ] }
            ]
          }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "global_val": "pf_c3u" }, "none" ] } },
        "then": [
          {
            "if": { "compare_string": [ { "global_val": "pf_c3u" }, "AVATAR" ] },
            "then": [ { "math": [ "pf_kv_AVATAR += 1" ] } ],
            "else": [
              { "set_string_var": "pf_kv_<global_val:pf_c3u>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              { "math": [ "v_kv = value_or(v_kv, 0) + 1" ] }
            ]
          }
        ]
      },
      {
        "if": { "compare_string": [ { "global_val": "pf_c1u" }, "AVATAR" ] },
        "then": [ { "math": [ "pf_m_str_in = 30" ] }, { "run_eocs": "PF_MK_voted_for", "beta_talker": "avatar" } ],
        "else": [
          {
            "if": { "not": { "compare_string": [ { "global_val": "pf_c1u" }, "none" ] } },
            "then": [ { "math": [ "pf_m_str_in = 30" ] }, { "run_eocs": "PF_MK_voted_for", "beta_talker": { "global_val": "pf_c1t" } } ]
          }
        ]
      },
      { "math": [ "pf_ke_total += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_seat_1",
    "//": "u = avatar.  Seat 1: whoever has the most hands among those not yet seated (at least one); you, if you stood and beat them outright.",
    "condition": { "math": [ "pf_cn_n == 0" ] },
    "effect": [
      { "math": [ "pf_kw_best = 0" ] },
      { "math": [ "pf_kw_sel = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_cn_count_1",
            "condition": {
              "and": [
                {
                  "and": [
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "math": [ "has_var(u_pf_uid)" ] }
                  ]
                },
                { "math": [ "value_or(u_pf_cn_term, -1) != pf_cn_term" ] }
              ]
            },
            "effect": [
              { "set_string_var": "pf_kv_<u_val:pf_uid>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              {
                "if": { "math": [ "value_or(v_kv, 0) > pf_kw_best" ] },
                "then": [
                  { "math": [ "pf_kw_best = v_kv" ] },
                  { "math": [ "pf_kw_sel = 1" ] },
                  { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_kw_uid" } },
                  { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_kw_name" }, "parse_tags": true }
                ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "math": [ "(pf_ke_you == 1) * (pf_cn_youin == 0) * (pf_kv_AVATAR > pf_kw_best)" ] },
        "then": [ { "math": [ "pf_kw_best = pf_kv_AVATAR" ] }, { "math": [ "pf_kw_sel = 2" ] } ]
      },
      {
        "if": { "math": [ "pf_kw_sel == 2" ] },
        "then": [
          { "math": [ "pf_cn_n += 1" ] },
          { "math": [ "pf_cn_youin = 1" ] },
          { "math": [ "pf_cn_v_1 = pf_kw_best" ] },
          { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_cn_uid_1" } },
          { "set_string_var": "you", "target_var": { "global_val": "pf_cn_name_1" } }
        ]
      },
      {
        "if": { "math": [ "pf_kw_sel == 1" ] },
        "then": [
          { "math": [ "pf_cn_n += 1" ] },
          { "math": [ "pf_cn_v_1 = pf_kw_best" ] },
          { "copy_var": { "global_val": "pf_kw_uid" }, "target_var": { "global_val": "pf_cn_uid_1" } },
          { "copy_var": { "global_val": "pf_kw_name" }, "target_var": { "global_val": "pf_cn_name_1" } },
          { "copy_var": { "global_val": "pf_kw_uid" }, "target_var": { "global_val": "pf_find_uid" } },
          { "run_eocs": "PF_FIND_by_uid" },
          {
            "if": { "math": [ "pf_find_ok == 1" ] },
            "then": [ { "run_eocs": "PF_KEEP_cn_mark", "alpha_talker": { "global_val": "pf_find_who" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_seat_2",
    "//": "u = avatar.  Seat 2: whoever has the most hands among those not yet seated (at least one); you, if you stood and beat them outright.",
    "condition": { "math": [ "pf_cn_n == 1" ] },
    "effect": [
      { "math": [ "pf_kw_best = 0" ] },
      { "math": [ "pf_kw_sel = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_KEEP_cn_count_2",
            "condition": {
              "and": [
                {
                  "and": [
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "math": [ "has_var(u_pf_uid)" ] }
                  ]
                },
                { "math": [ "value_or(u_pf_cn_term, -1) != pf_cn_term" ] }
              ]
            },
            "effect": [
              { "set_string_var": "pf_kv_<u_val:pf_uid>", "target_var": { "context_val": "kv" }, "parse_tags": true },
              {
                "if": { "math": [ "value_or(v_kv, 0) > pf_kw_best" ] },
                "then": [
                  { "math": [ "pf_kw_best = v_kv" ] },
                  { "math": [ "pf_kw_sel = 1" ] },
                  { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_kw_uid" } },
                  { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_kw_name" }, "parse_tags": true }
                ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "math": [ "(pf_ke_you == 1) * (pf_cn_youin == 0) * (pf_kv_AVATAR > pf_kw_best)" ] },
        "then": [ { "math": [ "pf_kw_best = pf_kv_AVATAR" ] }, { "math": [ "pf_kw_sel = 2" ] } ]
      },
      {
        "if": { "math": [ "pf_kw_sel == 2" ] },
        "then": [
          { "math": [ "pf_cn_n += 1" ] },
          { "math": [ "pf_cn_youin = 1" ] },
          { "math": [ "pf_cn_v_2 = pf_kw_best" ] },
          { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_cn_uid_2" } },
          { "set_string_var": "you", "target_var": { "global_val": "pf_cn_name_2" } }
        ]
      },
      {
        "if": { "math": [ "pf_kw_sel == 1" ] },
        "then": [
          { "math": [ "pf_cn_n += 1" ] },
          { "math": [ "pf_cn_v_2 = pf_kw_best" ] },
          { "copy_var": { "global_val": "pf_kw_uid" }, "target_var": { "global_val": "pf_cn_uid_2" } },
          { "copy_var": { "global_val": "pf_kw_name" }, "target_var": { "global_val": "pf_cn_name_2" } },
          { "copy_var": { "global_val": "pf_kw_uid" }, "target_var": { "global_val": "pf_find_uid" } },
          { "run_eocs": "PF_FIND_by_uid" },
          {
            "if": { "math": [ "pf_find_ok == 1" ] },
            "then": [ { "run_eocs": "PF_KEEP_cn_mark", "alpha_talker": { "global_val": "pf_find_who" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KEEP_cn_seat_3",
    "//": "u = avatar.  Seat 3: whoever has the most hands among those not yet seated (at least one); you, if you stood and beat them outright.",
