[
  {
    "type": "mutation",
    "id": "PF_T_SOCIABLE",
    "name": { "str": "Sociable" },
    "points": 0,
    "valid": false,
    "purifiable": false,
    "player_display": false,
    "description": "Draws warmth from company: meals, fires and play count for more."
