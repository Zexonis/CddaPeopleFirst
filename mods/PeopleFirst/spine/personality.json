  {
    "type": "mutation",
    "id": "PF_T_LONER",
    "name": { "str": "Loner" },
    "points": 0,
    "valid": false,
    "purifiable": false,
    "player_display": false,
    "description": "Company wears on them.  Gatherings count for less, quiet kindness for more."
  },
  {
    "type": "mutation",
    "id": "PF_Q_LOYAL",
    "name": { "str": "Loyal to a fault" },
    "points": 0,
    "valid": false,
    "purifiable": false,
    "player_display": false,
    "description": "Being covered for, cared for or saved builds trust twice as fast."
  },
  {
    "type": "mutation",
    "id": "PF_Q_HATES_WASTE",
    "name": { "str": "Hates waste" },
    "points": 0,
    "valid": false,
    "purifiable": false,
    "player_display": false,
    "description": "Wasted food or supplies sour their view of whoever did it."
  },
  {
    "type": "mutation",
    "id": "PF_Q_MOTHER_HEN",
    "name": { "str": "Mother hen" },
    "points": 0,
    "valid": false,
    "purifiable": false,
    "player_display": false,
    "description": "Seeing someone in danger or being cared for makes them care more."
  },
  {
    "type": "mutation",
    "id": "PF_Q_GALLOWS",
