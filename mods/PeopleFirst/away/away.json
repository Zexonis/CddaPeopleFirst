[
  {
    "type": "effect_on_condition",
    "id": "PF_AW_tick",
    "//": "Every 10 minutes while you have a home: at home (within 30 tiles), the household roll every 30 minutes; more than 60 tiles out, you're away; away, one away day per full day gone; back within 30 tiles, the homecoming.  Only math and your own position: nothing here touches the map at home while you're gone.",
    "recurrence": "10 minutes",
    "global": true,
    "condition": { "math": [ "value_or(pf_home_set, 0) == 1" ] },
    "effect": [
      { "u_location_variable": { "global_val": "pf_aw_av" } },
      { "math": [ "pf_aw_d = distance(pf_aw_av, pf_home_loc)" ] },
      {
        "if": { "math": [ "value_or(pf_aw_state, 0) == 1" ] },
        "then": [
          { "math": [ "pf_aw_due = floor((time('now') - pf_aw_since) / time('1 d'))" ] },
          { "run_eocs": "PF_AW_day", "condition": { "math": [ "pf_aw_days_done < pf_aw_due" ] }, "iterations": 60 },
          { "if": { "math": [ "pf_aw_d <= 30" ] }, "then": [ { "run_eocs": "PF_AW_return" } ] }
        ],
        "else": [
          {
            "if": { "math": [ "pf_aw_d > 60" ] },
            "then": [ { "run_eocs": "PF_AW_leave" } ],
            "else": [
              {
                "if": { "math": [ "(pf_aw_d <= 30) * (time('now') - value_or(pf_hh_t, 0) >= time('30 m'))" ] },
                "then": [ { "run_eocs": "PF_AW_roll" } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_roll",
    "//": "u = avatar, home.  Who lives here (uid, name, grown-up or child, job counts) and the animals, for while you're away (pf_hh_*).",
    "effect": [
      { "math": [ "pf_hh_t = time('now')" ] },
      { "math": [ "pf_hh_n = 0" ] },
      { "math": [ "pf_hh_adults = 0" ] },
      { "math": [ "pf_hh_kids = 0" ] },
      { "math": [ "pf_hh_cooks = 0" ] },
      { "math": [ "pf_hh_foragers = 0" ] },
      { "u_run_npc_eocs": [ "PF_AW_roll_one" ], "local": true, "npc_range": 60 },
      { "if": { "math": [ "value_or(pf_aw_dead_pending, 0) == 1" ] }, "then": [ { "run_eocs": "PF_AW_bury_scan" } ] },
      {
        "math": [ "pf_hh_cows = monsters_nearby('mon_cow', 'radius': 25, 'location': pf_home_loc, 'attitude': 'friendly')" ]
      },
      {
        "math": [ "pf_hh_goats = monsters_nearby('mon_goat', 'radius': 25, 'location': pf_home_loc, 'attitude': 'friendly')" ]
      },
      {
        "math": [ "pf_hh_hens = monsters_nearby('mon_chicken', 'radius': 25, 'location': pf_home_loc, 'attitude': 'friendly')" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_roll_one",
    "//": "u = someone who lives here.",
    "condition": {
      "and": [
        { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
        { "math": [ "has_var(u_pf_uid)" ] },
        { "math": [ "pf_hh_n < 24" ] }
      ]
    },
    "effect": [
      { "set_string_var": "pf_hh_uid_<global_val:pf_hh_n>", "target_var": { "context_val": "ru" }, "parse_tags": true },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "var_val": "ru" } },
      { "set_string_var": "pf_hh_nm_<global_val:pf_hh_n>", "target_var": { "context_val": "rn" }, "parse_tags": true },
      { "set_string_var": "<u_name>", "target_var": { "var_val": "rn" }, "parse_tags": true },
      { "set_string_var": "pf_hh_ad_<global_val:pf_hh_n>", "target_var": { "context_val": "ra" }, "parse_tags": true },
      {
        "if": { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        "then": [
          { "math": [ "v_ra = 1" ] },
          { "math": [ "pf_hh_adults += 1" ] },
          { "if": { "math": [ "value_or(u_pf_role, 0) == 1" ] }, "then": [ { "math": [ "pf_hh_cooks += 1" ] } ] },
          { "if": { "math": [ "value_or(u_pf_role, 0) == 3" ] }, "then": [ { "math": [ "pf_hh_foragers += 1" ] } ] }
        ],
        "else": [ { "math": [ "v_ra = 0" ] }, { "math": [ "pf_hh_kids += 1" ] } ]
      },
      { "math": [ "pf_hh_n += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_leave",
    "//": "u = avatar, now more than 60 tiles from home.  From here the place is data until you're back.",
    "effect": [
      {
        "if": { "math": [ "time('now') - value_or(pf_hh_t, 0) >= time('1 d')" ] },
        "then": [
          { "run_eocs": "PF_AW_roll" },
          {
            "if": { "math": [ "(pf_hh_n == 0) * (value_or(pf_residents_n, 0) > 0)" ] },
            "then": [
              { "math": [ "pf_hh_n = pf_residents_n" ] },
              { "math": [ "pf_hh_adults = pf_residents_n" ] },
              { "math": [ "pf_hh_cooks = 1" ] }
            ]
          }
        ]
      },
      { "math": [ "pf_aw_state = 1" ] },
      { "math": [ "pf_aw_since = time('now')" ] },
      { "math": [ "pf_aw_days_done = 0" ] },
      { "math": [ "pf_aw_news_n = 0" ] },
      { "math": [ "pf_pn_soup = 0" ] },
      { "math": [ "pf_pn_water = 0" ] },
      { "math": [ "pf_pn_forage = 0" ] },
      { "math": [ "pf_pn_eggs = 0" ] },
      { "math": [ "pf_pn_harvest = 0" ] },
      { "math": [ "pf_pn_del_0 = 0" ] },
      { "math": [ "pf_pn_del_1 = 0" ] },
      { "math": [ "pf_pn_del_2 = 0" ] },
      { "math": [ "pf_aw_field_redo = 0" ] },
      { "math": [ "pf_aw_meet_missed = 0" ] },
      { "math": [ "pf_aw_wall_n = 0" ] },
      { "math": [ "pf_aw_meet_dshow = 0" ] },
      { "set_string_var": "none", "target_var": { "global_val": "pf_aw_hurt_uid" } },
      { "math": [ "pf_aw_leaves_total = value_or(pf_aw_leaves_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_day",
    "//": "u = avatar, away.  One day at home, as data: the pantry fills by the household's jobs (a cook's pot, water, the forager's finds, eggs by the last count; capped, since only you eat), the stores grow, the field is harvested when grown and planted again in season (its terrain catches up when you're back), and a missed meeting day is noted.",
    "effect": [
      { "math": [ "pf_aw_days_done += 1" ] },
      { "math": [ "pf_aw_dno = floor(pf_aw_since / time('1 d')) + pf_aw_days_done" ] },
      { "math": [ "pf_aw_dshow = pf_aw_dno + 1" ] },
      { "math": [ "_wd = pf_aw_dshow - 1" ] },
      { "math": [ "_ws = floor((_wd % 364) / 91)" ] },
      { "math": [ "pf_aw_wday = (_wd % 91) + 1" ] },
      {
        "if": { "math": [ "_ws == 0" ] },
        "then": [
          {
            "set_string_var": "Spring, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 1" ] },
        "then": [
          {
            "set_string_var": "Summer, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 2" ] },
        "then": [
          {
            "set_string_var": "Autumn, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 3" ] },
        "then": [
          {
            "set_string_var": "Winter, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "value_or(pf_hh_n, 0) > 0" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_hh_cooks, 0) > 0" ] },
            "then": [ { "math": [ "pf_pn_soup = min(pf_pn_soup + 2, 6)" ] } ]
          },
          { "math": [ "pf_pn_water = min(pf_pn_water + 8, 16)" ] },
          {
            "if": { "math": [ "value_or(pf_hh_foragers, 0) > 0" ] },
            "then": [ { "math": [ "pf_pn_forage = min(pf_pn_forage + 1, 4)" ] } ]
          },
          { "math": [ "pf_pn_eggs = min(pf_pn_eggs + floor((value_or(pf_hh_hens, 0) + 1) / 2), 12)" ] },
          {
            "math": [
              "pf_stores = value_or(pf_stores, 0) + value_or(pf_hh_cows, 0) + value_or(pf_hh_goats, 0) + floor(value_or(pf_hh_hens, 0) / 4) + (value_or(pf_hh_adults, 0) >= 2)"
            ]
          },
          {
            "if": {
              "math": [
                "(value_or(pf_field_state, 0) == 2) * (time('now') - value_or(pf_field_t, 0) >= time('1 d') * (value_or(pf_set_grow, 1) == 0 ? 90 : (value_or(pf_set_grow, 1) == 1 ? 30 : 2)))"
              ]
            },
            "then": [
              { "math": [ "pf_field_state = 1" ] },
              { "math": [ "pf_harvest_day = pf_aw_dno" ] },
              { "math": [ "pf_stores = value_or(pf_stores, 0) + 20" ] },
              { "math": [ "pf_harvests_total = value_or(pf_harvests_total, 0) + 1" ] },
              { "math": [ "pf_pn_harvest = 1" ] },
              { "math": [ "pf_aw_field_redo = 1" ] },
              {
                "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
                "then": [
                  { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
                  {
                    "set_string_var": "<global_val:pf_aw_dwhen>: the field came in.  Potatoes, carrots, cabbages: the stores are full.",
                    "target_var": { "var_val": "nk" },
                    "parse_tags": true
                  },
                  { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
                ]
              }
            ],
            "else": [
              {
                "if": {
                  "and": [
                    { "math": [ "value_or(pf_field_state, 0) == 1" ] },
                    { "math": [ "value_or(pf_hh_adults, 0) > 0" ] },
                    { "or": [ { "is_season": "spring" }, { "is_season": "summer" } ] }
                  ]
                },
                "then": [
                  { "math": [ "pf_field_state = 2" ] },
                  { "math": [ "pf_field_t = time('now')" ] },
                  { "math": [ "pf_plantings_total = value_or(pf_plantings_total, 0) + 1" ] },
                  { "math": [ "pf_aw_field_redo = 1" ] },
                  {
                    "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
                    "then": [
                      { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
                      {
                        "set_string_var": "<global_val:pf_aw_dwhen>: they planted the field again.",
                        "target_var": { "var_val": "nk" },
                        "parse_tags": true
                      },
                      { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "if": { "math": [ "(pf_aw_dno % 7 == 2) * (value_or(pf_meetings_total, 0) > 0)" ] },
            "then": [
              {
                "if": { "math": [ "pf_aw_meet_missed == 0" ] },
                "then": [
                  { "math": [ "pf_aw_meet_dshow = pf_aw_dshow" ] },
                  { "copy_var": { "global_val": "pf_aw_dwhen" }, "target_var": { "global_val": "pf_aw_meet_dwhen" } }
                ]
              },
              { "math": [ "pf_aw_meet_missed = 1" ] }
            ]
          },
          {
            "if": {
              "math": [
                "(value_or(pf_wall_state, 0) == 1) * (value_or(pf_hh_adults, 0) >= 2) * (value_or(pf_wall_side, 0) + pf_aw_wall_n < 4) * ((value_or(pf_law_rest, 0) == 1) * (pf_aw_dno % 7 == 2) == 0)"
              ]
            },
            "then": [
              { "math": [ "pf_aw_wall_n += 1" ] },
              { "math": [ "pf_aw_wk = value_or(pf_wall_side, 0) + pf_aw_wall_n" ] },
              {
                "if": { "math": [ "pf_aw_wk == 1" ] },
                "then": [ { "set_string_var": "north", "target_var": { "global_val": "pf_aw_wname" } } ]
              },
              {
                "if": { "math": [ "pf_aw_wk == 2" ] },
                "then": [ { "set_string_var": "east", "target_var": { "global_val": "pf_aw_wname" } } ]
              },
              {
                "if": { "math": [ "pf_aw_wk == 3" ] },
                "then": [ { "set_string_var": "south", "target_var": { "global_val": "pf_aw_wname" } } ]
              },
              {
                "if": { "math": [ "pf_aw_wk == 4" ] },
                "then": [ { "set_string_var": "west", "target_var": { "global_val": "pf_aw_wname" } } ]
              },
              {
                "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
                "then": [
                  { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
                  {
                    "set_string_var": "<global_val:pf_aw_dwhen>: the <global_val:pf_aw_wname> side of the wall went up.",
                    "target_var": { "var_val": "nk" },
                    "parse_tags": true
                  },
                  { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
                ]
              }
            ]
          }
        ]
      },
      { "math": [ "pf_aw_days_total = value_or(pf_aw_days_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_delivery",
    "//": "u = avatar, current settlement (gen_keep.py PF_NB_upkeep), while you're away: the week's goods wait in the pantry instead of being dropped on an unloaded map.",
    "effect": [
      { "math": [ "pf_aw_dshow = floor(time('now') / time('1 d')) + 1" ] },
      { "math": [ "_wd = pf_aw_dshow - 1" ] },
      { "math": [ "_ws = floor((_wd % 364) / 91)" ] },
      { "math": [ "pf_aw_wday = (_wd % 91) + 1" ] },
      {
        "if": { "math": [ "_ws == 0" ] },
        "then": [
          {
            "set_string_var": "Spring, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 1" ] },
        "then": [
          {
            "set_string_var": "Summer, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 2" ] },
        "then": [
          {
            "set_string_var": "Autumn, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 3" ] },
        "then": [
          {
            "set_string_var": "Winter, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "pf_cur_kind == 0" ] },
        "then": [ { "math": [ "pf_pn_del_0 = min(pf_pn_del_0 + 1, 2)" ] } ]
      },
      {
        "if": { "math": [ "pf_cur_kind == 1" ] },
        "then": [ { "math": [ "pf_pn_del_1 = min(pf_pn_del_1 + 1, 2)" ] } ]
      },
      {
        "if": { "math": [ "pf_cur_kind == 2" ] },
        "then": [ { "math": [ "pf_pn_del_2 = min(pf_pn_del_2 + 1, 2)" ] } ]
      },
      {
        "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
        "then": [
          { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
          {
            "set_string_var": "<global_val:pf_aw_dwhen>: carts came from <global_val:pf_cur_name>, as agreed.",
            "target_var": { "var_val": "nk" },
            "parse_tags": true
          },
          { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_AW_raid_news",
    "//": "u = avatar, current settlement (gen_keep.py PF_NB_raid), while you're away.  pf_aw_raid_held: 1 driven off, 0 got through.",
    "effect": [
      { "math": [ "pf_aw_dshow = floor(time('now') / time('1 d')) + 1" ] },
      { "math": [ "_wd = pf_aw_dshow - 1" ] },
      { "math": [ "_ws = floor((_wd % 364) / 91)" ] },
      { "math": [ "pf_aw_wday = (_wd % 91) + 1" ] },
      {
        "if": { "math": [ "_ws == 0" ] },
        "then": [
          {
            "set_string_var": "Spring, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 1" ] },
        "then": [
          {
            "set_string_var": "Summer, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 2" ] },
        "then": [
          {
            "set_string_var": "Autumn, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "_ws == 3" ] },
        "then": [
          {
            "set_string_var": "Winter, day <global_val:pf_aw_wday>",
            "target_var": { "global_val": "pf_aw_dwhen" },
            "parse_tags": true
          }
        ]
      },
      {
        "if": { "math": [ "pf_aw_raid_held == 1" ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
            "then": [
              { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
              {
                "set_string_var": "<global_val:pf_aw_dwhen>: raiders from <global_val:pf_cur_name> tried the place in the night.  They were driven off.",
                "target_var": { "var_val": "nk" },
                "parse_tags": true
              },
              { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
            ]
          }
        ],
        "else": [
          {
            "if": {
              "math": [
                "(value_or(pf_nb_att, 0) - value_or(pf_nb_def, 0) >= 3) * ((rand(1) == 0) + value_or(pf_aw_force_death, 0) > 0) * (value_or(pf_aw_dead_pending, 0) == 0)"
              ]
            },
            "then": [ { "run_eocs": "PF_AW_raid_wound" } ],
            "else": [
              { "math": [ "pf_aw_wf = 0" ] },
              { "if": { "math": [ "rand(1) == 0" ] }, "then": [ { "run_eocs": "PF_AW_raid_wound" } ] },
              { "math": [ "pf_aw_wf = pf_aw_wf * 2" ] }
            ]
          },
          {
            "if": { "math": [ "pf_aw_wf == 1" ] },
            "then": [
              { "copy_var": { "global_val": "pf_aw_hurt_uid" }, "target_var": { "global_val": "pf_aw_dead_uid" } },
              { "copy_var": { "global_val": "pf_aw_hurt_name" }, "target_var": { "global_val": "pf_aw_dead_name" } },
              { "set_string_var": "none", "target_var": { "global_val": "pf_aw_hurt_uid" } },
              { "math": [ "pf_aw_dead_pending = 1" ] },
              {
                "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
                "then": [
                  { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
                  {
                    "set_string_var": "<global_val:pf_aw_dwhen>: raiders from <global_val:pf_cur_name> got in and took <global_val:pf_nb_took> of the stores.  <global_val:pf_aw_dead_name> was killed holding the door.  They buried <global_val:pf_aw_dead_name> behind the place the next morning.",
                    "target_var": { "var_val": "nk" },
                    "parse_tags": true
                  },
                  { "math": [ "pf_aw_news_n = value_or(pf_aw_news_n, 0) + 1" ] }
                ]
              }
            ]
          },
          {
            "if": { "math": [ "pf_aw_wf == 2" ] },
            "then": [
              {
                "if": { "math": [ "value_or(pf_aw_news_n, 0) < 8" ] },
                "then": [
                  { "set_string_var": "pf_aw_news_<global_val:pf_aw_news_n>", "target_var": { "context_val": "nk" }, "parse_tags": true },
                  {
                    "set_string_var": "<global_val:pf_aw_dwhen>: raiders from <global_val:pf_cur_name> got in and took <global_val:pf_nb_took> of the stores.  <global_val:pf_aw_hurt_name> was hurt trying to stop them.",
                    "target_var": { "var_val": "nk" },
                    "parse_tags": true
                  },
