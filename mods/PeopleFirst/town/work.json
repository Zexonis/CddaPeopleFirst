          },
          {
            "if": { "and": [ { "math": [ "pf_hr_n > 0" ] }, { "math": [ "value_or(pf_set_chatter, 1) == 1" ] } ] },
            "then": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "healer_round" } } ]
