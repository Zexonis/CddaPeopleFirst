  },
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_smithy",
    "//": "u = avatar.  Every 3 days the smith (job 8) turns scrap into something useful: nails, a knife, a machete, a crowbar or bolts (real items at home).",
    "effect": [
      { "math": [ "pf_tw_role = 8" ] },
      { "run_eocs": "PF_TOWN_worker" },
      { "math": [ "pf_tw_wjob = pf_tw_wbest >= 100" ] },
      {
        "if": { "math": [ "pf_tw_wjob" ] },
        "then": [
          { "math": [ "pf_smith_t = time('now')" ] },
          { "math": [ "_g = rand(4)" ] },
          {
            "if": { "math": [ "_g == 0" ] },
            "then": [
              { "map_spawn_item": "nail", "loc": { "global_val": "pf_stores_loc" }, "count": 30 },
              { "set_string_var": "a bucket of nails", "target_var": { "global_val": "pf_say_b" } }
            ]
          },
          {
            "if": { "math": [ "_g == 1" ] },
            "then": [
              { "map_spawn_item": "knife_hunting", "loc": { "global_val": "pf_stores_loc" }, "count": 1 },
              { "set_string_var": "a hunting knife, edge like a razor", "target_var": { "global_val": "pf_say_b" } }
            ]
          },
          {
            "if": { "math": [ "_g == 2" ] },
            "then": [
              { "map_spawn_item": "machete", "loc": { "global_val": "pf_stores_loc" }, "count": 1 },
              { "set_string_var": "a machete, rough but true", "target_var": { "global_val": "pf_say_b" } }
            ]
          },
          {
            "if": { "math": [ "_g == 3" ] },
            "then": [
              { "map_spawn_item": "crowbar", "loc": { "global_val": "pf_stores_loc" }, "count": 1 },
              { "set_string_var": "a crowbar out of an old axle", "target_var": { "global_val": "pf_say_b" } }
            ]
          },
          {
            "if": { "math": [ "_g == 4" ] },
            "then": [
              { "map_spawn_item": "bolt_metal", "loc": { "global_val": "pf_stores_loc" }, "count": 10 },
              { "set_string_var": "a bundle of crossbow bolts", "target_var": { "global_val": "pf_say_b" } }
            ]
          },
          { "math": [ "pf_smith_total = value_or(pf_smith_total, 0) + 1" ] },
          {
            "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
            "then": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "smith" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_market",
    "//": "u = avatar.  Market day (every seventh day, when there are other people out there): neighbors come with handcarts, and each 10 of the place's stores becomes something you need (up to 3 goods, real items at home).  A meal shared with everyone who lives here.",
    "effect": [
      { "math": [ "pf_mk_n = 0" ] },
      { "set_string_var": "", "target_var": { "global_val": "pf_mk_list" } },
      { "math": [ "pf_dr_want = 30" ] },
      { "math": [ "pf_dr_div = 3" ] },
      { "run_eocs": "PF_STORES_draw", "alpha_talker": "avatar" },
      {
        "run_eocs": "PF_TOWN_market_buy",
        "condition": { "and": [ { "math": [ "value_or(pf_stores, 0) >= 10" ] }, { "math": [ "pf_mk_n < 3" ] } ] },
        "iterations": 4
      },
      {
        "if": { "math": [ "pf_mk_n > 0" ] },
        "then": [
          { "math": [ "pf_markets_total = value_or(pf_markets_total, 0) + 1" ] },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_TOWN_market_meal",
                "condition": { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                "effect": [ { "math": [ "pf_m_str_in = 25" ] }, { "run_eocs": "PF_MK_meal_shared", "beta_talker": "avatar" } ]
              }
            ],
            "local": true,
            "npc_range": 30
          },
          {
            "if": { "math": [ "value_or(pf_town_named, 0) == 1" ] },
            "then": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "market_named" } } ],
            "else": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "market" } } ]
          }
        ],
        "else": [
          {
            "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
            "then": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "market_none" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_market_buy",
    "effect": [
      { "math": [ "_g = rand(6)" ] },
      {
        "if": { "math": [ "_g == 0" ] },
        "then": [
          { "map_spawn_item": "bandages", "loc": { "global_val": "pf_stores_loc" }, "count": 5 },
          { "set_string_var": "bandages", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 1" ] },
        "then": [
          { "map_spawn_item": "aspirin", "loc": { "global_val": "pf_stores_loc" }, "count": 10 },
          { "set_string_var": "a bottle of aspirin", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 2" ] },
        "then": [
          { "map_spawn_item": "antibiotics", "loc": { "global_val": "pf_stores_loc" }, "count": 2 },
          { "set_string_var": "a few antibiotics", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 3" ] },
        "then": [
          { "map_spawn_item": "salt", "loc": { "global_val": "pf_stores_loc" }, "count": 10 },
          { "set_string_var": "salt", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 4" ] },
        "then": [
          { "map_spawn_item": "soap", "loc": { "global_val": "pf_stores_loc" }, "count": 3 },
          { "set_string_var": "soap", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 5" ] },
        "then": [
          { "map_spawn_item": "candle", "loc": { "global_val": "pf_stores_loc" }, "count": 5 },
          { "set_string_var": "candles", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      {
        "if": { "math": [ "_g == 6" ] },
        "then": [
          { "map_spawn_item": "seed_potato_raw", "loc": { "global_val": "pf_stores_loc" }, "count": 10 },
          { "set_string_var": "seed potatoes", "target_var": { "global_val": "pf_mk_last" } }
        ]
      },
      { "math": [ "pf_stores -= 10" ] },
      { "math": [ "pf_mk_n += 1" ] },
      {
        "if": { "math": [ "pf_mk_n == 1" ] },
        "then": [ { "copy_var": { "global_val": "pf_mk_last" }, "target_var": { "global_val": "pf_mk_list" } } ],
        "else": [
          {
            "set_string_var": "<global_val:pf_mk_list>, <global_val:pf_mk_last>",
            "target_var": { "global_val": "pf_mk_list" },
            "parse_tags": true
          }
        ]
      }
    ]
  }
]
