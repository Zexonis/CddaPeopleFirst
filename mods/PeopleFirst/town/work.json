      {
        "if": { "math": [ "pf_tw_wjob" ] },
        "then": [
          { "math": [ "pf_hr_n = 0" ] },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_TOWN_patient",
                "condition": {
                  "and": [
                    { "math": [ "has_var(u_pf_uid)" ] },
                    {
                      "or": [
                        {
                          "or": [
                            { "u_has_effect": "bite", "bodypart": "torso" },
                            { "u_has_effect": "bite", "bodypart": "head" },
                            { "u_has_effect": "bite", "bodypart": "eyes" },
