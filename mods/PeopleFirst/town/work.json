                "effect": [
                  { "math": [ "pf_hr_n += 1" ] },
                  { "u_lose_effect": [ "bite", "infected", "bleed" ], "target_part": "ALL" },
                  { "math": [ "u_hp('torso') = min(u_hp('torso') + 5, u_hp_max('torso'))" ] }
                ]
              }
            ],
            "local": true,
            "npc_range": 40
          },
          {
            "if": {
