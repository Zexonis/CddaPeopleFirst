[
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_workday",
    "//": "Once a day, 09:00-12:00, when you're home: school, the healer's round, the smithy (every 3 days), and on the seventh day the market (once at least two people live with you: playtest 3 had neighbors turning up for market day at a lone evac shelter).",
    "recurrence": "30 minutes",
    "global": true,
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 9" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 12" ] },
        { "math": [ "value_or(pf_wd_day, -1) != floor(time('now') / time('1 d'))" ] },
        { "math": [ "(value_or(pf_law_rest, 0) == 1) * (floor(time('now') / time('1 d')) % 7 == 2) == 0" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_wd_day = floor(time('now') / time('1 d'))" ] },
      { "u_location_variable": { "global_val": "pf_tw_av" } },
      {
        "if": { "math": [ "distance(pf_tw_av, pf_home_loc) <= 30" ] },
        "then": [
          { "run_eocs": "PF_TOWN_school" },
          { "run_eocs": "PF_TOWN_healer_round" },
          {
            "if": { "math": [ "time('now') - value_or(pf_smith_t, 0) >= time('3 d')" ] },
            "then": [ { "run_eocs": "PF_TOWN_smithy" } ]
          },
          {
            "if": {
              "and": [
                { "math": [ "floor(time('now') / time('1 d')) % 7 == 6" ] },
                { "math": [ "value_or(pf_band_n, 0) > 0" ] },
                { "math": [ "value_or(pf_residents_n, 0) >= 2" ] }
              ]
            },
            "then": [ { "run_eocs": "PF_TOWN_market" } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_school",
    "//": "u = avatar.  Morning school: the teacher (job 10) teaches every child of 4 or more who hasn't learned anything today (the v0.4 teaching moment, quietly), with one line for the whole class.",
    "effect": [
      { "math": [ "pf_tw_role = 10" ] },
      { "run_eocs": "PF_TOWN_worker" },
      { "math": [ "pf_tw_wjob = pf_tw_wbest >= 100" ] },
      {
        "if": { "math": [ "pf_tw_wjob" ] },
        "then": [
          { "math": [ "pf_sc_n = 0" ] },
          { "math": [ "pf_tk_quiet = 1" ] },
          { "copy_var": { "global_val": "pf_say_a" }, "target_var": { "global_val": "pf_sc_who" } },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_TOWN_pupil",
                "condition": {
                  "and": [
                    { "u_has_trait": "PF_CHILD" },
                    { "not": { "u_has_effect": "PF_infant" } },
                    { "math": [ "u_val('age') >= 4" ] },
                    { "math": [ "value_or(u_pf_taught_t, -1) < time('now') - time('1 d')" ] }
                  ]
                },
                "effect": [
                  { "math": [ "pf_sc_n += 1" ] },
                  {
                    "run_eocs": "PF_FAM_teach_do",
                    "alpha_talker": { "global_val": "pf_tw_worker" },
                    "beta_talker": "u"
                  }
                ]
              }
            ],
            "local": true,
            "npc_range": 40
          },
          { "math": [ "pf_tk_quiet = 0" ] },
          {
            "if": { "math": [ "pf_sc_n > 0" ] },
            "then": [
              { "math": [ "_p = rand(2)" ] },
              {
                "if": { "math": [ "_p == 0" ] },
                "then": [
                  {
                    "set_string_var": "<global_val:pf_sc_who> sits the children in a row under the nearest tree and teaches them their letters, with a stick in the dirt.",
                    "target_var": { "global_val": "pf_sc_text" },
                    "parse_tags": true
                  }
                ]
              },
              {
                "if": { "math": [ "_p == 1" ] },
                "then": [
                  {
                    "set_string_var": "<global_val:pf_sc_who> has the kids tying knots until they can do it with their eyes shut.",
                    "target_var": { "global_val": "pf_sc_text" },
                    "parse_tags": true
                  }
                ]
              },
              {
                "if": { "math": [ "_p == 2" ] },
                "then": [
                  {
                    "set_string_var": "<global_val:pf_sc_who> teaches the children how to tell which berries will kill you.  They listen to that one.",
                    "target_var": { "global_val": "pf_sc_text" },
                    "parse_tags": true
                  }
                ]
              },
              { "math": [ "pf_school_total = value_or(pf_school_total, 0) + 1" ] },
              {
                "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_town", "alpha_talker": "avatar", "variables": { "line": "school" } } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_TOWN_healer_round",
