  {
    "type": "effect_on_condition",
    "id": "PF_SOCIAL_on_death",
    "//": "Someone known by name died (u = the dead).  Remembers their name (pf_name_<uid>) for later lines.  Everyone who cared about them, nearby or in their band far away, keeps a memory of losing them.",
    "eoc_type": "EVENT",
    "required_event": "character_dies",
    "condition": { "and": [ "has_alpha", "u_is_npc", { "math": [ "has_var(u_pf_uid)" ] } ] },
    "effect": [
      { "math": [ "pf_grief_before = value_or(pf_grief_total, 0)" ] },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_dead_uid" } },
      { "math": [ "pf_dead_band = value_or(u_pf_band, 0)" ] },
      { "set_string_var": "pf_name_<u_val:pf_uid>", "target_var": { "context_val": "ref" }, "parse_tags": true },
      { "set_string_var": "<u_name>", "target_var": { "var_val": "ref" }, "parse_tags": true },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_dead_name" }, "parse_tags": true },
      { "math": [ "pf_grief_local = 1" ] },
      { "math": [ "pf_grief_shown = 0" ] },
      { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "local": true, "npc_range": 60 },
      { "math": [ "pf_grief_local = 0" ] },
      {
        "if": { "math": [ "value_or(u_pf_is_leader, 0) == 1" ] },
        "then": [
          {
            "if": { "not": { "compare_string": [ { "u_val": "pf_member_0" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "unique_ids": [ { "u_val": "pf_member_0" } ], "local": false } ]
          },
          {
            "if": { "not": { "compare_string": [ { "u_val": "pf_member_1" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "unique_ids": [ { "u_val": "pf_member_1" } ], "local": false } ]
          },
          {
            "if": { "not": { "compare_string": [ { "u_val": "pf_member_2" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "unique_ids": [ { "u_val": "pf_member_2" } ], "local": false } ]
          },
          {
            "if": { "not": { "compare_string": [ { "u_val": "pf_member_3" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "unique_ids": [ { "u_val": "pf_member_3" } ], "local": false } ]
          },
          {
            "if": { "not": { "compare_string": [ { "u_val": "pf_member_4" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_GRIEF_one" ], "unique_ids": [ { "u_val": "pf_member_4" } ], "local": false } ]
          }
        ],
        "else": [
          {
            "if": { "math": [ "has_var(u_pf_leader)" ] },
            "then": [
              {
                "u_run_npc_eocs": [ "PF_GRIEF_one", "PF_GRIEF_leaders_band" ],
                "unique_ids": [ { "u_val": "pf_leader" } ],
                "local": false
              }
            ]
          }
        ]
      },
      { "run_eocs": "PF_HEART_avatar_grief", "alpha_talker": "avatar" },
      {
        "if": { "or": [ { "math": [ "value_or(pf_grief_total, 0) > pf_grief_before" ] }, { "math": [ "pf_av_grieved == 1" ] } ] },
        "then": [
          { "math": [ "pf_unmourned = 1" ] },
          { "math": [ "pf_unburied = 1" ] },
          { "math": [ "pf_unmourned_t = time('now')" ] },
          { "copy_var": { "global_val": "pf_dead_uid" }, "target_var": { "global_val": "pf_unmourned_uid" } },
          { "copy_var": { "global_val": "pf_dead_name" }, "target_var": { "global_val": "pf_unmourned_name" } },
          { "run_eocs": "PF_HEART_event_death" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_GRIEF_leaders_band",
    "//": "u = the dead member's leader.  Their other band members grieve too (wherever they are).",
