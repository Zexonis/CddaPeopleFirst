        "then": [
          { "copy_var": { "global_val": "pf_sb_5" }, "target_var": { "global_val": "pf_m_other" } },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = pf_sb_hunt_str" ] },
          { "run_eocs": "PF_MV_shared_danger" }
        ]
      }
    ]
  },
  {
