  {
    "type": "effect_on_condition",
    "id": "PF_GRIEF_one",
    "//": "u = someone who may have known the dead (pf_dead_uid).  Once per death: if they cared (warmth 10+), they keep a lost_companion memory, stronger the closer they were.  The first close one nearby is seen grieving.",
    "condition": { "not": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_dead_uid" } ] } },
    "effect": [
      { "set_string_var": "u_pf_griev_<global_val:pf_dead_uid>", "target_var": { "context_val": "gref" }, "parse_tags": true },
      {
        "if": { "math": [ "value_or(v_gref, 0) == 0" ] },
