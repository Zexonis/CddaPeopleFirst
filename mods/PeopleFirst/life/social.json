      { "math": [ "pf_rbest = -1" ] },
      { "math": [ "pf_rbest_str = 0" ] },
      { "run_eocs": "PF_GRIEF_scan_i", "condition": { "math": [ "pf_ri < 8" ] }, "iterations": 9 },
      {
        "if": { "math": [ "pf_rbest >= 0" ] },
