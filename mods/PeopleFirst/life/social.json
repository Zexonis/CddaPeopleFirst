[
  {
    "type": "effect_on_condition",
    "id": "PF_SOCIAL_band_evening",
    "//": "u = an off-screen band leader, once a day after 20:00 (called from the A-Life offline step).  The band makes camp: every member's view of every other member gets a fire_evening half moment, or bicker if tension is 25+.  Up to 6 people = 30 view updates, reached one at a time by unique id.  Pure var math: nothing in the world loads.  So a band you meet already has a history.",
    "effect": [
      { "math": [ "u_pf_social_day = floor(time('now') / time('1 d'))" ] },
      { "math": [ "pf_sb_n = 1" ] },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_sb_0" } },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_0" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_0" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_1" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_1" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_2" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_2" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_3" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_3" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_4" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_4" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 1" ] },
        "then": [
          { "math": [ "pf_sb_self = 0" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_0" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 1" ] },
        "then": [
          { "math": [ "pf_sb_self = 1" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_1" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 2" ] },
        "then": [
          { "math": [ "pf_sb_self = 2" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_2" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 3" ] },
        "then": [
          { "math": [ "pf_sb_self = 3" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_3" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 4" ] },
        "then": [
          { "math": [ "pf_sb_self = 4" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_4" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 5" ] },
        "then": [
          { "math": [ "pf_sb_self = 5" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_eve_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_5" } ],
            "local": false
          }
        ]
      },
      { "math": [ "pf_social_evenings_total = value_or(pf_social_evenings_total, 0) + 1" ] },
      { "run_eocs": "PF_ROAD_day" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SOCIAL_band_hunt",
    "//": "u = an off-screen band leader whose band just finished a leg of its hunt (called from PF_ALIFE_next_waypoint while offline).  At most once per 6 hours: short patrols reach waypoints every few minutes, and the natural playtest logged 492 hunts in 95 minutes without this.  Everyone shared the danger: a mild bond (strength 30), and about one hunt in eight was a close call they'll remember (60).",
    "condition": {
      "or": [ { "math": [ "time_since(u_pf_hunt_last) < 0" ] }, { "math": [ "time_since(u_pf_hunt_last) > time('6 h')" ] } ]
    },
    "effect": [
      { "math": [ "u_pf_hunt_last = time('now')" ] },
      { "math": [ "pf_sb_n = 1" ] },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_sb_0" } },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_0" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_0" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_1" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_1" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_2" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_2" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_3" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_3" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_member_4" }, "none" ] } },
        "then": [
          { "set_string_var": "pf_sb_<global_val:pf_sb_n>", "target_var": { "context_val": "ref" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_member_4" }, "target_var": { "var_val": "ref" } },
          { "math": [ "pf_sb_n += 1" ] }
        ]
      },
      { "math": [ "pf_sb_hunt_str = rand(7) == 0 ? 60 : 30" ] },
      {
        "if": { "math": [ "pf_sb_n > 1" ] },
        "then": [
          { "math": [ "pf_sb_self = 0" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_0" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 1" ] },
        "then": [
          { "math": [ "pf_sb_self = 1" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_1" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 2" ] },
        "then": [
          { "math": [ "pf_sb_self = 2" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_2" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 3" ] },
        "then": [
          { "math": [ "pf_sb_self = 3" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_3" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 4" ] },
        "then": [
          { "math": [ "pf_sb_self = 4" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_4" } ],
            "local": false
          }
        ]
      },
      {
        "if": { "math": [ "pf_sb_n > 5" ] },
        "then": [
          { "math": [ "pf_sb_self = 5" ] },
          {
            "u_run_npc_eocs": [ "PF_SOCIAL_hunt_viewer" ],
            "unique_ids": [ { "global_val": "pf_sb_5" } ],
            "local": false
          }
        ]
      },
      { "math": [ "pf_social_hunts_total = value_or(pf_social_hunts_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SOCIAL_hunt_viewer",
    "//": "u = one band member (by unique id).  Their view of each of the others gets shared_danger.",
    "effect": [
      { "run_eocs": "PF_ID_ensure" },
      {
        "if": { "and": [ { "math": [ "pf_sb_n > 0" ] }, { "math": [ "pf_sb_self != 0" ] } ] },
        "then": [
          { "copy_var": { "global_val": "pf_sb_0" }, "target_var": { "global_val": "pf_m_other" } },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = pf_sb_hunt_str" ] },
          { "run_eocs": "PF_MV_shared_danger" }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_sb_n > 1" ] }, { "math": [ "pf_sb_self != 1" ] } ] },
        "then": [
          { "copy_var": { "global_val": "pf_sb_1" }, "target_var": { "global_val": "pf_m_other" } },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = pf_sb_hunt_str" ] },
          { "run_eocs": "PF_MV_shared_danger" }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_sb_n > 2" ] }, { "math": [ "pf_sb_self != 2" ] } ] },
        "then": [
          { "copy_var": { "global_val": "pf_sb_2" }, "target_var": { "global_val": "pf_m_other" } },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = pf_sb_hunt_str" ] },
          { "run_eocs": "PF_MV_shared_danger" }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_sb_n > 3" ] }, { "math": [ "pf_sb_self != 3" ] } ] },
        "then": [
          { "copy_var": { "global_val": "pf_sb_3" }, "target_var": { "global_val": "pf_m_other" } },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = pf_sb_hunt_str" ] },
          { "run_eocs": "PF_MV_shared_danger" }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_sb_n > 4" ] }, { "math": [ "pf_sb_self != 4" ] } ] },
        "then": [
