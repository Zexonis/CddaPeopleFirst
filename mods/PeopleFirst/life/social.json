          },
          { "run_eocs": "PF_VIEW_read" },
          {
            "if": { "math": [ "pf_read_a > pf_sbr_best" ] },
            "then": [ { "math": [ "pf_sbr_best = pf_read_a" ] }, { "math": [ "pf_sbr_bj = 0" ] } ]
