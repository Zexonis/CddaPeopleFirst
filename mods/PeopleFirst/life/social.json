          },
          { "math": [ "v_mr = 1" ] },
          { "math": [ "pf_fire_mourned = 1" ] },
          { "copy_var": { "var_val": "mw" }, "target_var": { "global_val": "pf_tmp_with" } },
          {
            "set_string_var": "pf_name_<global_val:pf_tmp_with>",
            "target_var": { "context_val": "nref" },
            "parse_tags": true
          },
          { "copy_var": { "var_val": "nref" }, "target_var": { "global_val": "pf_say_b" } },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
          { "run_eocs": "PF_SAY", "alpha_talker": "avatar", "variables": { "line": "mourn" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_GRIEF_scan_i",
    "effect": [
      { "set_string_var": "u_pf_mem_<global_val:pf_ri>_kind", "target_var": { "context_val": "mk" }, "parse_tags": true },
      {
        "set_string_var": "u_pf_mem_<global_val:pf_ri>_str",
        "target_var": { "context_val": "ms" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_mem_<global_val:pf_ri>_rc",
        "target_var": { "context_val": "mr" },
        "parse_tags": true
      },
      {
        "if": {
          "and": [
            { "compare_string": [ { "var_val": "mk" }, "lost_companion" ] },
            { "math": [ "value_or(v_ms, 0) > pf_rbest_str" ] },
            { "math": [ "value_or(v_mr, 0) == 0" ] }
          ]
        },
        "then": [ { "math": [ "pf_rbest = pf_ri" ] }, { "math": [ "pf_rbest_str = v_ms" ] } ]
      },
      { "math": [ "pf_ri += 1" ] }
    ]
  }
