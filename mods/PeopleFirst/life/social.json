          { "math": [ "pf_gr_kin = 0" ] },
          {
            "if": {
              "and": [
                { "u_has_trait": "PF_CHILD" },
                {
                  "or": [
                    { "compare_string": [ { "u_val": "pf_mom" }, { "global_val": "pf_dead_uid" } ] },
                    { "compare_string": [ { "u_val": "pf_dad" }, { "global_val": "pf_dead_uid" } ] },
                    { "compare_string": [ { "u_val": "pf_guardian" }, { "global_val": "pf_dead_uid" } ] }
                  ]
                }
              ]
            },
            "then": [ { "math": [ "pf_gr_kin = 1" ] } ]
          },
          { "math": [ "pf_gr_band = (pf_dead_band > 0) * (value_or(u_pf_band, 0) == pf_dead_band)" ] },
          {
            "if": { "math": [ "(pf_read_w >= 10) + pf_gr_kin + pf_gr_band > 0" ] },
            "then": [
              { "math": [ "pf_mv_role = 1" ] },
              { "math": [ "pf_m_str_in = pf_gr_kin == 1 ? 95 : min(95, max(pf_gr_band * 70, 50 + pf_read_w / 2))" ] },
              { "run_eocs": "PF_MV_lost_companion" },
              { "run_eocs": "PF_HEART_grief" },
              { "math": [ "pf_grief_total = value_or(pf_grief_total, 0) + 1" ] },
              {
                "if": {
                  "and": [
                    { "math": [ "pf_grief_local == 1" ] },
                    { "math": [ "pf_grief_shown == 0" ] },
                    { "math": [ "(pf_read_w >= 25) + pf_gr_kin + pf_gr_band > 0" ] },
                    { "not": { "u_has_effect": "PF_infant" } }
                  ]
                },
                "then": [
                  { "math": [ "pf_grief_shown = 1" ] },
                  { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
                  { "run_eocs": "PF_SAY", "alpha_talker": "avatar", "variables": { "line": "grief" } }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_GRIEF_recall_i",
    "effect": [
