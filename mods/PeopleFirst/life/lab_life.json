      { "u_location_variable": { "global_val": "pf_ll_fire" }, "x_adjust": 3 },
      {
        "u_transform_radius": 2,
        "ter_furn_transform": "PF_LL_clear_grass",
        "target_var": { "global_val": "pf_ll_fire" }
      },
      {
        "u_transform_radius": 0,
        "ter_furn_transform": "PF_LL_firering",
        "target_var": { "global_val": "pf_ll_fire" }
      },
      { "map_spawn_item": "log", "loc": { "global_val": "pf_ll_fire" }, "count": 3 },
      {
        "u_set_field": "fd_fire",
        "radius": 0,
        "intensity": 2,
        "age": "0 seconds",
        "hit_player": false,
        "target_var": { "global_val": "pf_ll_fire" }
      },
      { "u_message": "[lab] A campfire crackles to life.", "type": "info" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_gather",
    "effect": [
      { "math": [ "pf_eve_day = floor(time('now') / time('1 d'))" ] },
      { "math": [ "pf_eve_state = 0" ] },
      { "math": [ "pf_eve_done_day = -1" ] },
      { "math": [ "pf_eve_fought = 0" ] },
      {
        "u_location_variable": { "global_val": "pf_fire_loc" },
        "field": "fd_fire",
        "target_max_radius": 15,
        "true_eocs": [ "PF_FIRE_step" ],
        "false_eocs": [ { "id": "PF_LL_nofire", "effect": [ { "u_message": "[lab] No fire within 15 tiles.", "type": "info" } ] } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_step",
    "effect": [
      { "math": [ "pf_eve_seat_t = time('now') - time('20 m')" ] },
      {
        "u_location_variable": { "global_val": "pf_fire_loc" },
        "field": "fd_fire",
        "target_max_radius": 15,
        "true_eocs": [ "PF_FIRE_step" ],
        "false_eocs": [ "PF_LL_nofire" ]
      },
      { "run_eocs": "PF_THREAT_scan" },
      { "u_message": "[lab] Evening state <global_val:pf_eve_state>, threat <global_val:pf_threat>.", "type": "info" }
    ]
  },
