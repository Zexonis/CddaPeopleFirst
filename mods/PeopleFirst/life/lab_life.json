      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_t",
        "target_var": { "context_val": "rt" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_x",
        "target_var": { "context_val": "rx" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_pw",
        "target_var": { "context_val": "rpw" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_pt",
        "target_var": { "context_val": "rpt" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_l",
        "target_var": { "context_val": "rl" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_a",
        "target_var": { "context_val": "ra" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_pa",
        "target_var": { "context_val": "rpa" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_c",
        "target_var": { "context_val": "rc" },
        "parse_tags": true
      },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_f",
        "target_var": { "context_val": "rf" },
        "parse_tags": true
      },
      { "math": [ "v_ra = 65" ] },
      { "math": [ "v_rpa = 65" ] },
      { "math": [ "v_rw = max(v_rw, 40)" ] },
      { "math": [ "v_rpw = max(v_rpw, 40)" ] },
      { "math": [ "u_pf_conf_last = -1" ] },
      { "math": [ "u_pf_awk_until = 0" ] },
      {
        "if": { "math": [ "value_or(u_pf_rom, 0) == 0" ] },
        "then": [ { "math": [ "u_pf_rom = 1" ] }, { "math": [ "u_pf_orient = 2" ] } ]
      },
      {
        "if": { "u_has_trait": "PF_CHILD" },
        "then": [ { "u_message": "[lab] That's a child.  Romance never applies to children.", "type": "info" } ],
        "else": [
          {
            "u_message": "[lab] <u_name> now feels strongly about you (and was made romantic and drawn to everyone, for the test).",
            "type": "info"
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_couple",
    "effect": [
      { "math": [ "pf_ll_cn = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_LL_couple_pick",
            "condition": {
              "and": [
                { "math": [ "pf_ll_cn < 2" ] },
                { "not": { "u_has_trait": "PF_CHILD" } },
                { "math": [ "u_val('age') >= 18" ] },
                { "math": [ "value_or(u_pf_has_sweet, 0) == 0" ] }
              ]
            },
            "effect": [
              { "run_eocs": "PF_ID_ensure" },
              {
                "set_string_var": "pf_ll_c_<global_val:pf_ll_cn>",
                "target_var": { "context_val": "cref" },
                "parse_tags": true
              },
              { "copy_var": { "u_val": "pf_uid" }, "target_var": { "var_val": "cref" } },
              { "math": [ "pf_ll_cn += 1" ] }
            ]
          }
        ],
        "local": true,
        "npc_range": 10
      },
      {
        "if": { "math": [ "pf_ll_cn == 2" ] },
        "then": [
          { "u_run_npc_eocs": [ "PF_LL_couple_set" ], "local": true, "npc_range": 10 },
          { "u_message": "[lab] Two people are falling for each other.", "type": "info" }
        ],
        "else": [ { "u_message": "[lab] Need two adults within 10 tiles.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_couple_set",
    "effect": [
      {
        "if": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_ll_c_0" } ] },
        "then": [
          { "copy_var": { "global_val": "pf_ll_c_1" }, "target_var": { "global_val": "pf_m_other" } },
          { "run_eocs": "PF_LL_couple_view" }
        ]
      },
      {
        "if": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_ll_c_1" } ] },
        "then": [
          { "copy_var": { "global_val": "pf_ll_c_0" }, "target_var": { "global_val": "pf_m_other" } },
          { "run_eocs": "PF_LL_couple_view" }
        ]
      }
    ]
  },
  {
