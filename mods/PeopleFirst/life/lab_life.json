          { "math": [ "u_pf_kill_last = -1" ] },
          { "run_eocs": "PF_COMBAT_kill", "variables": { "lab_victim": "set" } }
        ],
        "else": [ { "u_message": "[lab] Nobody within 5 tiles.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_nearest",
    "effect": [
      { "math": [ "pf_ll_kd = 99" ] },
      { "u_location_variable": { "global_val": "pf_ll_kav" } },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_LL_kill_near",
            "effect": [
              { "u_location_variable": { "u_val": "pf_pos" } },
              {
                "if": { "math": [ "distance(u_pf_pos, pf_ll_kav) < pf_ll_kd" ] },
                "then": [ { "math": [ "pf_ll_kd = distance(u_pf_pos, pf_ll_kav)" ] }, { "u_set_talker": { "global_val": "pf_ll_kwho" } } ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 5
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_hurt_one",
    "effect": [
      { "math": [ "u_hp('torso') = min(u_hp('torso'), u_hp_max('torso') * 0.5)" ] },
      { "math": [ "u_pf_saved_last = -1" ] },
      { "u_location_variable": { "global_val": "pf_ll_vpos" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_kill_one",
    "effect": [ { "math": [ "u_pf_kill_last = -1" ] }, { "run_eocs": "PF_COMBAT_kill", "variables": { "lab_victim": "set" } } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_kill_me",
    "effect": [
      { "math": [ "u_pf_kill_last = -1" ] },
      { "run_eocs": "PF_COMBAT_kill" },
      { "u_message": "[lab] You put the thing down.", "type": "info" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_bandeve",
    "effect": [
      { "math": [ "pf_ll_rep = 0" ] },
      { "run_eocs": "PF_LL_bandeve_all", "condition": { "math": [ "pf_ll_rep < 10" ] }, "iterations": 11 },
      { "u_message": "[lab] <global_val:pf_social_evenings_total> band evenings so far.", "type": "info" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_bandeve_all",
    "effect": [
      { "math": [ "pf_band_i = 0" ] },
      { "run_eocs": "PF_LL_bandeve_one", "condition": { "math": [ "pf_band_i < pf_band_n" ] }, "iterations": 1000 },
      { "math": [ "pf_ll_rep += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_bandeve_one",
    "effect": [
      { "set_string_var": "pf_slot_<global_val:pf_band_i>", "target_var": { "context_val": "ref" }, "parse_tags": true },
      {
        "if": { "not": { "compare_string": [ { "var_val": "ref" }, "none" ] } },
        "then": [ { "u_run_npc_eocs": [ "PF_SOCIAL_band_evening" ], "unique_ids": [ { "var_val": "ref" } ], "local": false } ]
      },
      { "math": [ "pf_band_i += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_grief",
    "effect": [
      { "math": [ "pf_ll_kd = 99" ] },
      { "u_location_variable": { "global_val": "pf_ll_kav" } },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_LL_grief_near",
            "condition": {
              "and": [
                { "u_has_trait": "PF_AGENT" },
                { "not": { "u_has_trait": "PF_CHILD" } },
                { "math": [ "value_or(u_pf_is_leader, 0) == 0" ] },
                { "math": [ "value_or(u_pf_band, 0) > 0" ] },
                { "math": [ "value_or(u_pf_resident, 0) == 0" ] }
              ]
            },
            "effect": [
              { "u_location_variable": { "u_val": "pf_pos" } },
              {
                "if": { "math": [ "distance(u_pf_pos, pf_ll_kav) < pf_ll_kd" ] },
                "then": [ { "math": [ "pf_ll_kd = distance(u_pf_pos, pf_ll_kav)" ] }, { "u_set_talker": { "global_val": "pf_ll_kwho" } } ]
              }
            ]
          }
        ],
        "local": true,
        "npc_range": 10
      },
      {
        "if": { "math": [ "pf_ll_kd < 99" ] },
        "then": [
          { "run_eocs": { "id": "PF_LL_grief_die", "effect": [ "u_die" ] }, "alpha_talker": { "global_val": "pf_ll_kwho" } },
          { "u_message": "[lab] Someone is gone.  Grieving: <global_val:pf_grief_total> so far.", "type": "info" }
        ],
        "else": [ { "u_message": "[lab] No adult band member within 10 tiles.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_fall",
    "effect": [
      { "u_location_variable": { "global_val": "pf_ll_kav" } },
      { "run_eocs": "PF_LL_nearest" },
      {
        "if": { "math": [ "pf_ll_kd < 99" ] },
        "then": [
          { "run_eocs": "PF_LL_fall_one", "alpha_talker": { "global_val": "pf_ll_kwho" } },
          {
            "u_message": "[lab] The nearest adult now feels strongly about you (children are never affected).",
            "type": "info"
          }
        ],
        "else": [ { "u_message": "[lab] Nobody within 5 tiles.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_fall_one",
    "effect": [
      { "run_eocs": "PF_ID_ensure" },
      { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } },
      {
        "set_string_var": "u_pf_v_<global_val:pf_m_other>_w",
        "target_var": { "context_val": "rw" },
