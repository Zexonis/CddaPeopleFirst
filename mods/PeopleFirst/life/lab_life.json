        "else": [ { "u_message": "[lab] Nobody within 5 tiles.", "type": "info" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_save_npc",
    "effect": [
      { "u_location_variable": { "global_val": "pf_ll_kav" } },
      { "run_eocs": "PF_LL_nearest" },
      {
        "if": { "math": [ "pf_ll_kd < 99" ] },
        "then": [
