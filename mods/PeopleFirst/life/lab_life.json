          "v",
          "w",
          "x",
          "y",
          "z"
        ],
        "title": "Life lab (v0.1)",
        "allow_cancel": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_care",
    "effect": [
      { "u_add_effect": "cold", "duration": "30 minutes" },
      { "math": [ "pf_care_last = -1" ] },
      { "run_eocs": "PF_CARE_check" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_LL_fire",
