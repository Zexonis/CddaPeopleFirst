[
  {
    "type": "effect_on_condition",
    "id": "PF_LL_open",
    "effect": [
      {
        "run_eoc_selector": [
          "PF_LL_care",
          "PF_LL_fire",
          "PF_LL_gather",
          "PF_LL_step",
          "PF_LL_sleep",
          "PF_LL_wake",
