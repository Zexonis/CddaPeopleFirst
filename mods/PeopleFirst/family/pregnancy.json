[
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_try_conceive",
    "//": "Alpha and beta = partners spending an evening together (called from the hearts couple check when nothing else happened).  Intimacy is implied, never shown.  A small chance each such evening; only adults, never children, one man and one woman (she 45 or younger), neither already expecting, nobody in mourning, and only if pregnancy is on in Settings.",
    "condition": {
      "and": [
        { "math": [ "value_or(pf_set_preg, 1) == 1" ] },
        { "math": [ "value_or(u_pf_rel_stage, 0) >= 2" ] },
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "not": { "npc_has_trait": "PF_CHILD" } },
        { "math": [ "n_val('age') >= 18" ] },
        { "math": [ "u_gender() != n_gender()" ] },
        { "math": [ "(u_gender() == 0) * u_val('age') + (n_gender() == 0) * n_val('age') <= 45" ] },
        { "math": [ "value_or(u_pf_preg, 0) == 0" ] },
        { "math": [ "value_or(n_pf_preg, 0) == 0" ] },
        { "math": [ "time('now') >= value_or(u_pf_mourn_until, 0)" ] },
        { "math": [ "time('now') >= value_or(n_pf_mourn_until, 0)" ] },
        { "math": [ "rand(99) < value_or(pf_set_preg_chance, 8)" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_fm_u_f = u_gender() == 0" ] },
      {
        "if": { "math": [ "pf_fm_u_f" ] },
        "then": [ { "run_eocs": "PF_FAM_conceive", "beta_talker": "npc" } ],
        "else": [ { "run_eocs": "PF_FAM_conceive", "alpha_talker": "npc", "beta_talker": "u" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_conceive",
    "//": "Alpha = the mother, beta = the father.  Nobody knows yet: morning sickness gives it away later.",
    "effect": [
      { "math": [ "u_pf_preg = 1" ] },
      { "math": [ "u_pf_preg_t = time('now')" ] },
      { "math": [ "u_pf_preg_stage = 0" ] },
      { "math": [ "u_pf_preg_known = 0" ] },
      { "copy_var": { "npc_val": "pf_uid" }, "target_var": { "u_val": "pf_preg_father" } },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_fm_new" } },
      { "run_eocs": "PF_FAM_track_mother" },
      { "math": [ "pf_conceptions_total = value_or(pf_conceptions_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_band_conceive",
    "//": "u = a woman in an off-screen band at camp (by unique id), whose partner camps with her.  The same small chance as at the fire.  Off-screen she moves through her pregnancy by unique id; the birth waits until she's near you.",
    "condition": {
      "and": [
        { "math": [ "value_or(pf_set_preg, 1) == 1" ] },
        { "math": [ "u_gender() == 0" ] },
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "math": [ "u_val('age') <= 45" ] },
        { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
        { "math": [ "value_or(u_pf_rel_stage, 0) >= 2" ] },
        { "math": [ "value_or(u_pf_preg, 0) == 0" ] },
        { "math": [ "time('now') >= value_or(u_pf_mourn_until, 0)" ] },
        { "not": { "compare_string": [ { "u_val": "pf_sweet" }, "AVATAR" ] } },
        { "math": [ "rand(99) < value_or(pf_set_preg_chance, 8)" ] }
      ]
    },
    "effect": [
      { "copy_var": { "u_val": "pf_sweet" }, "target_var": { "global_val": "pf_fm_dad" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_dad>_g",
        "target_var": { "context_val": "dg" },
        "parse_tags": true
      },
      {
        "if": { "math": [ "value_or(v_dg, 0) == 1" ] },
        "then": [
          { "math": [ "u_pf_preg = 1" ] },
          { "math": [ "u_pf_preg_t = time('now')" ] },
          { "math": [ "u_pf_preg_stage = 0" ] },
          { "math": [ "u_pf_preg_known = 0" ] },
          { "copy_var": { "global_val": "pf_fm_dad" }, "target_var": { "u_val": "pf_preg_father" } },
          { "run_eocs": "PF_FAM_track_mother" },
          { "math": [ "pf_conceptions_total = value_or(pf_conceptions_total, 0) + 1" ] },
          { "math": [ "pf_band_conceptions_total = value_or(pf_band_conceptions_total, 0) + 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_track_mother",
    "//": "u = an expecting mother.  Remembered in a small ring so the daily tick can find her (in the bubble by uid, or by unique id).",
    "effect": [
      { "math": [ "pf_fm_i = value_or(pf_moms_n, 0) % 12" ] },
      { "set_string_var": "pf_mom_<global_val:pf_fm_i>", "target_var": { "context_val": "mr" }, "parse_tags": true },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "var_val": "mr" } },
      { "math": [ "pf_moms_n = value_or(pf_moms_n, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_preg_tick",
    "//": "Every 6 hours: every expecting mother moves along (stage, discovery, birth when due).",
    "recurrence": "6 hours",
    "global": true,
    "effect": [
      { "math": [ "pf_fm_k = 0" ] },
      { "math": [ "pf_fm_waiting = 0" ] },
      {
        "run_eocs": "PF_FAM_preg_tick_k",
        "condition": { "math": [ "pf_fm_k < min(value_or(pf_moms_n, 0), 12)" ] },
        "iterations": 13
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_preg_tick_k",
    "effect": [
      { "set_string_var": "pf_mom_<global_val:pf_fm_k>", "target_var": { "context_val": "mr" }, "parse_tags": true },
      { "copy_var": { "var_val": "mr" }, "target_var": { "global_val": "pf_find_uid" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_find_uid>_dead",
        "target_var": { "context_val": "md" },
        "parse_tags": true
      },
      {
        "if": { "math": [ "value_or(v_md, 0) == 1" ] },
        "then": [
          { "set_string_var": "none", "target_var": { "var_val": "mr" } },
          { "set_string_var": "none", "target_var": { "global_val": "pf_find_uid" } }
        ]
      },
      { "math": [ "pf_fm_onscreen = 1" ] },
      {
        "if": { "compare_string": [ { "global_val": "pf_find_uid" }, "none" ] },
        "then": [ { "math": [ "pf_fm_onscreen = -1" ] } ]
      },
      {
        "if": { "compare_string": [ { "global_val": "pf_find_uid" }, "AVATAR" ] },
        "then": [ { "run_eocs": "PF_FAM_preg_step", "alpha_talker": "avatar" } ],
        "else": [
          { "run_eocs": "PF_FIND_by_uid", "alpha_talker": "avatar" },
          {
            "if": { "math": [ "pf_find_ok == 1" ] },
            "then": [ { "run_eocs": "PF_FAM_preg_step", "alpha_talker": { "global_val": "pf_find_who" } } ],
            "else": [
              {
                "run_eocs": {
                  "id": "PF_FAM_preg_offscreen",
                  "condition": { "math": [ "pf_fm_onscreen == 1" ] },
                  "effect": [
                    { "math": [ "pf_fm_onscreen = 0" ] },
                    {
                      "u_run_npc_eocs": [ "PF_FAM_preg_step" ],
                      "unique_ids": [ { "global_val": "pf_find_uid" } ],
                      "local": false
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      { "math": [ "pf_fm_k += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_preg_step",
    "//": "u = an expecting mother (found on-screen this turn, or reached off-screen by unique id with pf_fm_onscreen = 0: then nobody sees the news, and the birth waits until she's near you).  Stage effects (hunger, then carry weight and stamina, then speed and sleep), morning sickness early on, the news at about an eighth of the way, birth at term.",
    "condition": { "math": [ "value_or(u_pf_preg, 0) == 1" ] },
    "effect": [
      {
        "math": [
          "pf_fm_p = (time('now') - u_pf_preg_t) / time('1 d') / (value_or(pf_set_grow, 1) == 0 ? 270 : (value_or(pf_set_grow, 1) == 1 ? 30 : 3))"
        ]
      },
      { "math": [ "pf_fm_st = 1 + (pf_fm_p >= 0.33) + (pf_fm_p >= 0.66)" ] },
      {
        "if": { "math": [ "pf_fm_st != value_or(u_pf_preg_stage, 0)" ] },
        "then": [
          { "u_lose_effect": [ "PF_preg_1", "PF_preg_2", "PF_preg_3" ] },
          {
            "if": { "math": [ "pf_fm_st == 1" ] },
            "then": [ { "u_add_effect": "PF_preg_1", "duration": "PERMANENT" } ]
          },
          {
            "if": { "math": [ "pf_fm_st == 2" ] },
            "then": [ { "u_add_effect": "PF_preg_2", "duration": "PERMANENT" } ]
          },
          {
            "if": { "math": [ "pf_fm_st == 3" ] },
            "then": [ { "u_add_effect": "PF_preg_3", "duration": "PERMANENT" } ]
          },
          { "math": [ "u_pf_preg_stage = pf_fm_st" ] }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_p < 0.33" ] }, { "math": [ "rand(2) == 0" ] } ] },
        "then": [ { "u_add_effect": "nausea", "duration": "20 minutes" } ]
      },
      {
        "if": {
          "and": [
            { "math": [ "value_or(u_pf_preg_known, 0) == 0" ] },
            { "math": [ "pf_fm_p >= 0.12" ] },
            { "math": [ "pf_fm_onscreen == 0" ] }
          ]
        },
        "then": [ { "math": [ "u_pf_preg_known = 1" ] } ]
      },
      {
        "if": { "and": [ { "math": [ "value_or(u_pf_preg_known, 0) == 0" ] }, { "math": [ "pf_fm_p >= 0.12" ] } ] },
        "then": [
          { "math": [ "u_pf_preg_known = 1" ] },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
          { "copy_var": { "u_val": "pf_preg_father" }, "target_var": { "global_val": "pf_fm_dad" } },
          {
            "set_string_var": "pf_name_<global_val:pf_fm_dad>",
            "target_var": { "context_val": "nref" },
            "parse_tags": true
          },
          { "copy_var": { "var_val": "nref" }, "target_var": { "global_val": "pf_say_b" } },
          {
            "if": { "compare_string": [ { "global_val": "pf_fm_dad" }, "AVATAR" ] },
            "then": [ { "set_string_var": "you", "target_var": { "global_val": "pf_say_b" } } ]
          },
          {
            "if": "u_is_avatar",
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "preg_you" } } ],
            "else": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "preg_npc" } } ]
          }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_p >= 1" ] }, { "math": [ "pf_fm_onscreen == 1" ] } ] },
        "then": [ { "run_eocs": "PF_FAM_birth" } ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_p >= 1" ] }, { "math": [ "pf_fm_onscreen == 0" ] } ] },
        "then": [ { "math": [ "pf_fm_waiting += 1" ] } ]
      },
      {
        "if": { "and": [ "u_is_avatar", { "math": [ "pf_fm_st >= 2" ] }, { "math": [ "rand(2) == 0" ] } ] },
        "then": [ { "run_eocs": "PF_FAM_craving" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_craving",
    "//": "u = you, pregnant (stage 2+).  A craving; if the one you're with is around, they find you something sweet (once a day at most).",
    "condition": {
      "and": [
        { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
        {
          "or": [ { "math": [ "time_since(pf_crave_last) < 0" ] }, { "math": [ "time_since(pf_crave_last) > time('1 d')" ] } ]
        }
      ]
    },
    "effect": [
      { "math": [ "pf_crave_last = time('now')" ] },
      { "copy_var": { "u_val": "pf_sweet" }, "target_var": { "global_val": "pf_find_uid" } },
      { "run_eocs": "PF_FIND_by_uid" },
      { "u_location_variable": { "global_val": "pf_fm_avpos" } },
      {
        "if": { "math": [ "pf_find_ok == 1" ] },
        "then": [ { "run_eocs": "PF_FAM_bring_sweet", "alpha_talker": { "global_val": "pf_find_who" }, "beta_talker": "avatar" } ],
        "else": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "crave_alone" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_bring_sweet",
    "//": "Alpha = your partner, beta = you.",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "math": [ "_r = rand(2)" ] },
      {
        "if": { "math": [ "_r == 0" ] },
        "then": [
          { "run_eocs": "PF_GIVE_chocolate", "alpha_talker": "avatar" },
          { "set_string_var": "a bar of chocolate", "target_var": { "global_val": "pf_say_b" } }
        ]
      },
      {
        "if": { "math": [ "_r == 1" ] },
        "then": [
          { "run_eocs": "PF_GIVE_candy", "alpha_talker": "avatar" },
          { "set_string_var": "a handful of hard candy", "target_var": { "global_val": "pf_say_b" } }
        ]
      },
      {
        "if": { "math": [ "_r == 2" ] },
        "then": [
          { "run_eocs": "PF_GIVE_cookies", "alpha_talker": "avatar" },
          { "set_string_var": "a battered pack of cookies", "target_var": { "global_val": "pf_say_b" } }
        ]
      },
      { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "crave_brought" } },
      { "math": [ "pf_m_str_in = 50" ] },
      { "run_eocs": "PF_MK_care_given" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_watch_bonus",
    "//": "u = a would-be watcher.  The partner of an expecting mother (you) takes her watch: +25, returned in pf_fm_watch_add.",
    "effect": [
      { "math": [ "pf_fm_watch_add = 0" ] },
      {
        "if": {
          "and": [ { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] }, { "compare_string": [ { "u_val": "pf_sweet" }, "AVATAR" ] } ]
        },
        "then": [
          {
            "run_eocs": { "id": "PF_FAM_watch_av", "effect": [ { "math": [ "pf_fm_avpreg = value_or(u_pf_preg, 0)" ] } ] },
            "alpha_talker": "avatar"
          },
          { "if": { "math": [ "pf_fm_avpreg == 1" ] }, "then": [ { "math": [ "pf_fm_watch_add = 25" ] } ] }
        ]
      }
    ]
  }
]
