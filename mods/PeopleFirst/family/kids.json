[
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_kid_day_tick",
    "//": "Every 2 hours by day (08:00-19:00), when it's calm: children live their lives: play, small chores, questions, and grief.  At most two lines each time.",
    "recurrence": "2 hours",
    "global": true,
    "condition": {
      "and": [
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 8" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 19" ] }
      ]
    },
    "effect": [
      { "run_eocs": "PF_THREAT_scan" },
      {
        "if": { "math": [ "pf_threat == 0" ] },
        "then": [
          { "math": [ "pf_kl = 0" ] },
          { "u_location_variable": { "global_val": "pf_fm_avpos" } },
          { "math": [ "pf_fm_av_awake = 1" ] },
          {
            "if": { "or": [ { "u_has_effect": "sleep" }, { "u_has_effect": "lying_down" } ] },
            "then": [ { "math": [ "pf_fm_av_awake = 0" ] } ]
          },
          { "u_run_npc_eocs": [ "PF_FAM_kid_moment" ], "local": true, "npc_range": 40 }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_kid_moment",
    "//": "u = a child (walking, not a baby).",
    "condition": {
      "and": [
        { "u_has_trait": "PF_CHILD" },
        { "not": { "u_has_effect": "PF_infant" } },
        { "math": [ "pf_kl < 2" ] },
        { "or": [ { "math": [ "rand(1) == 0" ] }, { "math": [ "value_or(pf_kid_force, 0) == 1" ] } ] }
      ]
    },
    "effect": [
      { "run_eocs": "PF_ID_ensure" },
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_kid_uid" } },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "u_location_variable": { "u_val": "pf_pos" } },
      { "math": [ "pf_kid_avnear = (distance(u_pf_pos, pf_fm_avpos) <= 8) * value_or(pf_fm_av_awake, 1)" ] },
      {
        "if": {
          "and": [
            { "math": [ "time('now') - value_or(pf_loss_t, -999999) < time('2 d')" ] },
            { "math": [ "value_or(u_pf_loss_seen, 0) != value_or(pf_loss_n, 0)" ] }
          ]
        },
        "then": [
          { "math": [ "u_pf_loss_seen = pf_loss_n" ] },
          { "math": [ "pf_kl += 1" ] },
          {
            "if": { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
            "then": [
              {
                "if": { "math": [ "value_or(pf_loss_multi, 0) == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "kid_loss_many" } } ],
                "else": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "kid_loss_one" } } ]
              }
            ]
          }
        ],
        "else": [
          {
            "if": { "math": [ "time('now') < value_or(u_pf_mourn_until, 0)" ] },
            "then": [
              {
                "if": { "math": [ "has_var(u_pf_lost_t) * (rand(1) == 0)" ] },
                "then": [ { "run_eocs": "PF_FAM_kid_grief" } ],
                "else": [ { "run_eocs": "PF_FAM_kid_comfort" } ]
              }
            ],
            "else": [
              { "run_eocs": "PF_FAM_kid_heal" },
              { "math": [ "_a = rand(3)" ] },
              {
                "if": {
                  "and": [
                    { "math": [ "_a == 3" ] },
                    {
                      "or": [ { "math": [ "time_since(u_pf_taught_t) < 0" ] }, { "math": [ "time_since(u_pf_taught_t) > time('1 d')" ] } ]
                    }
                  ]
                },
                "then": [ { "run_eocs": "PF_FAM_kid_learn" } ],
                "else": [ { "if": { "math": [ "_a == 3" ] }, "then": [ { "math": [ "_a = rand(2)" ] } ] } ]
              },
              { "if": { "math": [ "_a == 0" ] }, "then": [ { "run_eocs": "PF_FAM_kid_play" } ] },
              { "if": { "math": [ "_a == 1" ] }, "then": [ { "run_eocs": "PF_FAM_kid_chore" } ] },
              { "if": { "math": [ "_a == 2" ] }, "then": [ { "run_eocs": "PF_FAM_kid_question" } ] }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_kid_learn",
    "//": "u = a child.  They pester a grown-up (you, if you're near) to show them how something works.  Once a day per child.",
    "effect": [
      { "math": [ "pf_kc_found = 0" ] },
      {
        "if": { "math": [ "pf_kid_avnear" ] },
        "then": [ { "math": [ "pf_kc_found = 2" ] } ],
        "else": [ { "u_run_npc_eocs": [ "PF_FAM_kid_helper_of" ], "local": true, "npc_range": 15 } ]
      },
      {
        "if": { "math": [ "pf_kc_found == 2" ] },
        "then": [ { "math": [ "pf_kl += 1" ] }, { "run_eocs": "PF_FAM_teach_do", "alpha_talker": "avatar", "beta_talker": "u" } ]
      },
      {
        "if": { "math": [ "pf_kc_found == 1" ] },
        "then": [
          { "math": [ "pf_kl += 1" ] },
          { "run_eocs": "PF_FAM_teach_do", "alpha_talker": { "global_val": "pf_kc_who" }, "beta_talker": "u" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_kid_play",
    "//": "u = a child.  With another child near, they play together (a small bond); alone, they invent something.  Pools with no back-to-back repeats (variety pass).",
    "effect": [
      { "math": [ "pf_kp_found = 0" ] },
