[
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_baby_tick",
    "//": "Every 4 hours: each baby in the bubble gets looked after by whoever cares most nearby (parents first).",
    "recurrence": "4 hours",
    "global": true,
    "condition": { "math": [ "value_or(pf_kids_n, 0) > 0" ] },
    "effect": [ { "u_run_npc_eocs": [ "PF_FAM_baby_one" ], "local": true, "npc_range": 60 } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_baby_one",
    "//": "u = a baby.",
    "condition": { "and": [ { "math": [ "value_or(u_pf_kid_stage, -1) == 0" ] }, { "u_has_effect": "PF_infant" } ] },
    "effect": [
      { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_fm_baby" } },
      { "copy_var": { "u_val": "pf_mom" }, "target_var": { "global_val": "pf_fm_mom" } },
      { "copy_var": { "u_val": "pf_dad" }, "target_var": { "global_val": "pf_fm_dad" } },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_b" }, "parse_tags": true },
      { "u_location_variable": { "global_val": "pf_fm_babypos" } },
      { "math": [ "pf_fm_best = -1" ] },
      { "u_run_npc_eocs": [ "PF_FAM_carer_cand" ], "local": true, "npc_range": 30 },
      {
        "if": { "math": [ "pf_fm_best >= 0" ] },
        "then": [ { "run_eocs": "PF_FAM_tend_baby", "alpha_talker": { "global_val": "pf_fm_carer" }, "beta_talker": "u" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_carer_cand",
    "//": "u = an adult near the baby.  Parents first (+50), then mother hens (+20), then anyone fond of the baby.",
    "condition": { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
    "effect": [
      { "run_eocs": "PF_ID_ensure" },
      { "copy_var": { "global_val": "pf_fm_baby" }, "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      { "math": [ "_score = pf_read_w + 5" ] },
      {
        "if": {
          "or": [
            { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_fm_mom" } ] },
            { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_fm_dad" } ] }
          ]
        },
        "then": [ { "math": [ "_score += 50" ] } ]
      },
      { "if": { "u_has_trait": "PF_Q_MOTHER_HEN" }, "then": [ { "math": [ "_score += 20" ] } ] },
      {
        "if": { "and": [ { "math": [ "_score > pf_fm_best" ] }, { "math": [ "_score >= 5" ] } ] },
        "then": [ { "math": [ "pf_fm_best = _score" ] }, { "u_set_talker": { "global_val": "pf_fm_carer" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_tend_baby",
    "//": "Alpha = the carer, beta = the baby.  Walks over, settles them (a parenting moment); if it's your baby, they take it so you can rest (care for you too).",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "copy_var": { "global_val": "pf_fm_babypos" }, "target_var": { "u_val": "pf_walk_to" } },
      { "location_variable_adjust": { "u_val": "pf_walk_to" }, "x_adjust": 1 },
      { "u_set_guard_pos": { "u_val": "pf_walk_to" } },
      { "math": [ "pf_m_str_in = 30" ] },
      { "run_eocs": "PF_MK_parenting" },
      {
        "if": {
          "and": [
            { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
            { "math": [ "rand(2) == 0" ] },
            { "math": [ "value_or(pf_baby_line_t, -1) < time('now') - time('3 h')" ] }
          ]
        },
        "then": [
          { "math": [ "pf_baby_line_t = time('now')" ] },
          { "math": [ "_r = rand(2)" ] },
          {
            "if": { "math": [ "_r == 0" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "baby_rock" } } ]
          },
          {
            "if": { "math": [ "_r == 1" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "baby_feed" } } ]
          },
          {
            "if": { "math": [ "_r == 2" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "baby_sing" } } ]
          }
        ]
      },
      {
        "if": {
          "or": [
            { "compare_string": [ { "global_val": "pf_fm_mom" }, "AVATAR" ] },
            { "compare_string": [ { "global_val": "pf_fm_dad" }, "AVATAR" ] }
          ]
        },
        "then": [
          {
            "if": { "not": "u_is_avatar" },
            "then": [
              {
                "if": {
                  "and": [
                    { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
                    { "math": [ "value_or(pf_baby_rest_t, -1) < time('now') - time('12 h')" ] }
                  ]
                },
                "then": [
                  { "math": [ "pf_baby_rest_t = time('now')" ] },
                  { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "baby_for_you" } }
                ]
              },
              { "math": [ "pf_m_str_in = 45" ] },
              { "run_eocs": "PF_MK_care_given", "beta_talker": "avatar" }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_grow_tick",
    "//": "Once a day: every child born or taken in grows (by unique id, wherever they are).",
    "recurrence": "1 day",
    "global": true,
    "condition": { "math": [ "value_or(pf_kids_n, 0) > 0" ] },
    "effect": [
      { "math": [ "pf_fm_k = 0" ] },
      {
        "run_eocs": "PF_FAM_grow_k",
        "condition": { "math": [ "pf_fm_k < min(value_or(pf_kids_n, 0), 30)" ] },
        "iterations": 31
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_repace",
    "//": "u = avatar.  The Growing up pace changed: every child keeps their age and every mother her progress.",
    "effect": [
      { "math": [ "pf_fm_k = 0" ] },
      {
        "run_eocs": "PF_FAM_repace_k",
        "condition": { "math": [ "pf_fm_k < min(value_or(pf_kids_n, 0), 30)" ] },
        "iterations": 31
      },
      { "math": [ "pf_fm_k = 0" ] },
      {
        "run_eocs": "PF_FAM_repace_m",
        "condition": { "math": [ "pf_fm_k < min(value_or(pf_moms_n, 0), 12)" ] },
        "iterations": 13
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_repace_k",
    "effect": [
      { "set_string_var": "pf_kid_<global_val:pf_fm_k>", "target_var": { "context_val": "kr" }, "parse_tags": true },
      {
        "if": { "not": { "compare_string": [ { "var_val": "kr" }, "none" ] } },
        "then": [
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_FAM_repace_kid",
                "condition": { "math": [ "has_var(u_pf_born_t)" ] },
                "effect": [
                  {
                    "math": [
                      "u_pf_born_t = time('now') - (time('now') - u_pf_born_t) * pf_pace_old / (value_or(pf_set_grow, 1) == 0 ? 1 : (value_or(pf_set_grow, 1) == 1 ? 12 : 120))"
                    ]
                  }
                ]
              }
            ],
            "unique_ids": [ { "var_val": "kr" } ],
            "local": false
          }
        ]
      },
      { "math": [ "pf_fm_k += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_repace_m",
    "effect": [
      { "set_string_var": "pf_mom_<global_val:pf_fm_k>", "target_var": { "context_val": "mr" }, "parse_tags": true },
      {
        "if": { "compare_string": [ { "var_val": "mr" }, "AVATAR" ] },
        "then": [ { "run_eocs": "PF_FAM_repace_mom", "alpha_talker": "avatar" } ],
        "else": [
          {
            "if": { "not": { "compare_string": [ { "var_val": "mr" }, "none" ] } },
            "then": [ { "u_run_npc_eocs": [ "PF_FAM_repace_mom" ], "unique_ids": [ { "var_val": "mr" } ], "local": false } ]
          }
        ]
      },
      { "math": [ "pf_fm_k += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_repace_mom",
    "//": "u = an expecting mother: the same share of the term done, at the new pace.",
    "condition": { "math": [ "has_var(u_pf_preg_t)" ] },
    "effect": [
      {
        "math": [
          "u_pf_preg_t = time('now') - (time('now') - u_pf_preg_t) * (value_or(pf_set_grow, 1) == 0 ? 270 : (value_or(pf_set_grow, 1) == 1 ? 30 : 3)) / pf_term_old"
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_grow_k",
    "effect": [
      { "set_string_var": "pf_kid_<global_val:pf_fm_k>", "target_var": { "context_val": "kr" }, "parse_tags": true },
      { "copy_var": { "var_val": "kr" }, "target_var": { "global_val": "pf_fm_kuid" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_kuid>_dead",
        "target_var": { "context_val": "kd" },
        "parse_tags": true
      },
      {
        "if": { "math": [ "value_or(v_kd, 0) == 1" ] },
        "then": [ { "set_string_var": "none", "target_var": { "var_val": "kr" } } ]
      },
      {
        "if": { "not": { "compare_string": [ { "var_val": "kr" }, "none" ] } },
        "then": [ { "u_run_npc_eocs": [ "PF_FAM_grow" ], "unique_ids": [ { "var_val": "kr" } ], "local": false } ]
      },
      { "math": [ "pf_fm_k += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_grow",
    "//": "u = a child (by unique id).  Age in years follows the growth pace; babies start walking at 2 and follow their family; from 2 to 5 they're toddlers (slow, carried when they tire, a hand to hold); at 18 they grow up.",
    "condition": { "math": [ "has_var(u_pf_born_t)" ] },
    "effect": [
      {
        "math": [
          "pf_fm_age = (time('now') - u_pf_born_t) / time('1 d') * (value_or(pf_set_grow, 1) == 0 ? 1 : (value_or(pf_set_grow, 1) == 1 ? 12 : 120)) / 364"
        ]
      },
      { "math": [ "pf_fm_stage = (pf_fm_age >= 2) + (pf_fm_age >= 18)" ] },
      {
        "if": { "math": [ "u_val('age') != min(floor(pf_fm_age), 18)" ] },
        "then": [ { "math": [ "u_val('age') = min(floor(pf_fm_age), 18)" ] } ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_stage >= 1" ] }, { "math": [ "u_pf_kid_stage == 0" ] } ] },
        "then": [
          { "math": [ "u_pf_kid_stage = 1" ] },
          { "math": [ "u_pf_follow = 1" ] },
          { "u_lose_effect": "PF_infant" },
          { "set_string_var": "none", "target_var": { "u_val": "pf_carrier" } },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
          { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "first_steps" } }
        ]
      },
      {
        "if": {
          "and": [ { "math": [ "u_pf_kid_stage == 1" ] }, { "math": [ "pf_fm_age < 5" ] }, { "not": { "u_has_effect": "PF_toddler" } } ]
        },
        "then": [ { "u_add_effect": "PF_toddler", "duration": "PERMANENT" } ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_age >= 5" ] }, { "u_has_effect": "PF_toddler" } ] },
        "then": [
          { "u_lose_effect": "PF_toddler" },
          {
            "if": { "math": [ "value_or(u_pf_follow, 0) == 2" ] },
            "then": [ { "math": [ "u_pf_follow = 1" ] }, { "set_string_var": "none", "target_var": { "u_val": "pf_carrier" } } ]
          },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
          { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "big_kid" } }
        ]
      },
      {
        "if": { "and": [ { "math": [ "pf_fm_stage >= 2" ] }, { "math": [ "u_pf_kid_stage == 1" ] } ] },
        "then": [ { "run_eocs": "PF_FAM_grown_up" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_grown_up",
    "//": "u = a child turning 18.  No longer a child: the PF_CHILD and tiny-body traits go, they inherit a temperament from one parent and a quirk from one parent (or, one time in five, their own), and only now do they get a romantic nature.",
    "effect": [
      { "math": [ "u_pf_kid_stage = 2" ] },
      { "math": [ "u_pf_follow = 0" ] },
      { "math": [ "u_pf_needs_home = 0" ] },
      { "u_lose_trait": "PF_CHILD" },
      { "u_lose_trait": "SMALL2" },
      { "copy_var": { "u_val": "pf_mom" }, "target_var": { "global_val": "pf_fm_mom" } },
      { "copy_var": { "u_val": "pf_dad" }, "target_var": { "global_val": "pf_fm_dad" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_mom>_tm",
        "target_var": { "context_val": "tm1" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_dad>_tm",
        "target_var": { "context_val": "tm2" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_mom>_q",
        "target_var": { "context_val": "q1" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_fm_dad>_q",
        "target_var": { "context_val": "q2" },
        "parse_tags": true
      },
      { "u_lose_trait": "PF_T_SOCIABLE" },
      { "u_lose_trait": "PF_T_LONER" },
      { "math": [ "_tm = rand(1) == 0 ? value_or(v_tm1, 0) : value_or(v_tm2, 0)" ] },
      { "if": { "math": [ "_tm == 1" ] }, "then": [ { "u_add_trait": "PF_T_SOCIABLE" } ] },
      { "if": { "math": [ "_tm == 2" ] }, "then": [ { "u_add_trait": "PF_T_LONER" } ] },
      { "math": [ "_q = rand(4) == 0 ? rand(7) : (rand(1) == 0 ? value_or(v_q1, -1) : value_or(v_q2, -1))" ] },
      {
        "if": { "math": [ "_q >= 0" ] },
        "then": [
          { "u_lose_trait": "PF_Q_LOYAL" },
          { "u_lose_trait": "PF_Q_HATES_WASTE" },
          { "u_lose_trait": "PF_Q_MOTHER_HEN" },
          { "u_lose_trait": "PF_Q_GALLOWS" },
          { "u_lose_trait": "PF_Q_PROUD" },
          { "u_lose_trait": "PF_Q_GRUDGE" },
          { "u_lose_trait": "PF_Q_FORGIVING" },
          { "u_lose_trait": "PF_Q_ROMANTIC" },
          {
            "switch": { "math": [ "_q" ] },
            "cases": [
              { "case": 0, "effect": { "u_add_trait": "PF_Q_LOYAL" } },
              { "case": 1, "effect": { "u_add_trait": "PF_Q_HATES_WASTE" } },
              { "case": 2, "effect": { "u_add_trait": "PF_Q_MOTHER_HEN" } },
              { "case": 3, "effect": { "u_add_trait": "PF_Q_GALLOWS" } },
              { "case": 4, "effect": { "u_add_trait": "PF_Q_PROUD" } },
              { "case": 5, "effect": { "u_add_trait": "PF_Q_GRUDGE" } },
              { "case": 6, "effect": { "u_add_trait": "PF_Q_FORGIVING" } },
              { "case": 7, "effect": { "u_add_trait": "PF_Q_ROMANTIC" } }
            ]
          }
        ]
      },
      { "math": [ "u_pf_rom_rolled = 0" ] },
      { "run_eocs": "PF_ROM_roll" },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "math": [ "pf_gu_rot = (value_or(pf_gu_rot, -1) + 1) % 3" ] },
      { "math": [ "_g = pf_gu_rot" ] },
      {
        "if": {
          "or": [
            { "compare_string": [ { "u_val": "pf_guardian" }, "AVATAR" ] },
            { "compare_string": [ { "u_val": "pf_mom" }, "AVATAR" ] },
            { "compare_string": [ { "u_val": "pf_dad" }, "AVATAR" ] }
          ]
        },
        "then": [
          {
            "if": { "math": [ "_g == 0" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up_yours_0" } } ]
          },
          {
            "if": { "math": [ "_g == 1" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up_yours_1" } } ]
          },
          {
            "if": { "math": [ "_g == 2" ] },
            "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up_yours_2" } } ]
          }
        ],
        "else": [
          {
            "if": { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
            "then": [
              {
                "if": { "math": [ "_g == 0" ] },
                "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up" } } ]
              },
              {
                "if": { "math": [ "_g == 1" ] },
                "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up_1" } } ]
              },
              {
                "if": { "math": [ "_g == 2" ] },
                "then": [ { "run_eocs": "PF_SAY_family", "alpha_talker": "avatar", "variables": { "line": "grown_up_2" } } ]
              }
            ]
          }
        ]
      },
      { "math": [ "pf_grownup_total = value_or(pf_grownup_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_follow_tick",
    "//": "Every 5 minutes: children in the bubble stay near their family (guardian, else mother, else father).  On-screen only; a walk order, like everything else that moves people.",
    "recurrence": "5 minutes",
    "global": true,
    "condition": { "math": [ "value_or(pf_kids_n, 0) + value_or(pf_adoptions_total, 0) > 0" ] },
    "effect": [
      { "u_run_npc_eocs": [ "PF_FAM_follow_one", "PF_FAM_carry_one" ], "local": true, "npc_range": 60 },
      { "run_eocs": "PF_FAM_partner_helps", "alpha_talker": "avatar" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_carry_quick",
    "//": "Every 30 seconds while you carry a baby: it stays in your arms however fast you walk.",
    "recurrence": "30 seconds",
    "global": true,
    "condition": { "u_has_effect": "PF_carrying_baby" },
    "effect": [
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_FAM_carry_quick_one",
            "condition": { "compare_string": [ { "u_val": "pf_carrier" }, "AVATAR" ] },
            "effect": [ { "run_eocs": "PF_FAM_carry_one" } ]
          }
        ],
        "local": true,
        "npc_range": 60
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_FAM_carry_one",
    "//": "u = a baby being carried (u_pf_follow == 2).  Wherever the carrier goes, the baby is with them (an in-bubble move, cheap).  Carrying one yourself costs 4 kg of carry weight.  The baby lands on the carrier's side facing where it was, i.e. behind someone walking away: a fixed side (it was always east) puts it in the path, and walking into a neutral NPC attacks them (found 2026-10-11: you swung at the baby you were carrying, and it turned hostile).  An NPC carrier keeps the baby 2 tiles behind and only within 4: right beside them, the carrier shoved the baby every turn (vanilla move_away_from) and barked 'let me pass' every second.",
    "condition": {
      "and": [
        { "or": [ { "u_has_effect": "PF_infant" }, { "u_has_effect": "PF_toddler" } ] },
        { "math": [ "value_or(u_pf_follow, 0) == 2" ] }
      ]
    },
    "effect": [
      { "set_string_var": "pf_reg_<u_val:pf_carrier>_dead", "target_var": { "context_val": "cd" }, "parse_tags": true },
      {
        "if": {
          "and": [
            { "math": [ "value_or(v_cd, 0) == 1" ] },
            { "math": [ "has_var(u_pf_guardian)" ] },
            { "not": { "compare_string": [ { "u_val": "pf_guardian" }, "none" ] } },
            { "not": { "compare_string": [ { "u_val": "pf_guardian" }, { "u_val": "pf_carrier" } ] } }
          ]
        },
        "then": [ { "copy_var": { "u_val": "pf_guardian" }, "target_var": { "u_val": "pf_carrier" } } ]
      },
      { "copy_var": { "u_val": "pf_carrier" }, "target_var": { "global_val": "pf_find_uid" } },
      { "u_location_variable": { "u_val": "pf_pos" } },
