[
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_band_viewer",
    "//": "u = an off-screen band member in a relationship, at camp.  The same rules as at the fire, without the lines: couples break up, become partners, propose and marry while you're away.",
    "condition": {
      "and": [
        { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
        { "not": { "compare_string": [ { "u_val": "pf_sweet" }, "AVATAR" ] } }
      ]
    },
    "effect": [
      { "copy_var": { "u_val": "pf_sweet" }, "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      { "math": [ "pf_ht_st = value_or(u_pf_rel_stage, 1)" ] },
      {
        "if": {
          "and": [
            { "math": [ "value_or(pf_set_jealousy, 1) == 1" ] },
            {
              "or": [
                { "math": [ "pf_read_x >= 35 + 15 * pf_ht_st" ] },
                { "math": [ "pf_read_a < 25 - 5 * pf_ht_st" ] },
                { "math": [ "pf_read_w < 10" ] }
              ]
            }
          ]
        },
        "then": [
          { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_bh_from" } },
          { "u_run_npc_eocs": [ "PF_HEART_band_dumped" ], "unique_ids": [ { "u_val": "pf_sweet" } ], "local": false },
          { "copy_var": { "u_val": "pf_sweet" }, "target_var": { "u_val": "pf_ex" } },
          { "math": [ "u_pf_has_sweet = 0" ] },
          { "math": [ "u_pf_rel_stage = 0" ] },
          { "set_string_var": "none", "target_var": { "u_val": "pf_sweet" } },
          { "math": [ "u_pf_awk_until = time('now') + time('5 d')" ] },
          { "math": [ "pf_mv_role = 2" ] },
          { "run_eocs": "PF_MV_breakup" },
          { "math": [ "pf_breakups_total = value_or(pf_breakups_total, 0) + 1" ] }
        ],
        "else": [
          {
            "if": {
              "and": [
                { "math": [ "pf_ht_st == 1" ] },
                { "math": [ "time_since(u_pf_sweet_since) >= time('7 d')" ] },
                { "math": [ "pf_read_w >= 45" ] },
                { "math": [ "pf_read_a >= 45" ] }
              ]
            },
            "then": [
              { "math": [ "u_pf_rel_stage = 2" ] },
              { "math": [ "u_pf_stage_since = time('now')" ] },
              {
                "u_run_npc_eocs": [ "PF_HEART_band_stage" ],
                "unique_ids": [ { "u_val": "pf_sweet" } ],
                "local": false
              }
            ]
          },
          {
            "if": {
              "and": [
                { "math": [ "pf_ht_st == 2" ] },
                { "math": [ "time_since(value_or(u_pf_stage_since, 0)) >= time('14 d')" ] },
                { "math": [ "pf_read_w >= 65" ] },
                { "math": [ "pf_read_t >= 55" ] },
                { "math": [ "pf_read_a >= 55" ] },
                { "math": [ "value_or(u_pf_commit, 1) != 3" ] },
                {
                  "or": [ { "math": [ "time_since(u_pf_prop_last) < 0" ] }, { "math": [ "time_since(u_pf_prop_last) > time('14 d')" ] } ]
                }
              ]
            },
            "then": [
              { "math": [ "u_pf_prop_last = time('now')" ] },
              { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_bh_from" } },
              { "math": [ "pf_bh_yes = 0" ] },
              {
                "u_run_npc_eocs": [ "PF_HEART_band_answer" ],
                "unique_ids": [ { "u_val": "pf_sweet" } ],
                "local": false
              },
              {
                "if": { "math": [ "pf_bh_yes == 1" ] },
                "then": [
                  { "math": [ "u_pf_rel_stage = 3" ] },
                  { "math": [ "u_pf_stage_since = time('now')" ] },
                  { "math": [ "pf_mv_role = 2" ] },
                  { "math": [ "pf_m_str_in = 85" ] },
                  { "run_eocs": "PF_MV_wedding" },
                  { "math": [ "pf_weddings_total = value_or(pf_weddings_total, 0) + 1" ] }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_band_dumped",
    "//": "u = the one who was left (by unique id).",
    "effect": [
      { "copy_var": { "global_val": "pf_bh_from" }, "target_var": { "u_val": "pf_ex" } },
      { "math": [ "u_pf_has_sweet = 0" ] },
      { "math": [ "u_pf_rel_stage = 0" ] },
      { "set_string_var": "none", "target_var": { "u_val": "pf_sweet" } },
      { "math": [ "u_pf_awk_until = time('now') + time('5 d')" ] },
      { "copy_var": { "global_val": "pf_bh_from" }, "target_var": { "global_val": "pf_m_other" } },
      { "math": [ "pf_mv_role = 1" ] },
      { "run_eocs": "PF_MV_breakup" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_band_stage",
    "effect": [ { "math": [ "u_pf_rel_stage = 2" ] }, { "math": [ "u_pf_stage_since = time('now')" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_band_answer",
    "//": "u = the one proposed to, off-screen.",
    "effect": [
      { "copy_var": { "global_val": "pf_bh_from" }, "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      {
        "math": [ "pf_bh_yes = (pf_read_w >= 60) * (pf_read_a >= 50) * (pf_read_t >= 50) * (value_or(u_pf_commit, 1) != 3)" ]
      },
      {
        "if": { "math": [ "pf_bh_yes == 1" ] },
        "then": [
          { "math": [ "u_pf_rel_stage = 3" ] },
          { "math": [ "u_pf_stage_since = time('now')" ] },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = 85" ] },
          { "run_eocs": "PF_MV_wedding" }
        ],
        "else": [ { "math": [ "pf_mv_role = 2" ] }, { "run_eocs": "PF_MV_proposal_declined" } ]
      }
    ]
  }
]
