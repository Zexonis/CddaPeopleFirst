[
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_grief",
    "//": "u = someone who lost a person they cared about (called from PF_GRIEF_one, view of the dead in pf_read_*).  A partner mourns 7 days (a spouse 14) and is widowed; close friends (warmth 40+) mourn 3 days.  Mourners sit apart at the fire and are left out of romance.",
    "effect": [
      { "set_string_var": "pf_reg_<global_val:pf_dead_uid>_p1", "target_var": { "context_val": "cl_p1" }, "parse_tags": true },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_p2",
        "target_var": { "context_val": "cl_p2" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_gd",
        "target_var": { "context_val": "cl_gd" },
        "parse_tags": true
      },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_p1" } },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_p2" } },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_gd" } },
      { "copy_var": { "var_val": "cl_p1" }, "target_var": { "global_val": "pf_cl_p1" } },
      { "copy_var": { "var_val": "cl_p2" }, "target_var": { "global_val": "pf_cl_p2" } },
      { "copy_var": { "var_val": "cl_gd" }, "target_var": { "global_val": "pf_cl_gd" } },
      { "run_eocs": "PF_HEART_child_loss" },
      {
        "if": {
          "and": [
            { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
            { "compare_string": [ { "u_val": "pf_sweet" }, { "global_val": "pf_dead_uid" } ] }
          ]
        },
        "then": [
          { "math": [ "u_pf_mourn_until = time('now') + (value_or(u_pf_rel_stage, 1) >= 3 ? time('14 d') : time('7 d'))" ] },
          { "math": [ "u_pf_has_sweet = 0" ] },
          { "math": [ "u_pf_rel_stage = 0" ] },
          { "math": [ "u_pf_widowed = 1" ] },
          { "copy_var": { "global_val": "pf_dead_uid" }, "target_var": { "u_val": "pf_late_sweet" } },
          { "set_string_var": "none", "target_var": { "u_val": "pf_sweet" } },
          {
            "u_add_morale": "PF_morale_grief",
            "bonus": -25,
            "max_bonus": -40,
            "duration": "7 d",
            "decay_start": "2 d"
          },
          { "math": [ "pf_widowed_total = value_or(pf_widowed_total, 0) + 1" ] }
        ],
        "else": [
          {
            "if": { "math": [ "pf_read_w >= 40" ] },
            "then": [
              { "math": [ "u_pf_mourn_until = max(value_or(u_pf_mourn_until, 0), time('now') + time('3 d'))" ] },
              {
                "u_add_morale": "PF_morale_grief",
                "bonus": -10,
                "max_bonus": -20,
                "duration": "3 d",
                "decay_start": "1 d"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_child_loss",
    "//": "u = someone whose child (or a child they took in) just died: the heaviest grief there is (21 days of mourning).",
    "condition": {
      "or": [
        { "compare_string": [ { "global_val": "pf_cl_p1" }, { "u_val": "pf_uid" } ] },
        { "compare_string": [ { "global_val": "pf_cl_p2" }, { "u_val": "pf_uid" } ] },
        { "compare_string": [ { "global_val": "pf_cl_gd" }, { "u_val": "pf_uid" } ] }
      ]
    },
    "effect": [
      { "math": [ "u_pf_mourn_until = max(value_or(u_pf_mourn_until, 0), time('now') + time('21 d'))" ] },
      {
        "u_add_morale": "PF_morale_childloss",
        "bonus": -40,
        "max_bonus": -60,
        "duration": "14 d",
        "decay_start": "4 d"
      },
      {
        "if": "u_is_avatar",
        "then": [
          {
            "u_message": "<global_val:pf_dead_name> is dead.\n\nYou can't stop shaking.  Someone sits with you, and doesn't try to say anything.",
            "type": "bad",
            "popup": true
          }
        ]
      },
      { "math": [ "pf_childloss_total = value_or(pf_childloss_total, 0) + 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_avatar_grief",
    "//": "u = you, when someone dies.  If you cared about them you remember losing them (it goes in your journal); losing your partner hurts for a week.",
    "effect": [
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_dead",
        "target_var": { "context_val": "dref" },
        "parse_tags": true
      },
      { "math": [ "v_dref = 1" ] },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_dead_t",
        "target_var": { "context_val": "dreft" },
        "parse_tags": true
      },
      { "math": [ "v_dreft = time('now')" ] },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_p1",
        "target_var": { "context_val": "cl_p1" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_p2",
        "target_var": { "context_val": "cl_p2" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_dead_uid>_gd",
        "target_var": { "context_val": "cl_gd" },
        "parse_tags": true
      },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_p1" } },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_p2" } },
      { "set_string_var": "-", "target_var": { "global_val": "pf_cl_gd" } },
      { "copy_var": { "var_val": "cl_p1" }, "target_var": { "global_val": "pf_cl_p1" } },
      { "copy_var": { "var_val": "cl_p2" }, "target_var": { "global_val": "pf_cl_p2" } },
      { "copy_var": { "var_val": "cl_gd" }, "target_var": { "global_val": "pf_cl_gd" } },
      { "run_eocs": "PF_HEART_child_loss" },
      { "copy_var": { "global_val": "pf_dead_uid" }, "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      { "math": [ "pf_av_grieved = 0" ] },
      {
        "if": {
          "and": [
            { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
            { "compare_string": [ { "u_val": "pf_sweet" }, { "global_val": "pf_dead_uid" } ] }
          ]
        },
        "then": [
          { "math": [ "pf_av_grieved = 1" ] },
          { "math": [ "u_pf_has_sweet = 0" ] },
          { "math": [ "u_pf_rel_stage = 0" ] },
          { "copy_var": { "global_val": "pf_dead_uid" }, "target_var": { "u_val": "pf_late_sweet" } },
          { "set_string_var": "none", "target_var": { "u_val": "pf_sweet" } },
          {
            "u_add_morale": "PF_morale_grief",
            "bonus": -30,
            "max_bonus": -50,
            "duration": "7 d",
            "decay_start": "2 d"
          },
          { "math": [ "pf_mv_role = 1" ] },
          { "math": [ "pf_m_str_in = 95" ] },
          { "run_eocs": "PF_MV_lost_companion" },
          {
            "u_message": "<global_val:pf_dead_name> is dead.\n\nSomething in you goes very quiet.",
            "type": "bad",
            "popup": true
          }
        ],
        "else": [
          {
            "if": { "math": [ "pf_read_w >= 10" ] },
            "then": [
              { "math": [ "pf_av_grieved = 1" ] },
              { "math": [ "pf_mv_role = 1" ] },
              { "math": [ "pf_m_str_in = min(95, 50 + pf_read_w / 2)" ] },
              { "run_eocs": "PF_MV_lost_companion" },
              {
                "if": { "math": [ "pf_read_w >= 50" ] },
                "then": [ { "u_add_morale": "PF_morale_grief", "bonus": -10, "max_bonus": -20, "duration": "2 d", "decay_start": "1 d" } ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_service",
    "//": "u = you.  The first calm evening after a death the fire is for them: everyone's moments tonight are shared mourning (funeral) instead of an ordinary evening, and nobody tells road-trip stories.",
    "condition": {
      "and": [
        { "math": [ "value_or(pf_unmourned, 0) == 1" ] },
        { "math": [ "time_since(value_or(pf_unmourned_t, 0)) < time('14 d')" ] },
        { "math": [ "pf_fire_n > 0" ] }
      ]
    },
    "effect": [
      { "math": [ "pf_fire_service = 1" ] },
      { "math": [ "pf_unmourned = 0" ] },
      { "copy_var": { "global_val": "pf_unmourned_name" }, "target_var": { "global_val": "pf_say_b" } },
      { "run_eocs": "PF_SAY_heart", "alpha_talker": "avatar", "variables": { "line": "service" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_burial_signal",
    "//": "Bottom-up: you finished building something and a fresh grave is right here, within two weeks of a death someone cared about.  That was a burial.",
    "eoc_type": "EVENT",
    "required_event": "character_finished_activity",
    "condition": {
      "and": [
        "u_is_avatar",
        { "compare_string": [ { "context_val": "activity" }, "ACT_BUILD" ] },
        { "math": [ "value_or(pf_unburied, 0) == 1" ] },
        { "math": [ "time_since(value_or(pf_unmourned_t, 0)) < time('14 d')" ] }
      ]
    },
    "effect": [
      {
        "u_location_variable": { "global_val": "pf_bur_at" },
        "terrain": "t_grave_new",
        "target_max_radius": 3,
        "true_eocs": [ "PF_HEART_burial" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_burial",
    "//": "u = you.  Everyone nearby who cared about the dead comes to the graveside: a shared funeral moment with you, and a day less of mourning.",
    "effect": [
      { "math": [ "pf_unburied = 0" ] },
      { "math": [ "pf_bur_n = 0" ] },
      { "copy_var": { "global_val": "pf_unmourned_name" }, "target_var": { "global_val": "pf_say_b" } },
      { "u_run_npc_eocs": [ "PF_HEART_burial_one" ], "local": true, "npc_range": 40 },
      {
        "if": { "math": [ "pf_bur_n == 0" ] },
        "then": [ { "run_eocs": "PF_SAY_heart", "alpha_talker": "avatar", "variables": { "line": "burial_alone" } } ]
      },
      {
        "if": { "math": [ "pf_bur_n == 1" ] },
        "then": [ { "run_eocs": "PF_SAY_heart", "alpha_talker": "avatar", "variables": { "line": "burial_with" } } ]
      },
      {
        "if": { "math": [ "pf_bur_n == 2" ] },
        "then": [ { "run_eocs": "PF_SAY_heart", "alpha_talker": "avatar", "variables": { "line": "burial_two" } } ]
      },
      {
        "if": { "math": [ "pf_bur_n >= 3" ] },
        "then": [ { "run_eocs": "PF_SAY_heart", "alpha_talker": "avatar", "variables": { "line": "burial_many" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HEART_burial_one",
    "condition": { "not": { "u_has_trait": "PF_CHILD" } },
    "effect": [
      { "copy_var": { "global_val": "pf_unmourned_uid" }, "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      {
        "if": { "math": [ "pf_read_w >= 10" ] },
        "then": [
          {
            "if": { "math": [ "pf_bur_n == 0" ] },
            "then": [ { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true } ]
          },
          {
            "if": { "math": [ "pf_bur_n == 1" ] },
            "then": [ { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_bur_n2" }, "parse_tags": true } ]
          },
          { "math": [ "pf_bur_n += 1" ] },
          { "copy_var": { "global_val": "pf_bur_at" }, "target_var": { "u_val": "pf_walk_to" } },
          {
            "location_variable_adjust": { "u_val": "pf_walk_to" },
            "x_adjust": { "math": [ "rand(2) - 1" ] },
            "y_adjust": 1
          },
          { "u_set_guard_pos": { "u_val": "pf_walk_to" } },
          { "math": [ "u_pf_mourn_until = max(time('now'), value_or(u_pf_mourn_until, 0) - time('1 d'))" ] },
          { "run_eocs": "PF_MK_funeral", "beta_talker": "avatar" }
        ]
      }
    ]
  }
]
