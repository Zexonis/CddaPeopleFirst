      { "set_string_var": "u_pf_known_<global_val:pf_kn_i>", "target_var": { "context_val": "kr" }, "parse_tags": true },
      { "copy_var": { "var_val": "kr" }, "target_var": { "global_val": "pf_kn_uid" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_kn_uid>_dead",
        "target_var": { "context_val": "kd" },
        "parse_tags": true
      },
      { "if": { "math": [ "value_or(v_kd, 0) == 1" ] }, "then": [ { "math": [ "pf_kn_dn += 1" ] } ] },
      { "math": [ "pf_kn_i += 1" ] }
