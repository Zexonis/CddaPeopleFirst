  {
    "type": "effect_on_condition",
    "id": "PF_KNOWN_dead_pick",
    "//": "u = you.  One step of finding the most recent death not yet listed.",
    "effect": [
      { "set_string_var": "u_pf_known_<global_val:pf_kn_j>", "target_var": { "context_val": "kr" }, "parse_tags": true },
      { "copy_var": { "var_val": "kr" }, "target_var": { "global_val": "pf_kn_ju" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_kn_ju>_dead",
        "target_var": { "context_val": "kd" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_reg_<global_val:pf_kn_ju>_dead_t",
        "target_var": { "context_val": "kdt" },
        "parse_tags": true
      },
      {
        "set_string_var": "pf_kn_shown_<global_val:pf_kn_j>",
        "target_var": { "context_val": "ksh" },
        "parse_tags": true
      },
      {
        "if": {
          "and": [
            { "math": [ "value_or(v_kd, 0) == 1" ] },
            { "math": [ "value_or(v_ksh, -1) != pf_kn_stamp" ] },
            { "math": [ "value_or(v_kdt, 0) + pf_kn_j * 0.001 > pf_kn_best" ] }
          ]
        },
        "then": [ { "math": [ "pf_kn_best = value_or(v_kdt, 0) + pf_kn_j * 0.001" ] }, { "math": [ "pf_kn_bi = pf_kn_j" ] } ]
      },
      { "math": [ "pf_kn_j += 1" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KNOWN_dead_next",
    "//": "u = you.  Lists the most recent death not yet listed (one row).",
    "effect": [
      { "math": [ "pf_kn_best = -1" ] },
      { "math": [ "pf_kn_bi = -1" ] },
      { "math": [ "pf_kn_j = 0" ] },
      {
        "run_eocs": "PF_KNOWN_dead_pick",
        "condition": { "math": [ "pf_kn_j < value_or(u_pf_known_n, 0)" ] },
        "iterations": 120
      },
      { "math": [ "pf_kn_dshown += 1" ] },
      {
        "if": { "math": [ "pf_kn_bi >= 0" ] },
        "then": [
          { "set_string_var": "pf_kn_shown_<global_val:pf_kn_bi>", "target_var": { "context_val": "ksh" }, "parse_tags": true },
          { "math": [ "v_ksh = pf_kn_stamp" ] },
          { "math": [ "pf_kn_i = pf_kn_bi" ] },
          { "run_eocs": "PF_KNOWN_scan_one" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KNOWN_scan_one",
    "//": "u = you.  One step of the People you know scan: entry pf_kn_i of your known list, living on pass 1 (forward), the dead on pass 2 (backward, newest first).",
    "effect": [
      { "set_string_var": "u_pf_known_<global_val:pf_kn_i>", "target_var": { "context_val": "kr" }, "parse_tags": true },
      { "copy_var": { "var_val": "kr" }, "target_var": { "global_val": "pf_kn_uid" } },
      {
        "set_string_var": "pf_reg_<global_val:pf_kn_uid>_dead",
        "target_var": { "context_val": "kd" },
        "parse_tags": true
      },
      {
        "if": { "math": [ "(value_or(v_kd, 0) == 1) == (pf_kn_pass == 2)" ] },
        "then": [
          { "set_string_var": "pf_name_<global_val:pf_kn_uid>", "target_var": { "context_val": "nref" }, "parse_tags": true },
          { "copy_var": { "var_val": "nref" }, "target_var": { "global_val": "pf_kn_name" } },
          {
            "if": { "compare_string": [ { "global_val": "pf_kn_name" }, "" ] },
            "then": [ { "set_string_var": "someone you met", "target_var": { "global_val": "pf_kn_name" } } ]
          },
          {
            "set_string_var": "pf_kn_l_<global_val:pf_kn_s>",
            "target_var": { "context_val": "kt" },
            "parse_tags": true
          },
          {
            "set_string_var": "pf_kn_ix_<global_val:pf_kn_s>",
            "target_var": { "context_val": "kx" },
            "parse_tags": true
          },
          { "math": [ "v_kx = pf_kn_i" ] },
          {
            "if": { "math": [ "pf_kn_pass == 2" ] },
            "then": [ { "set_string_var": "<global_val:pf_kn_name>  (gone)", "target_var": { "var_val": "kt" }, "parse_tags": true } ],
            "else": [
              { "copy_var": { "global_val": "pf_kn_uid" }, "target_var": { "global_val": "pf_m_other" } },
              { "run_eocs": "PF_VIEW_read" },
              {
                "set_string_var": "pf_kn_l_<global_val:pf_kn_s>",
                "target_var": { "context_val": "kt" },
                "parse_tags": true
              },
              {
                "set_string_var": "u_pf_v_<global_val:pf_kn_uid>_l",
                "target_var": { "context_val": "kl" },
                "parse_tags": true
              },
              {
                "math": [ "pf_kn_days = floor(time('now') / time('1 d')) - floor(value_or(v_kl, time('now')) / time('1 d'))" ]
              },
              {
                "if": { "math": [ "pf_kn_days == 0" ] },
                "then": [
                  {
                    "set_string_var": "<global_val:pf_kn_name>: <global_val:pf_read_tier_name>, saw them today",
                    "target_var": { "var_val": "kt" },
                    "parse_tags": true
                  }
                ],
                "else": [
                  {
                    "if": { "math": [ "pf_kn_days == 1" ] },
                    "then": [
                      {
                        "set_string_var": "<global_val:pf_kn_name>: <global_val:pf_read_tier_name>, a day since anything happened",
                        "target_var": { "var_val": "kt" },
                        "parse_tags": true
                      }
                    ],
                    "else": [
                      {
                        "set_string_var": "<global_val:pf_kn_name>: <global_val:pf_read_tier_name>, <global_val:pf_kn_days> days since anything happened",
                        "target_var": { "var_val": "kt" },
                        "parse_tags": true
                      }
                    ]
                  }
                ]
              }
            ]
          },
          { "math": [ "pf_kn_s += 1" ] }
        ]
      },
      { "math": [ "pf_kn_i += pf_kn_di" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KNOWN_open",
    "//": "u = you.  Everyone you know: how you see them, how long since anything happened between you, and who is gone.",
    "effect": [
      { "run_eocs": "PF_ID_ensure" },
      { "math": [ "pf_kn_stamp = value_or(pf_kn_stamp, 0) + 1" ] },
      { "math": [ "pf_kn_i = 0" ] },
      { "math": [ "pf_kn_dn = 0" ] },
      {
        "run_eocs": "PF_KNOWN_count_one",
        "condition": { "math": [ "pf_kn_i < value_or(u_pf_known_n, 0)" ] },
        "iterations": 120
      },
      { "math": [ "pf_kn_lim = 20 - min(pf_kn_dn, 4)" ] },
      { "math": [ "pf_kn_i = 0" ] },
      { "math": [ "pf_kn_s = 0" ] },
      { "math": [ "pf_kn_pass = 1" ] },
      { "math": [ "pf_kn_di = 1" ] },
      {
        "run_eocs": "PF_KNOWN_scan_one",
        "condition": { "and": [ { "math": [ "pf_kn_s < pf_kn_lim" ] }, { "math": [ "pf_kn_i < value_or(u_pf_known_n, 0)" ] } ] },
        "iterations": 120
      },
      { "math": [ "pf_kn_j = 0" ] },
      {
        "run_eocs": "PF_KNOWN_backfill_one",
        "condition": { "math": [ "pf_kn_j < value_or(u_pf_known_n, 0)" ] },
        "iterations": 120
      },
      { "math": [ "pf_kn_pass = 2" ] },
      { "math": [ "pf_kn_di = 0" ] },
      { "math": [ "pf_kn_dshown = 0" ] },
      {
        "run_eocs": "PF_KNOWN_dead_next",
        "condition": { "and": [ { "math": [ "pf_kn_s < 20" ] }, { "math": [ "pf_kn_dshown < pf_kn_dn" ] } ] },
        "iterations": 20
      },
      { "math": [ "pf_kn_heard_n = min(value_or(pf_rumors_n, 0), 6)" ] },
      {
        "set_string_var": "Heard of: <global_val:pf_kn_heard_n> groups out there (rumors)",
        "target_var": { "global_val": "pf_kn_heard" },
        "parse_tags": true
      },
      {
        "if": { "and": [ { "math": [ "value_or(u_pf_known_n, 0) == 0" ] }, { "math": [ "pf_kn_heard_n == 0" ] } ] },
        "then": [ { "u_message": "You don't really know anyone yet.", "type": "info" } ],
        "else": [
          {
            "run_eoc_selector": [
              "PF_KNOWN_heard",
              "PF_KNOWN_pick_0",
              "PF_KNOWN_pick_1",
              "PF_KNOWN_pick_2",
              "PF_KNOWN_pick_3",
              "PF_KNOWN_pick_4",
              "PF_KNOWN_pick_5",
              "PF_KNOWN_pick_6",
              "PF_KNOWN_pick_7",
              "PF_KNOWN_pick_8",
              "PF_KNOWN_pick_9",
              "PF_KNOWN_pick_10",
              "PF_KNOWN_pick_11",
              "PF_KNOWN_pick_12",
              "PF_KNOWN_pick_13",
              "PF_KNOWN_pick_14",
              "PF_KNOWN_pick_15",
              "PF_KNOWN_pick_16",
              "PF_KNOWN_pick_17",
              "PF_KNOWN_pick_18",
              "PF_KNOWN_pick_19"
            ],
            "names": [
              { "global_val": "pf_kn_heard" },
              { "global_val": "pf_kn_l_0" },
              { "global_val": "pf_kn_l_1" },
              { "global_val": "pf_kn_l_2" },
              { "global_val": "pf_kn_l_3" },
              { "global_val": "pf_kn_l_4" },
              { "global_val": "pf_kn_l_5" },
              { "global_val": "pf_kn_l_6" },
              { "global_val": "pf_kn_l_7" },
              { "global_val": "pf_kn_l_8" },
              { "global_val": "pf_kn_l_9" },
              { "global_val": "pf_kn_l_10" },
              { "global_val": "pf_kn_l_11" },
              { "global_val": "pf_kn_l_12" },
              { "global_val": "pf_kn_l_13" },
              { "global_val": "pf_kn_l_14" },
              { "global_val": "pf_kn_l_15" },
              { "global_val": "pf_kn_l_16" },
              { "global_val": "pf_kn_l_17" },
              { "global_val": "pf_kn_l_18" },
              { "global_val": "pf_kn_l_19" }
            ],
            "keys": [ "0", "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t" ],
            "title": "People you know (first met first; the gone last, newest first)",
            "hide_failing": true,
            "allow_cancel": true
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SEEN_tick",
    "//": "u = you.  Records where and when you last saw each person (pf_seen_<uid>, pf_seen_<uid>_t).",
    "recurrence": "10 minutes",
    "global": true,
    "condition": { "not": { "u_has_effect": "sleep" } },
    "effect": [
      { "u_location_variable": { "global_val": "pf_seen_av" } },
      { "u_run_npc_eocs": [ "PF_SEEN_one" ], "local": true, "npc_range": 40 }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_SEEN_one",
    "condition": { "math": [ "has_var(u_pf_uid)" ] },
    "effect": [
      { "u_location_variable": { "global_val": "pf_seen_pos" } },
      {
        "if": { "line_of_sight": 40, "loc_1": { "global_val": "pf_seen_av" }, "loc_2": { "global_val": "pf_seen_pos" } },
        "then": [
          { "set_string_var": "pf_seen_<u_val:pf_uid>", "target_var": { "context_val": "sn" }, "parse_tags": true },
          { "copy_var": { "global_val": "pf_seen_pos" }, "target_var": { "var_val": "sn" } },
          { "set_string_var": "pf_seen_<u_val:pf_uid>_t", "target_var": { "context_val": "st" }, "parse_tags": true },
          { "math": [ "v_st = time('now')" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_KNOWN_band_read",
    "//": "u = a band leader (reached by unique id).  The band's position (vpos, its leader's body while on-screen) and goal for word along the road.",
    "effect": [
      { "math": [ "pf_kb_ok = 1" ] },
      { "copy_var": { "u_val": "pf_vpos" }, "target_var": { "global_val": "pf_kb_v" } },
