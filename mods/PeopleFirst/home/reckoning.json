                { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_nm_dad" } ] },
                { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_nm_grd" } ] }
              ]
            },
            "then": [ { "math": [ "_s += 100" ] } ]
          },
          { "if": { "u_has_trait": "PF_Q_MOTHER_HEN" }, "then": [ { "math": [ "_s += 15" ] } ] },
          {
            "if": {
              "math": [ "(value_or(u_pf_resident, 0) == 1) + (value_or(u_pf_band, 0) > 0) * (value_or(u_pf_band, 0) == pf_nm_band) > 0" ]
            },
            "then": [ { "math": [ "_s += 10" ] } ]
          },
          {
            "if": { "and": [ { "math": [ "_s >= (pf_nm_kid == 1 ? 5 : 15)" ] }, { "math": [ "_s > pf_nm_cb" ] } ] },
            "then": [
              { "math": [ "pf_nm_cb = _s" ] },
              { "u_set_talker": { "global_val": "pf_nm_comf" } },
              { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true }
            ]
          }
        ]
      }
