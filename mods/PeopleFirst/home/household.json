        "then": [ { "set_string_var": "cook", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 2" ] },
        "then": [ { "set_string_var": "guard", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 3" ] },
        "then": [ { "set_string_var": "forager", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 4" ] },
        "then": [ { "set_string_var": "tinkerer", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 5" ] },
        "then": [ { "set_string_var": "carer", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 6" ] },
        "then": [ { "set_string_var": "herder", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 7" ] },
        "then": [ { "set_string_var": "farmer", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 8" ] },
        "then": [ { "set_string_var": "smith", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 9" ] },
        "then": [ { "set_string_var": "healer", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": { "math": [ "value_or(u_pf_role, 0) == 10" ] },
        "then": [ { "set_string_var": "teacher", "target_var": { "global_val": "pf_say_b" } } ]
      },
      {
        "if": {
          "and": [
            { "math": [ "value_or(pf_chief_set, 0) == 1" ] },
            { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_chief_uid" } ] }
          ]
        },
        "then": [
          { "set_string_var": "<global_val:pf_say_b>, and chief", "target_var": { "global_val": "pf_say_b" }, "parse_tags": true }
        ],
        "else": [
          {
            "if": { "math": [ "(value_or(pf_cn_n, 0) > 0) * (value_or(u_pf_cn_term, -1) == value_or(pf_cn_term, -2))" ] },
            "then": [
              {
                "set_string_var": "<global_val:pf_say_b>, and on the council",
                "target_var": { "global_val": "pf_say_b" },
                "parse_tags": true
              }
            ]
          }
        ]
      },
      {
        "if": { "u_has_effect": "sleep" },
        "then": [
          { "set_string_var": "<global_val:pf_say_b> (asleep)", "target_var": { "global_val": "pf_say_b" }, "parse_tags": true }
        ]
      },
      { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "roster" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_supply_tick",
    "//": "Every hour, 06:00-21:00: the first cook found at home keeps the stores (a candle by them each week, a jug of water a day, a pot every 8 hours).  If nobody who lives here is the cook (once a day), someone takes it on.",
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 6" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 21" ] }
      ]
    },
    "recurrence": "1 hours",
    "global": true,
    "effect": [
      { "math": [ "pf_sup_done = 0" ] },
      { "u_run_npc_eocs": [ "PF_HOME_supply_one" ], "local": true, "npc_range": 60 },
      {
        "if": {
          "and": [ { "math": [ "pf_sup_done == 0" ] }, { "math": [ "value_or(pf_ck_day, -1) != floor(time('now') / time('1 d'))" ] } ]
        },
        "then": [ { "math": [ "pf_ck_day = floor(time('now') / time('1 d'))" ] }, { "run_eocs": "PF_HOME_cook_fill" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_supply_one",
    "//": "u = someone who lives with you.  The first cook near home keeps the stores.",
    "condition": {
      "and": [
        { "math": [ "pf_sup_done == 0" ] },
        { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
        { "math": [ "value_or(u_pf_role, 0) == 1" ] },
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "not": { "u_has_effect": "sleep" } }
      ]
    },
    "effect": [
      { "copy_var": { "global_val": "pf_home_loc" }, "target_var": { "u_val": "pf_anchor" } },
      {
        "if": { "math": [ "has_var(u_pf_house)" ] },
        "then": [ { "copy_var": { "u_val": "pf_house" }, "target_var": { "u_val": "pf_anchor" } } ]
      },
      { "u_location_variable": { "u_val": "pf_pos" } },
      {
        "if": { "math": [ "distance(u_pf_pos, u_pf_anchor) <= 25" ] },
        "then": [
          { "math": [ "pf_sup_done = 1" ] },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
          {
            "if": { "math": [ "time('now') - value_or(pf_lamp_t, 0) >= time('7 d')" ] },
            "then": [
              { "math": [ "pf_lamp_t = time('now')" ] },
              { "math": [ "pf_lamp_n = 0" ] },
              {
                "u_map_run_item_eocs": "all",
                "loc": { "global_val": "pf_stores_loc" },
                "min_radius": 0,
                "max_radius": 2,
                "search_data": [ { "id": "candle_lit" } ],
                "true_eocs": [ { "id": "PF_HOME_lamp_count", "effect": [ { "math": [ "pf_lamp_n += 1" ] } ] } ]
              },
              {
                "if": { "math": [ "pf_lamp_n == 0" ] },
