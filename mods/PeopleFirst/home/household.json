            "then": [
              { "math": [ "pf_pot_last = time('now')" ] },
              { "math": [ "_s = rand(2)" ] },
              {
                "if": { "math": [ "_s == 0" ] },
                "then": [
                  {
                    "map_spawn_item": "soup_three_sisters",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  },
                  {
                    "map_spawn_item": "soup_three_sisters",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  },
                  {
                    "map_spawn_item": "soup_three_sisters",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  }
                ]
              },
              {
                "if": { "math": [ "_s == 1" ] },
                "then": [
                  { "map_spawn_item": "soup_meat", "loc": { "global_val": "pf_stores_loc" }, "container": "ceramic_bowl", "count": 1 },
                  {
                    "map_spawn_item": "soup_meat",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  },
                  {
                    "map_spawn_item": "soup_meat",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  }
                ]
              },
              {
                "if": { "math": [ "_s == 2" ] },
                "then": [
                  {
                    "map_spawn_item": "soup_woods_egg",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  },
                  {
                    "map_spawn_item": "soup_woods_egg",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  },
                  {
                    "map_spawn_item": "soup_woods_egg",
                    "loc": { "global_val": "pf_stores_loc" },
                    "container": "ceramic_bowl",
                    "count": 1
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_cook_fill",
    "//": "u = you, at home.  Nobody who lives here is the cook: whoever cooks best (or a mother hen) takes the pot over, and says so.",
    "effect": [
      { "math": [ "pf_ck_n = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_HOME_ck_count",
            "condition": {
              "and": [
                { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                { "math": [ "value_or(u_pf_role, 0) == 1" ] },
                { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] }
              ]
            },
            "effect": [ { "math": [ "pf_ck_n += 1" ] } ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      {
        "if": { "math": [ "pf_ck_n == 0" ] },
        "then": [
          { "math": [ "pf_ck_best = -1" ] },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_HOME_ck_cand",
                "condition": {
                  "and": [
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] }
                  ]
                },
                "effect": [
                  { "math": [ "_s = u_skill('cooking') * 2 + rand(2)" ] },
                  { "if": { "u_has_trait": "PF_Q_MOTHER_HEN" }, "then": [ { "math": [ "_s += 2" ] } ] },
                  {
                    "if": { "math": [ "_s > pf_ck_best" ] },
                    "then": [ { "math": [ "pf_ck_best = _s" ] }, { "u_set_talker": { "global_val": "pf_ck_who" } } ]
                  }
                ]
              }
            ],
            "local": true,
            "npc_range": 60
          },
          {
            "if": { "math": [ "pf_ck_best >= 0" ] },
            "then": [
              {
                "run_eocs": {
                  "id": "PF_HOME_ck_take",
                  "effect": [
                    { "math": [ "u_pf_role = 1" ] },
                    { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true }
                  ]
                },
                "alpha_talker": { "global_val": "pf_ck_who" }
              },
              { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "cook_fill" } }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_chore_tick",
    "//": "Every 3 hours, 08:00-18:00, when it's calm: everyone who lives with you and is within 25 tiles of home does their job.  The cook leaves soup at home, the forager brings back berries or mushrooms, the guard walks the edge of the place, the tinkerer fixes things, the carer looks after the children.  At most three lines each time, and only if you're home.",
    "condition": {
      "and": [
        { "math": [ "value_or(pf_home_set, 0) == 1" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') >= 8" ] },
        { "math": [ "time_since('midnight', 'unit': 'hours') < 18" ] },
        { "math": [ "(value_or(pf_law_rest, 0) == 1) * (floor(time('now') / time('1 d')) % 7 == 2) == 0" ] }
      ]
    },
    "recurrence": "3 hours",
    "global": true,
    "effect": [
      { "math": [ "pf_ch_l = 0" ] },
      { "math": [ "pf_ch_said_1 = 0" ] },
      { "math": [ "pf_ch_said_2 = 0" ] },
      { "math": [ "pf_ch_said_3 = 0" ] },
      { "math": [ "pf_ch_said_4 = 0" ] },
      { "math": [ "pf_ch_said_5 = 0" ] },
      { "u_location_variable": { "global_val": "pf_hm_av" } },
      { "math": [ "pf_ch_av = distance(pf_hm_av, pf_home_loc) <= 30" ] },
      { "run_eocs": "PF_THREAT_scan" },
      {
        "if": { "math": [ "pf_threat == 0" ] },
        "then": [ { "u_run_npc_eocs": [ "PF_HOME_chore_one" ], "local": true, "npc_range": 60 } ]
