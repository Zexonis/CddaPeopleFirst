[
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_role_pick",
    "//": "u = an adult who just moved in.  The job that fits their skills (and quirks): cook, guard, forager, tinkerer, carer, or (v0.5) herder when there are animals at home and farmer when there's a field.  Ties go in that order.",
    "condition": { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
    "effect": [
      { "math": [ "_c = u_skill('cooking') * 2" ] },
      { "if": { "u_has_trait": "PF_Q_MOTHER_HEN" }, "then": [ { "math": [ "_c += 2" ] } ] },
      { "math": [ "_g = u_skill('melee') + u_skill('gun')" ] },
      { "if": { "u_has_trait": "PF_Q_PROUD" }, "then": [ { "math": [ "_g += 2" ] } ] },
      { "math": [ "_f = u_skill('survival') * 2" ] },
      { "if": { "u_has_trait": "PF_T_LONER" }, "then": [ { "math": [ "_f += 2" ] } ] },
      { "math": [ "_t = u_skill('fabrication') + u_skill('mechanics')" ] },
      { "math": [ "_r = u_skill('firstaid') * 2" ] },
      { "if": { "u_has_trait": "PF_Q_MOTHER_HEN" }, "then": [ { "math": [ "_r += 3" ] } ] },
      {
        "math": [
          "_h = (monsters_nearby('mon_cow', 'mon_goat', 'mon_chicken', 'radius': 25, 'location': pf_home_loc, 'attitude': 'friendly') > 0) * (u_skill('survival') + 1 + (u_has_trait('PF_Q_MOTHER_HEN') ? 2 : 0))"
        ]
      },
      {
        "math": [
          "_a = (value_or(pf_field_state, 0) > 0) * (u_skill('survival') + u_skill('cooking') + (u_has_trait('PF_Q_HATES_WASTE') ? 2 : 0))"
        ]
      },
      { "math": [ "_s = u_skill('fabrication') * 2 + u_skill('mechanics') - 1" ] },
      { "math": [ "_e = u_skill('firstaid') * 3 - 3" ] },
      { "math": [ "pf_rp_kids = 0" ] },
      {
        "u_run_npc_eocs": [
          {
            "id": "PF_HOME_rp_kid",
            "condition": { "and": [ { "u_has_trait": "PF_CHILD" }, { "math": [ "value_or(u_pf_resident, 0) == 1" ] } ] },
            "effect": [ { "math": [ "pf_rp_kids += 1" ] } ]
          }
        ],
        "local": true,
        "npc_range": 60
      },
      { "math": [ "_k = (pf_rp_kids > 0) * (u_val('intelligence') - 8 + u_skill('speech'))" ] },
      { "math": [ "_b = max(max(max(_c, _g), max(_f, _t)), max(max(_r, max(_h, _a)), max(_s, max(_e, _k))))" ] },
      {
        "math": [
          "u_pf_role = _b == _c ? 1 : (_b == _g ? 2 : (_b == _f ? 3 : (_b == _t ? 4 : (_b == _r ? 5 : (_b == _h ? 6 : (_b == _a ? 7 : (_b == _s ? 8 : (_b == _e ? 9 : 10))))))))"
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_role_next",
    "//": "u = you, npc = someone who lives with you (People menu: Ask them to take a different job).  Cycles cook, guard, forager, tinkerer, carer, herder, farmer, smith, healer, teacher.",
    "effect": [
      { "math": [ "n_pf_role = value_or(n_pf_role, 0) % 10 + 1" ] },
      {
        "run_eocs": {
          "id": "PF_HOME_role_said",
          "effect": [
            { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 0" ] },
              "then": [ { "set_string_var": "no particular job", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 1" ] },
              "then": [ { "set_string_var": "cook", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 2" ] },
              "then": [ { "set_string_var": "guard", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 3" ] },
              "then": [ { "set_string_var": "forager", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 4" ] },
              "then": [ { "set_string_var": "tinkerer", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 5" ] },
              "then": [ { "set_string_var": "carer", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 6" ] },
              "then": [ { "set_string_var": "herder", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 7" ] },
              "then": [ { "set_string_var": "farmer", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 8" ] },
              "then": [ { "set_string_var": "smith", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 9" ] },
              "then": [ { "set_string_var": "healer", "target_var": { "global_val": "pf_say_b" } } ]
            },
            {
              "if": { "math": [ "value_or(u_pf_role, 0) == 10" ] },
              "then": [ { "set_string_var": "teacher", "target_var": { "global_val": "pf_say_b" } } ]
            }
          ]
        },
        "alpha_talker": "npc"
      },
      { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "role_change" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_roster",
    "//": "u = you (Home: Who does what).  One line per person who lives with you and is nearby.",
    "effect": [
      { "math": [ "pf_ro_n = 0" ] },
      { "u_run_npc_eocs": [ "PF_HOME_roster_one" ], "local": true, "npc_range": 60 },
      {
        "if": { "math": [ "pf_ro_n == 0" ] },
        "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "roster_none" } } ]
      }
    ]
  },
