      { "if": { "u_has_trait": "PF_Q_HATES_WASTE" }, "then": [ { "math": [ "_s += 40" ] } ] },
      { "if": { "u_has_trait": "PF_Q_PROUD" }, "then": [ { "math": [ "_s += 15" ] } ] },
      {
        "if": { "and": [ { "math": [ "_s >= 15" ] }, { "math": [ "_s > pf_bt_best" ] } ] },
        "then": [ { "math": [ "pf_bt_best = _s" ] }, { "u_set_talker": { "global_val": "pf_bt_who" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_burnt_row",
    "//": "Alpha = the critic, beta = the cook.",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "set_string_var": "<npc_name>", "target_var": { "global_val": "pf_say_b" }, "parse_tags": true },
      {
        "if": { "math": [ "pf_ch_say" ] },
        "then": [
          { "math": [ "pf_ch_l += 1" ] },
          { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "burnt_row" } }
        ]
      },
      { "math": [ "pf_m_str_in = 40" ] },
      { "run_eocs": "PF_MK_argument" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_stay_tick",
    "//": "Once a day: anyone who lives with you and has soured on you (tension 60+, or warmth below 10 with no partner, children or household of their own here) packs up and goes.  If they're an A-Life person they start a band of their own out there; otherwise they just walk away.",
    "condition": { "math": [ "value_or(pf_home_set, 0) == 1" ] },
    "recurrence": "1 days",
    "global": true,
    "effect": [ { "u_run_npc_eocs": [ "PF_HOME_stay_check" ], "local": true, "npc_range": 60 } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_stay_check",
    "condition": {
      "and": [
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
        { "math": [ "time_since(value_or(u_pf_resident_since, 0)) >= time('2 d')" ] }
      ]
    },
    "effect": [
      { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } },
      { "run_eocs": "PF_VIEW_read" },
      {
        "if": { "or": [ { "math": [ "pf_read_w < 10" ] }, { "math": [ "pf_read_x >= 60" ] } ] },
        "then": [
          { "math": [ "pf_st_x = pf_read_x" ] },
          { "math": [ "pf_st_ties = 0" ] },
          { "u_set_talker": { "global_val": "pf_st_who" } },
          { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_st_uid" } },
          { "set_string_var": "none", "target_var": { "global_val": "pf_st_sweet" } },
          {
            "if": { "math": [ "value_or(u_pf_has_sweet, 0) == 1" ] },
            "then": [ { "copy_var": { "u_val": "pf_sweet" }, "target_var": { "global_val": "pf_st_sweet" } } ]
          },
          { "math": [ "pf_st_hh = value_or(u_pf_household, 0)" ] },
          {
            "u_run_npc_eocs": [
              {
                "id": "PF_HOME_stay_tie",
                "condition": {
                  "and": [
                    { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
                    { "not": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_st_uid" } ] } }
                  ]
                },
                "effect": [
                  {
                    "if": { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_st_sweet" } ] },
                    "then": [ { "math": [ "pf_st_ties += 1" ] } ]
                  },
                  {
                    "if": { "math": [ "(pf_st_hh > 0) * (value_or(u_pf_household, 0) == pf_st_hh)" ] },
                    "then": [ { "math": [ "pf_st_ties += 1" ] } ]
                  },
                  {
                    "if": {
                      "or": [
                        { "compare_string": [ { "u_val": "pf_mom" }, { "global_val": "pf_st_uid" } ] },
                        { "compare_string": [ { "u_val": "pf_dad" }, { "global_val": "pf_st_uid" } ] },
                        { "compare_string": [ { "u_val": "pf_guardian" }, { "global_val": "pf_st_uid" } ] }
                      ]
                    },
                    "then": [ { "math": [ "pf_st_ties += 1" ] } ]
                  }
                ]
              }
            ],
            "local": true,
            "npc_range": 60
          },
          {
            "if": { "or": [ { "math": [ "pf_st_x >= 60" ] }, { "math": [ "pf_st_ties == 0" ] } ] },
            "then": [ { "run_eocs": "PF_HOME_leave", "alpha_talker": { "global_val": "pf_st_who" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HOME_leave",
    "//": "u = someone leaving home.  It lands like a breakup (one-sided, their side).  An A-Life person becomes the leader of a new one-person band (back in the roster, walking off to hunt); anyone else walks away.",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
      { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "leaves" } },
      { "math": [ "u_pf_resident = 0" ] },
      { "math": [ "u_pf_role = 0" ] },
      { "math": [ "pf_residents_n = max(value_or(pf_residents_n, 1) - 1, 0)" ] },
      { "set_string_var": "AVATAR", "target_var": { "global_val": "pf_m_other" } },
      { "math": [ "pf_mv_role = 2" ] },
      { "math": [ "pf_m_str_in = 60" ] },
      { "run_eocs": "PF_MV_breakup" },
      {
        "if": { "u_has_trait": "PF_AGENT" },
        "then": [
          { "copy_var": { "u_val": "pf_uid" }, "target_var": { "global_val": "pf_band_new_leader" } },
          { "run_eocs": "PF_ALIFE_register_band" },
          { "math": [ "pf_ws_task = 1" ] },
          { "math": [ "pf_ws_kind = 0" ] },
          { "run_eocs": "PF_WORLD_init_leader" },
          { "math": [ "pf_residents_left_total = value_or(pf_residents_left_total, 0) + 1" ] }
        ],
        "else": [
          { "u_location_variable": { "u_val": "pf_walk_to" } },
          {
            "location_variable_adjust": { "u_val": "pf_walk_to" },
            "x_adjust": { "math": [ "(rand(1) * 2 - 1) * 50" ] },
            "y_adjust": { "math": [ "rand(40) - 20" ] }
          },
          { "u_set_guard_pos": { "u_val": "pf_walk_to" } }
        ]
      }
    ]
  }
]
