                  { "map_spawn_item": "candle_lit", "loc": { "global_val": "pf_stores_loc" } },
                  { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "chore_lamp" } }
                ]
              }
            ]
          },
          { "run_eocs": "PF_STORES_ensure" },
          { "math": [ "pf_ck_bowls = 0" ] },
          { "math": [ "pf_ck_jugs = 0" ] },
          { "run_eocs": "PF_ENGINE_caps" },
          {
            "u_map_run_item_eocs": "all",
            "loc": { "global_val": "pf_stores_loc" },
            "min_radius": 0,
            "max_radius": 2,
            "search_data": [
              {
                "id": "ceramic_bowl",
                "condition": {
                  "and": [
                    { "math": [ "n_weight() >= 405000" ] },
                    {
                      "or": [ { "math": [ "value_or(pf_eng_level, 0) < 16" ] }, { "not": { "npc_has_flag": "PF_ROTTEN" } } ]
                    }
                  ]
                }
              }
            ],
            "true_eocs": [ { "id": "PF_HOME_ck_bowl", "effect": [ { "math": [ "pf_ck_bowls += 1" ] } ] } ]
          },
          {
            "u_map_run_item_eocs": "all",
            "loc": { "global_val": "pf_stores_loc" },
            "min_radius": 0,
            "max_radius": 2,
            "search_data": [ { "id": "jug_plastic", "condition": { "math": [ "n_weight() >= 1000000" ] } } ],
            "true_eocs": [ { "id": "PF_HOME_ck_jug", "effect": [ { "math": [ "pf_ck_jugs += 1" ] } ] } ]
          },
          {
            "if": { "math": [ "(time('now') - value_or(pf_water_last, 0) >= time('1 d')) * (pf_ck_jugs < 3)" ] },
            "then": [
