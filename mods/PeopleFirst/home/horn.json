[
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_tick",
    "//": "Every 2 minutes, when there are people around you: if something hostile is close (PF_THREAT_scan), the camp is alarmed; while it lasts, everyone keeps to their job (defenders re-aim at the threat as it moves, children stay away); once it has been calm for a few minutes, the all-clear.",
    "condition": { "math": [ "value_or(pf_horn_on, 1) == 1" ] },
    "recurrence": "2 minutes",
    "global": true,
    "effect": [
      { "run_eocs": "PF_THREAT_scan" },
      {
        "if": { "or": [ { "math": [ "pf_threat > 0" ] }, { "math": [ "value_or(pf_wt_seen_t, -1) >= time('now') - time('3 m')" ] } ] },
        "then": [
          {
            "if": { "math": [ "value_or(pf_horn_active, 0) == 0" ] },
            "then": [ { "run_eocs": "PF_HORN_alarm" } ],
            "else": [ { "run_eocs": "PF_HORN_scramble" } ]
          }
        ],
        "else": [
          {
            "if": {
              "and": [
                { "math": [ "value_or(pf_horn_active, 0) == 1" ] },
                { "math": [ "time('now') - max(pf_horn_t, value_or(pf_horn_last, 0)) >= time('6 m')" ] }
              ]
            },
            "then": [ { "run_eocs": "PF_HORN_allclear" } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_alarm",
    "//": "u = avatar, a new threat.  The watcher (if someone has the watch) or the nearest awake adult raises the alarm; you're shaken awake if you were asleep; then the scramble.",
    "effect": [
      { "math": [ "pf_horn_active = 1" ] },
      { "math": [ "pf_horn_t = time('now')" ] },
      { "math": [ "pf_hn_escd = 0" ] },
      { "math": [ "pf_horn_deaths0 = value_or(pf_ours_dead_total, 0)" ] },
      { "run_eocs": "PF_HORN_locate" },
      {
        "if": { "math": [ "pf_hn_found == 0" ] },
        "then": [ { "math": [ "pf_horn_active = 0" ] } ],
        "else": [
          { "math": [ "pf_hn_people = 0" ] },
          { "u_run_npc_eocs": [ "PF_HORN_count" ], "local": true, "npc_range": 30 },
          {
            "if": { "math": [ "pf_hn_people == 0" ] },
            "then": [ { "math": [ "pf_horn_active = 0" ] } ],
            "else": [
              { "set_string_var": "", "target_var": { "global_val": "pf_hn_spot" } },
              {
                "if": { "math": [ "value_or(pf_wt_seen_t, -1) >= time('now') - time('3 m')" ] },
                "then": [ { "copy_var": { "global_val": "pf_wt_spot" }, "target_var": { "global_val": "pf_hn_spot" } } ]
              },
              {
                "if": {
                  "and": [ { "math": [ "value_or(pf_watch_active, 0) == 1" ] }, { "compare_string": [ { "global_val": "pf_hn_spot" }, "" ] } ]
                },
                "then": [
                  { "set_string_var": "pf_name_<global_val:pf_watch_uid>", "target_var": { "context_val": "wn" }, "parse_tags": true },
                  { "copy_var": { "var_val": "wn" }, "target_var": { "global_val": "pf_hn_spot" } }
                ]
              },
              {
                "if": { "compare_string": [ { "global_val": "pf_hn_spot" }, "" ] },
                "then": [ { "math": [ "pf_hn_best = 9999" ] }, { "u_run_npc_eocs": [ "PF_HORN_spotter" ], "local": true, "npc_range": 30 } ]
              },
              {
                "math": [
                  "pf_hn_quiet = (time('now') - value_or(pf_horn_clear_t, -999999) < time('30 m')) + (time('now') - value_or(pf_horn_said_t, -999999) < time('3 h')) > 0"
                ]
              },
              {
                "if": {
                  "and": [ { "not": { "compare_string": [ { "global_val": "pf_hn_spot" }, "" ] } }, { "math": [ "pf_hn_quiet == 0" ] } ]
                },
                "then": [
                  { "math": [ "pf_horn_said_t = time('now')" ] },
                  { "math": [ "_v = rand(3)" ] },
                  {
                    "if": { "math": [ "_v == value_or(pf_hn_last, -1)" ] },
                    "then": [ { "math": [ "_v = (_v + 1) % 4" ] } ]
                  },
                  { "math": [ "pf_hn_last = _v" ] },
                  {
                    "if": { "math": [ "_v == 0" ] },
                    "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_alarm" } } ]
                  },
                  {
                    "if": { "math": [ "_v == 1" ] },
                    "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_alarm_1" } } ]
                  },
                  {
                    "if": { "math": [ "_v == 2" ] },
                    "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_alarm_2" } } ]
                  },
                  {
                    "if": { "math": [ "_v == 3" ] },
                    "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_alarm_3" } } ]
                  }
                ]
              },
              {
                "if": {
                  "and": [
                    { "u_has_effect": "sleep" },
                    { "math": [ "u_monsters_nearby('radius': 6) > 0" ] },
                    { "math": [ "distance(pf_hn_av, pf_hn_att) <= 6" ] },
                    {
                      "line_of_sight": 6,
                      "loc_1": { "global_val": "pf_hn_av" },
                      "loc_2": { "global_val": "pf_hn_att" }
                    }
                  ]
                },
                "then": [
                  { "u_lose_effect": "sleep" },
                  { "u_lose_effect": "lying_down" },
                  { "u_lose_effect": "PF_sleep_easy" },
                  { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_wake_you" } }
                ]
              },
              { "math": [ "pf_horn_new = 1" ] },
              { "run_eocs": "PF_HORN_scramble" },
              { "math": [ "pf_horn_new = 0" ] },
              { "math": [ "pf_horn_alarms_total = value_or(pf_horn_alarms_total, 0) + 1" ] }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_count",
    "condition": {
      "and": [
        { "math": [ "has_var(u_pf_uid)" ] },
        { "math": [ "u_val('age') >= 2" ] },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        }
      ]
    },
    "effect": [ { "math": [ "pf_hn_people += 1" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_OURS_died",
    "//": "Signal: one of ours dies (resident, or someone who cares for you).",
    "condition": {
      "and": [
        "has_alpha",
        "u_is_npc",
        { "math": [ "has_var(u_pf_uid)" ] },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        },
        { "math": [ "value_or(u_pf_envoy, 0) == 0" ] },
        { "math": [ "value_or(u_pf_nv_gone, 0) == 0" ] }
      ]
    },
    "eoc_type": "EVENT",
    "required_event": "character_dies",
    "effect": [
      { "math": [ "pf_ours_dead_total = value_or(pf_ours_dead_total, 0) + 1" ] },
      { "math": [ "pf_loss_multi = (time('now') - value_or(pf_loss_t, -999999) < time('12 h')) ? 1 : 0" ] },
      { "math": [ "pf_loss_n = value_or(pf_loss_n, 0) + 1" ] },
      { "math": [ "pf_loss_t = time('now')" ] },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_loss_name" }, "parse_tags": true },
      {
        "if": { "math": [ "value_or(u_pf_resident, 0) == 1" ] },
        "then": [
          { "math": [ "pf_est_pending = 1" ] },
          { "math": [ "pf_est_t = time('now')" ] },
          { "u_location_variable": { "global_val": "pf_est_at" } },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_est_name" }, "parse_tags": true },
          { "math": [ "pf_est_hascn = has_var(u_pf_corner)" ] },
          {
            "if": { "math": [ "pf_est_hascn == 1" ] },
            "then": [ { "copy_var": { "u_val": "pf_corner" }, "target_var": { "global_val": "pf_est_cn" } } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_WAKE_on_hurt",
    "//": "Signal: one of ours is hit by a monster within 20 tiles of you while you sleep: you're shaken awake (once every 10 minutes).",
    "condition": {
      "and": [
        "has_alpha",
        "has_beta",
        "u_is_npc",
        "npc_is_monster",
        { "math": [ "has_var(u_pf_uid)" ] },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        }
      ]
    },
    "eoc_type": "EVENT",
    "required_event": "character_takes_damage",
    "effect": [
      { "u_location_variable": { "global_val": "pf_wk_at" } },
      {
        "run_eocs": {
          "id": "PF_WAKE_on_hurt_av",
          "effect": [
            { "u_location_variable": { "global_val": "pf_wk_av" } },
            {
              "if": {
                "and": [
                  { "u_has_effect": "sleep" },
                  { "math": [ "distance(pf_wk_av, pf_wk_at) <= 20" ] },
                  { "math": [ "time('now') - value_or(pf_wk_t, -999999) >= time('10 m')" ] }
                ]
              },
              "then": [
                { "math": [ "pf_wk_t = time('now')" ] },
                { "u_lose_effect": "sleep" },
                { "u_lose_effect": "lying_down" },
                { "u_lose_effect": "PF_sleep_easy" },
                { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
                { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "hurt_wake_you" } }
              ]
            }
          ]
        },
        "alpha_talker": "avatar"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_locate",
    "//": "u = avatar.  pf_hn_att = the nearest hostile monster within 25 tiles of you, or else whatever just hurt one of ours (it can be out of your sight: playtest 2), or else what the town watch saw (Town pass 3).",
    "effect": [
      { "math": [ "pf_hn_found = 0" ] },
      { "math": [ "pf_hn_dmin = 9999" ] },
      { "u_location_variable": { "global_val": "pf_hn_av" } },
      { "u_run_monster_eocs": [ "PF_HORN_mon" ], "monster_range": 25 },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_found == 0" ] }, { "math": [ "value_or(pf_hn_hurt_t, -1) >= time('now') - time('1 m')" ] } ]
        },
        "then": [
          { "copy_var": { "global_val": "pf_hn_hurt_mpos" }, "target_var": { "global_val": "pf_hn_att" } },
          { "math": [ "pf_hn_found = 1" ] }
        ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_found == 0" ] }, { "math": [ "value_or(pf_wt_seen_t, -1) >= time('now') - time('3 m')" ] } ]
        },
        "then": [
          { "copy_var": { "global_val": "pf_wt_seen_mpos" }, "target_var": { "global_val": "pf_hn_att" } },
          { "math": [ "pf_hn_found = 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_mon",
    "condition": { "math": [ "u_monsters_nearby('radius': 0) > 0" ] },
    "effect": [
      { "u_location_variable": { "global_val": "pf_hn_mpos" } },
      {
        "if": { "math": [ "distance(pf_hn_mpos, pf_hn_av) < pf_hn_dmin" ] },
        "then": [
          { "math": [ "pf_hn_dmin = distance(pf_hn_mpos, pf_hn_av)" ] },
          { "math": [ "pf_hn_found = 1" ] },
          { "copy_var": { "global_val": "pf_hn_mpos" }, "target_var": { "global_val": "pf_hn_att" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_spotter",
    "condition": {
      "and": [
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "not": { "u_has_effect": "sleep" } },
        { "math": [ "has_var(u_pf_uid)" ] },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        }
      ]
    },
    "effect": [
      { "u_location_variable": { "u_val": "pf_pos" } },
      {
        "if": { "math": [ "distance(u_pf_pos, pf_hn_att) < pf_hn_best" ] },
        "then": [
          { "math": [ "pf_hn_best = distance(u_pf_pos, pf_hn_att)" ] },
          { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_hn_spot" }, "parse_tags": true }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_scramble",
    "//": "u = avatar.  Children first (each one runs to safety and names who should go with them), then the adults (a child's parent or guardian goes with them; everyone else runs at the threat).",
    "effect": [
      { "run_eocs": "PF_HORN_locate" },
      {
        "if": { "math": [ "pf_hn_found == 1" ] },
        "then": [
          { "math": [ "pf_hn_esc_n = 0" ] },
          { "u_run_npc_eocs": [ "PF_HORN_child" ], "local": true, "npc_range": 30 },
          { "math": [ "pf_hn_n = 0" ] },
          { "math": [ "pf_hn_esc_said = 0" ] },
          { "u_run_npc_eocs": [ "PF_HORN_adult" ], "local": true, "npc_range": 30 }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_child",
    "//": "u = a child (walking; babies are carried, so they go wherever their carrier goes).  Runs to the safe spot (and it frightened them: Reckoning nightmares).",
    "condition": {
      "and": [
        { "u_has_trait": "PF_CHILD" },
        { "not": { "u_has_effect": "PF_infant" } },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        }
      ]
    },
    "effect": [
      { "u_location_variable": { "u_val": "pf_pos" } },
      { "run_eocs": "PF_HORN_safe_spot" },
      { "copy_var": { "global_val": "pf_hn_safe" }, "target_var": { "u_val": "pf_walk_to" } },
      { "u_set_guard_pos": { "u_val": "pf_walk_to" } },
      { "set_string_var": "none", "target_var": { "global_val": "pf_hn_esc" } },
      { "copy_var": { "u_val": "pf_dad" }, "target_var": { "global_val": "pf_hn_esc" } },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_mom" }, "none" ] } },
        "then": [ { "copy_var": { "u_val": "pf_mom" }, "target_var": { "global_val": "pf_hn_esc" } } ]
      },
      {
        "if": { "not": { "compare_string": [ { "u_val": "pf_guardian" }, "none" ] } },
        "then": [ { "copy_var": { "u_val": "pf_guardian" }, "target_var": { "global_val": "pf_hn_esc" } } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n < 6" ] }, { "not": { "compare_string": [ { "global_val": "pf_hn_esc" }, "none" ] } } ]
        },
        "then": [
          { "set_string_var": "pf_hn_esc_<global_val:pf_hn_esc_n>", "target_var": { "context_val": "er" }, "parse_tags": true },
          { "copy_var": { "global_val": "pf_hn_esc" }, "target_var": { "var_val": "er" } },
          {
            "set_string_var": "pf_hn_kid_<global_val:pf_hn_esc_n>",
            "target_var": { "context_val": "ek" },
            "parse_tags": true
          },
          { "set_string_var": "<u_name>", "target_var": { "var_val": "ek" }, "parse_tags": true },
          { "math": [ "pf_hn_esc_n += 1" ] }
        ]
      },
      { "math": [ "u_pf_fright_t = time('now')" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_safe_spot",
    "//": "u = someone getting away from pf_hn_att.  Home, if it's away from the threat and not far; otherwise 12 tiles straight away from it.",
    "effect": [
      {
        "if": {
          "and": [
            { "math": [ "value_or(pf_home_set, 0) == 1" ] },
            { "math": [ "distance(pf_home_loc, pf_hn_att) > 15" ] },
            { "math": [ "distance(pf_home_loc, u_pf_pos) < 40" ] }
          ]
        },
        "then": [ { "copy_var": { "global_val": "pf_home_loc" }, "target_var": { "global_val": "pf_hn_safe" } } ],
        "else": [
          { "copy_var": { "u_val": "pf_pos" }, "target_var": { "global_val": "pf_hn_safe" } },
          {
            "location_variable_adjust": { "global_val": "pf_hn_safe" },
            "x_adjust": { "math": [ "((u_pf_pos.x > pf_hn_att.x) - (u_pf_pos.x < pf_hn_att.x)) * 12" ] },
            "y_adjust": { "math": [ "((u_pf_pos.y > pf_hn_att.y) - (u_pf_pos.y < pf_hn_att.y)) * 12" ] }
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "PF_HORN_adult",
    "//": "u = an adult near the trouble (woken if asleep).  A parent or guardian of a child who is running goes with them; everyone else runs at the threat (vanilla combat takes it from there).",
    "condition": {
      "and": [
        { "and": [ { "not": { "u_has_trait": "PF_CHILD" } }, { "math": [ "u_val('age') >= 18" ] } ] },
        { "math": [ "has_var(u_pf_uid)" ] },
        {
          "or": [ { "math": [ "value_or(u_pf_resident, 0) == 1" ] }, { "math": [ "value_or(u_pf_v_AVATAR_w, 0) >= 20" ] } ]
        },
        {
          "math": [ "(value_or(pf_sg_state, 0) == 1) * (value_or(u_pf_sg_keep_t, -1) == value_or(pf_sg_t0, -2)) == 0" ]
        }
      ]
    },
    "effect": [
      { "u_location_variable": { "u_val": "pf_pos" } },
      {
        "if": { "u_has_effect": "sleep" },
        "then": [ { "u_lose_effect": "sleep" }, { "u_lose_effect": "lying_down" } ]
      },
      { "math": [ "pf_hn_escort = -1" ] },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 0" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_0" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 0" ] } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 1" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_1" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 1" ] } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 2" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_2" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 2" ] } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 3" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_3" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 3" ] } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 4" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_4" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 4" ] } ]
      },
      {
        "if": {
          "and": [ { "math": [ "pf_hn_esc_n > 5" ] }, { "compare_string": [ { "u_val": "pf_uid" }, { "global_val": "pf_hn_esc_5" } ] } ]
        },
        "then": [ { "math": [ "pf_hn_escort = 5" ] } ]
      },
      {
        "if": { "math": [ "pf_hn_escort >= 0" ] },
        "then": [
          { "run_eocs": "PF_HORN_safe_spot" },
          { "copy_var": { "global_val": "pf_hn_safe" }, "target_var": { "u_val": "pf_walk_to" } },
          { "u_set_guard_pos": { "u_val": "pf_walk_to" } },
          {
            "if": { "math": [ "value_or(pf_hn_escd, 0) == 0" ] },
            "then": [
              { "math": [ "pf_hn_escd = 1" ] },
              { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_hn_escd_a" }, "parse_tags": true },
              {
                "set_string_var": "pf_hn_kid_<global_val:pf_hn_escort>",
                "target_var": { "context_val": "ek2" },
                "parse_tags": true
              },
              { "copy_var": { "var_val": "ek2" }, "target_var": { "global_val": "pf_hn_escd_b" } }
            ]
          },
          {
            "if": {
              "and": [
                { "math": [ "pf_hn_esc_said == 0" ] },
                { "math": [ "value_or(pf_horn_new, 0) == 1" ] },
                { "math": [ "value_or(pf_set_chatter, 1) == 1" ] },
                { "math": [ "value_or(pf_hn_quiet, 0) == 0" ] }
              ]
            },
            "then": [
              { "math": [ "pf_hn_esc_said = 1" ] },
              { "set_string_var": "<u_name>", "target_var": { "global_val": "pf_say_a" }, "parse_tags": true },
              {
                "set_string_var": "pf_hn_kid_<global_val:pf_hn_escort>",
