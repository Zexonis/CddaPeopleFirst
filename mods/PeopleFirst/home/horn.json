              },
              { "copy_var": { "var_val": "ek" }, "target_var": { "global_val": "pf_say_b" } },
              { "math": [ "_p = rand(3)" ] },
              {
                "if": { "math": [ "_p == value_or(pf_hn_sh_last, -1)" ] },
                "then": [ { "math": [ "_p = (_p + 1) % 4" ] } ]
              },
              { "math": [ "pf_hn_sh_last = _p" ] },
              {
                "if": { "math": [ "_p == 0" ] },
                "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_shield" } } ]
              },
              {
                "if": { "math": [ "_p == 1" ] },
