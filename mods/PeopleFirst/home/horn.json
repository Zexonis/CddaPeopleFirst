          { "copy_var": { "global_val": "pf_hn_escd_a" }, "target_var": { "global_val": "pf_say_a" } },
          { "copy_var": { "global_val": "pf_hn_escd_b" }, "target_var": { "global_val": "pf_say_b" } },
          {
            "if": {
              "and": [
