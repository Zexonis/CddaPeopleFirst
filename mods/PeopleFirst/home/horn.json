                        "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_clear_grief" } } ],
                        "else": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_clear" } } ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      { "math": [ "pf_horn_clear_t = time('now')" ] },
      {
        "if": {
