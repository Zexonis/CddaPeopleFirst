              },
              {
                "if": { "math": [ "_p == 2" ] },
                "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_shield_2" } } ]
              },
              {
                "if": { "math": [ "_p == 3" ] },
                "then": [ { "run_eocs": "PF_SAY_home", "alpha_talker": "avatar", "variables": { "line": "horn_shield_3" } } ]
              }
            ]
          }
